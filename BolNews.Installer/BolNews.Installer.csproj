<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CmsInstaller</RootNamespace>
    <AssemblyName>cms-installer</AssemblyName>
    <!-- Lets the installer run on a bare server without ICU libraries. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BolNews.Persistence\BolNews.Persistence.csproj" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>
</Project>
