@using BolNews.Application.DTOs
@model BolNews.Web.Areas.Admin.ViewModels.VideoSectionVM

@{
    ViewData["Title"] = "Videos";
}

<div class="bn-container">

    <div class="container" style="padding-top:16px;">

        <div class="bn-category-navigation">

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bn-category-breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/">Home</a>
                    </li>

                    <li class="breadcrumb-item active"
                        aria-current="page">
                        <a href="/category/videos">Videos</a>
                    </li>
                </ol>
            </nav>

        </div>

    </div>


    <div class="container"
         style="padding-top:32px;padding-bottom:48px;">

        <div class="row g-4">

            <main class="col-lg-8">

                <h1 class="bn-video-page-title">
                    Videos
                </h1>


                @if (Model.Videos.Any())
                {
                    <div class="row g-3 mt-1">

                        @foreach (var item in Model.Videos)
                        {
                            <div class="col-6 col-md-4">

                                <div class="bn-video-card h-100">

                                    <button type="button"
                                            class="bn-video-thumbnail"
                                            data-bs-toggle="modal"
                                            data-bs-target="#publicVideoModal"
                                            data-video-url="@item.Url"
                                            data-video-title="@item.Caption">

                                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                                        {
                                            <img src="@item.ThumbnailUrl"
                                                 alt="@item.Caption"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="bn-video-placeholder">
                                                <i class="bi bi-camera-video"></i>
                                            </div>
                                        }

                                        <span class="bn-video-play">
                                            <i class="bi bi-play-fill"></i>
                                        </span>

                                    </button>


                                    <div class="bn-video-card-body">

                                        <h2>
                                            @item.Caption
                                        </h2>

                                        <span>
											@item.CreatedAt.AddHours(5).ToString("dd-MMM-yyyy hh:mm tt")
                                            
                                        </span>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <p class="bn-category-empty">
                        No videos are available yet.
                    </p>
                }


                <nav class="bn-category-pagination"
                     aria-label="Video pagination">

                    @if (Model.Page > 1)
                    {
                        <a href="/category/videos?page=@(Model.Page - 1)">
                            ← Previous
                        </a>
                    }
                    else
                    {
                        <span></span>
                    }

                    <span>
                        Page @Model.Page
                    </span>

                    @if (Model.HasNextPage)
                    {
                        <a href="/category/videos?page=@(Model.Page + 1)">
                            Next →
                        </a>
                    }
                    else
                    {
                        <span></span>
                    }

                </nav>

            </main>


            <aside class="col-lg-4">

                <div style="position:sticky;top:70px;">

                    <!-- Sidebar Ad — Top -->
                    <div class="bn-ad-slot mb-4">
                        <div id="Bolnews_Sidebar_Top_ATF"
                             data-ad-slot="sidebar-top-atf">
                        </div>
                    </div>


                    <div class="bn-story-rail">
                        <h2>Latest News</h2>
                    </div>

                    <div class="mb-4">
                        @await Component.InvokeAsync(
                        "LatestNews",
                                                new { count = 8 })
                    </div>


                    <div class="bn-story-rail">
                        <h2>Trending</h2>
                    </div>

                    @await Component.InvokeAsync(
                                        "TrendingNews",
                                        new
                                        {
                                            type = Context.Request.Query["type"].ToString()
                                        })

                </div>

            </aside>

        </div>

    </div>

</div>


<!-- Public Video Playback Modal -->

<div class="modal fade"
     id="publicVideoModal"
     tabindex="-1"
     aria-labelledby="publicVideoModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="publicVideoModalLabel">
                    Video
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body p-0">

                <video id="publicMediaVideo"
                       class="w-100"
                       controls
                       preload="metadata">
                </video>

            </div>

        </div>

    </div>

</div>


<style>

    .bn-video-page-title {
        color: #C4161C;
        font-family: var(--bn-font-body);
        font-size: 28px;
        font-weight: 600;
        margin: 0 0 18px;
    }

    .bn-video-card {
        color: inherit;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 3px;
        box-shadow: 0 0 5px rgba(0,0,0,.15);
        padding: 7px;
        transition: box-shadow .2s ease;
    }

        .bn-video-card:hover {
            box-shadow: 0 0 5px rgba(0,0,0,.35);
        }

    .bn-video-thumbnail {
        position: relative;
        display: block;
        width: 100%;
        aspect-ratio: 5 / 3;
        overflow: hidden;
        padding: 0;
        border: 0;
        background: #fff;
        cursor: pointer;
    }

        .bn-video-thumbnail img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .bn-video-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        background: #f8f9fa;
        color: #000;
        font-size: 42px;
    }

    .bn-video-play {
        position: absolute;
        top: 50%;
        left: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: rgba(0,0,0,.72);
        color: #fff;
        font-size: 32px;
        transition: transform .2s ease;
    }

    .bn-video-thumbnail:hover .bn-video-play {
        transform: translate(-50%, -50%) scale(1.08);
    }

    .bn-video-card-body {
        padding: 8px 5px 4px;
    }

        .bn-video-card-body h2 {
            color: #C4161C;
            font-family: var(--bn-font-ui);
            font-size: 13px;
            font-weight: 600;
            line-height: 20px;
            text-align: center;
            margin: 0 0 7px;
        }

    .bn-video-card:hover .bn-video-card-body h2 {
        color: #000;
    }

    .bn-video-card-body span {
        display: block;
        color: var(--bn-text-muted);
        font-family: var(--bn-font-ui);
        font-size: 11px;
        text-align: center;
    }

    .bn-category-breadcrumb {
        display: inline-flex;
        font-family: var(--bn-font-body);
        font-size: 12px;
        font-weight: 600;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        padding: 13px;
        margin: 0;
    }

        .bn-category-breadcrumb a {
            color: #000;
            text-decoration: none;
        }

        .bn-category-breadcrumb .active a {
            color: #C4161C;
        }

    .bn-category-navigation {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .bn-category-pagination {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid var(--bn-border);
        font-family: var(--bn-font-ui);
        font-size: 13px;
    }

        .bn-category-pagination > :first-child {
            justify-self: start;
        }

        .bn-category-pagination > :last-child {
            justify-self: end;
        }

        .bn-category-pagination a {
            border: 1px solid var(--bn-border);
            border-radius: var(--bn-radius-sm);
            color: var(--bn-text-primary);
            padding: 8px 16px;
            text-decoration: none;
        }

            .bn-category-pagination a:last-child {
                background: var(--bn-accent);
                border-color: var(--bn-accent);
                color: #fff;
            }

    .bn-category-empty {
        color: var(--bn-text-muted);
        font-family: var(--bn-font-ui);
        margin-top: 24px;
    }

</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const videoModal =
            document.getElementById("publicVideoModal");

        const mediaVideo =
            document.getElementById("publicMediaVideo");

        const videoModalLabel =
            document.getElementById("publicVideoModalLabel");


        videoModal.addEventListener(
            "show.bs.modal",
            function (event) {

                const button = event.relatedTarget;

                const videoUrl =
                    button.getAttribute("data-video-url");

                const videoTitle =
                    button.getAttribute("data-video-title");

                mediaVideo.src = videoUrl;

                videoModalLabel.textContent =
                    videoTitle || "Video";

                mediaVideo.load();

            });


        videoModal.addEventListener(
            "hidden.bs.modal",
            function () {

                mediaVideo.pause();

                mediaVideo.removeAttribute("src");

                mediaVideo.load();

            });

    });

</script>