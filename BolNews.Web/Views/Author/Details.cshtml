@using BolNews.Web.Areas.Admin.ViewModels
@model AuthorPageVM

@{
    ViewData["Title"] = Model.Name;
}

<!-- ── Author hero ────────────────────────────────────────── -->
<div style="background:var(--bn-nav-bg);padding:36px 0 32px;">
    <div class="container">
        <div style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;">
            <img src="@Model.ProfileImage"
                 alt="@Model.Name"
                 style="width:88px;height:88px;border-radius:50%;object-fit:cover;border:3px solid var(--bn-accent);flex-shrink:0;"
                 loading="eager" />
            <div>
                <div style="font-family:var(--bn-font-ui);font-size:10px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.5);margin-bottom:6px;">Journalist</div>
                <h1 style="font-family:var(--bn-font-display);font-size:clamp(22px,3.5vw,34px);font-weight:800;color:#fff;margin:0 0 8px;line-height:1.2;">
                    @Model.Name
                </h1>
                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p style="font-family:var(--bn-font-body);font-size:14px;color:rgba(255,255,255,0.65);margin:0;max-width:560px;line-height:1.6;">
                        @Model.Bio
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<!-- ── Articles ───────────────────────────────────────────── -->
<div class="container" style="padding-top:32px;padding-bottom:48px;">

    <div class="bn-section-header">
        <span class="bn-section-title">Articles by @Model.Name</span>
        <span style="font-family:var(--bn-font-ui);font-size:11px;color:var(--bn-text-muted);">
            @(Model.Articles?.Count ?? 0) articles
        </span>
    </div>

    @if (Model.Articles == null || !Model.Articles.Any())
    {
        <div style="
                padding:60px 24px;
                text-align:center;
                background:var(--bn-surface);
                border-radius:var(--bn-radius-md);
                border:1px solid var(--bn-border);">
            <div style="font-size:48px;margin-bottom:12px;">📝</div>
            <p style="font-family:var(--bn-font-ui);color:var(--bn-text-muted);">No articles published yet.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mt-1">
            @foreach (var article in Model.Articles)
            {
                <div class="col-sm-6 col-lg-4">
                    <a href="/@article.Category.Slug/@article.Slug"
                       class="bn-card d-flex flex-column h-100"
                       style="text-decoration:none;">
                        <div class="bn-card-img">
                            <img src="@article.FeaturedImageMedium"
                                 alt="@article.Title"
                                 loading="lazy"
                                 style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                        <div class="bn-card-body">
                            <div class="bn-card-tag">@article.Category.Name</div>
                            <h3 class="bn-card-title">@article.Title</h3>
                            @if (!string.IsNullOrEmpty(article.Summary))
                            {
                                <p style="font-family:var(--bn-font-body);font-size:13px;color:var(--bn-text-muted);line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                    @article.Summary
                                </p>
                            }
                            <div class="bn-card-meta">
                                <span>@article.PublishedAt?.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<!-- ── SEO Schema (preserved exactly) ────────────────────── -->
<script type="application/ld+json">@Html.Raw(Model.SchemaJson)</script>
