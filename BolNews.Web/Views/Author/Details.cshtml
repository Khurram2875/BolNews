@using BolNews.Web.Areas.Admin.ViewModels
@model AuthorPageVM

@{
    ViewData["Title"] = Model.Name;
}

<!-- 🔥 SEO Schema -->
<script type="application/ld+json">
    @Html.Raw(Model.SchemaJson)
</script>

<div class="container mt-4">

    <!-- 🔹 AUTHOR HEADER -->
    <div class="author-header d-flex align-items-center mb-4">

        <img src="@Model.ProfileImage"
             alt="@Model.Name"
             class="rounded-circle me-3"
             style="width:100px;height:100px;object-fit:cover;" />

        <div>
            <h1 class="mb-1">@Model.Name</h1>
            <p class="text-muted mb-0">@Model.Bio</p>
        </div>
    </div>

    <hr />

    <!-- 🔹 ARTICLES SECTION -->
    <h2 class="mb-3">Latest Articles by @Model.Name</h2>

    @if (Model.Articles != null && Model.Articles.Any())
    {
        <div class="row">

            @foreach (var article in Model.Articles)
            {
                <div class="col-md-6 mb-4">

                    <div class="card h-100 shadow-sm">

                        <a href="/news/@article.Category.Slug/@article.Slug">
                            <img src="@article.FeaturedImageMedium"
                                 class="card-img-top"
                                 alt="@article.Title"
                                 loading="lazy" />
                        </a>

                        <div class="card-body">

                            <h5 class="card-title">
                                <a href="/news/@article.Category.Slug/@article.Slug"
                                   class="text-dark text-decoration-none">
                                    @article.Title
                                </a>
                            </h5>

                            <p class="card-text text-muted">
                                @article.Summary
                            </p>

                            <small class="text-muted">
                                @article.PublishedAt?.ToString("MMM dd, yyyy")
                            </small>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <p>No articles found for this author.</p>
    }

</div>
<script type="application/ld+json">
    @Html.Raw(Model.SchemaJson)
</script>