@inject BolNews.Web.Services.SiteProfileService SiteProfileService
@{
    var profile = await SiteProfileService.GetAsync(Context.RequestAborted);
    var footerColumns = new[] { profile.FooterColumnOneLinks, profile.FooterColumnTwoLinks, profile.FooterColumnThreeLinks };
    List<(string Label, string Url)> ParseLinks(string? value) => (value ?? string.Empty)
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(line => line.Split('|', 2, StringSplitOptions.TrimEntries))
        .Where(parts => parts.Length == 2 && !string.IsNullOrWhiteSpace(parts[0]) && !string.IsNullOrWhiteSpace(parts[1]))
        .Select(parts => (parts[0], parts[1]))
        .ToList();
}
<footer class="bn-footer" aria-label="Footer">
    <div class="bn-footer__top">
        <a href="/" class="bn-footer__logo" aria-label="@profile.SiteName home">
            <img src="@Url.Content(profile.FooterLogoUrl)" alt="@profile.SiteName" />
        </a>

        <nav class="bn-footer__links" aria-label="Footer links">
            @foreach (var column in footerColumns)
            {
                <ul>
                    @foreach (var (label, url) in ParseLinks(column))
                    {
                        <li><a href="@url">@label</a></li>
                    }
                </ul>
            }
        </nav>
    </div>

    <div class="bn-footer__social" aria-label="Social links">
        @if (!string.IsNullOrWhiteSpace(profile.WhatsAppUrl)) { <a href="@profile.WhatsAppUrl" target="_blank" rel="noopener" aria-label="WhatsApp">
            <i class="fa-brands fa-whatsapp"></i>
        </a> }
        @if (!string.IsNullOrWhiteSpace(profile.FacebookUrl)) { <a href="@profile.FacebookUrl" target="_blank" rel="noopener" aria-label="Facebook">
            <i class="fa-brands fa-facebook-f"></i>
        </a> }
        @if (!string.IsNullOrWhiteSpace(profile.XUrl)) { <a href="@profile.XUrl" target="_blank" rel="noopener" aria-label="X">
            <i class="fa-brands fa-x-twitter"></i>
        </a> }
        @if (!string.IsNullOrWhiteSpace(profile.YouTubeUrl)) { <a href="@profile.YouTubeUrl" target="_blank" rel="noopener" aria-label="YouTube">
            <i class="fa-brands fa-youtube"></i>
        </a> }
        @if (!string.IsNullOrWhiteSpace(profile.InstagramUrl)) { <a href="@profile.InstagramUrl" target="_blank" rel="noopener" aria-label="Instagram">
            <i class="fa-brands fa-instagram"></i>
        </a> }
        @if (!string.IsNullOrWhiteSpace(profile.TikTokUrl)) { <a href="@profile.TikTokUrl" target="_blank" rel="noopener" aria-label="TikTok">
            <i class="fa-brands fa-tiktok"></i>
        </a> }
    </div>

    <div class="bn-footer__copyright">
        Copyright &copy; @DateTime.UtcNow.Year @profile.CopyrightText
    </div>
</footer>
