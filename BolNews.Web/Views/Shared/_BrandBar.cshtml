<div class="bn-brand">
    <div class="bn-container">

        <!-- Desktop / tablet layout -->
        <div class="row align-items-center d-none d-md-flex">

            <!-- Left -->
            <div class="col-lg-3 col-md-3">
                <div class="bn-brand-date">
                    @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                </div>
            </div>

            <!-- Center -->
            <div class="col-lg-6 col-md-6 text-center">
                <a asp-controller="Home" asp-action="Index" class="bn-brand-logo">
                    <img src="~/images/logo-black.png" alt="Bol News" />
                </a>
            </div>

            <!-- Right -->
            <div class="col-lg-3 col-md-3 text-end">
                <a href="/home/live" class="bn-watch-live">
                    Watch Live
                </a>
            </div>

        </div>

        <!-- Mobile layout: date on top, logo, then Watch Live — all centered -->
        <div class="d-flex d-md-none flex-column align-items-center text-center">
            <div class="bn-brand-date mb-2">
                @DateTime.Now.ToString("dddd, MMMM d, yyyy")
            </div>

            <a asp-controller="Home" asp-action="Index" class="bn-brand-logo mb-2">
                <img src="~/images/logo-black.png" alt="Bol News" />
            </a>

            <a href="/home/live" class="bn-watch-live">
                Watch Live
            </a>
        </div>

    </div>
</div>