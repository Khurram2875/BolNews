@using BolNews.Application.Interfaces
@using BolNews.Domain.Entities
@using BolNews.Web.Interfaces
@using BolNews.Web.SEO
@using BolNews.Web.Services

@inject ISeoService SeoService
@inject IUrlService UrlService
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    @{
        var defaultImage = $"{UrlService.GetBaseUrl()}/default-og.jpg";
        var ogImage = ViewBag.OgImage ?? defaultImage;
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="robots" content="max-image-preview:large">
    <!-- ✅ SEO -->
    <title>@(ViewBag.MetaTitle ?? "Bol News")</title>
    <meta name="description" content="@(ViewBag.MetaDescription ?? "Latest news from Bol News")" />
    @* <link rel="canonical" href="@(ViewBag.CanonicalUrl ?? "")" /> *@
    <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{ViewBag.CanonicalUrl}")" />

    <!-- ✅ Open Graph -->
    <meta property="og:title" content="@(ViewBag.MetaTitle ?? "")" />
    <meta property="og:description" content="@(ViewBag.MetaDescription ?? "")" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="@(ViewBag.CanonicalUrl ?? "")" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />

    <!-- ✅ Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewBag.MetaTitle ?? "")" />
    <meta name="twitter:description" content="@(ViewBag.MetaDescription ?? "")" />
    <meta name="twitter:image" content="@ogImage"/>

    <!-- Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BolNews.Web.styles.css" asp-append-version="true" />

    @{
        var baseUrl = UrlService.GetBaseUrl();
        var orgSchema = SeoService.BuildOrganizationSchema(baseUrl);
    }
    @if (ViewBag.Page is int page)
    {
        var basePath = Context.Request.Path;
        var query = Context.Request.Query;

        var queryString = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(query.ToString())
        .Where(q => q.Key.ToLower() != "page")
        .SelectMany(q => q.Value, (k, v) => $"{k.Key}={v}");

        var baseQuery = string.Join("&", queryString);

        string BuildUrl(int targetPage)
        {
            var pagePart = targetPage > 1 ? $"page={targetPage}" : "";
            var fullQuery = string.Join("&", new[] { baseQuery, pagePart }.Where(x => !string.IsNullOrEmpty(x)));

            return string.IsNullOrEmpty(fullQuery)
            ? basePath
            : $"{basePath}?{fullQuery}";
        }

        if (page > 1)
        {
            <link rel="prev" href="@BuildUrl(page - 1)" />
        }

        if (ViewBag.HasNextPage == true)
        {
            <link rel="next" href="@BuildUrl(page + 1)" />
        }
    }
    <script type="application/ld+json">
        @Html.Raw(orgSchema)
    </script>
</head>
<body>
    <header id="main-header">
        <div class="container py-3">
            <div class="row align-items-center">
                <div class="col-4 fw-bold">
                    @DateTime.UtcNow.Date.ToString("ddd, dd-MMMM-yyyy")
                </div>
                <div class="col-4 text-center">
                    <img src="/images/logo-black.png" style="height: 60px; width: auto;" alt="Logo" />
                </div>
                <div class="col-4 text-end">
                    <a href="#" class="text-danger fw-bold text-decoration-none">Watch Live</a>
                </div>
            </div>
        </div>

        <div class="container-md mb-2">
            @await Component.InvokeAsync("BreakingNews")
            @await Component.InvokeAsync("UtilityBar")
        </div>

        <nav id="sticky-navbar" class="navbar navbar-expand-lg navbar-light border-bottom border-top bg-white p-0" style="padding-left:20%">
            <div class="d-flex justify-content-between align-items-center container">
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <div class="navbar-collapse justify-content-center collapse" id="navbarNav">
                    @await Component.InvokeAsync("NavbarCategories")
                </div>

                <form method="get" action="/search" class="d-flex align-items-center ms-2">
                    <input type="text" name="q" class="form-control form-control-sm d-none d-lg-block me-1" placeholder="Search..." style="width: 150px;">
                    <button class="btn btn-link text-dark p-0" type="submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                        </svg>
                    </button>
                </form>
            </div>
            <div class="d-flex align-items-center ms-3">

                @if (User.Identity.IsAuthenticated)
                {
                    var user = await UserManager.GetUserAsync(User);

                    <span class="me-2">Hello, @user.FullName</span>

                    <a class="btn btn-sm btn-outline-danger"
                       asp-controller="Account"
                       asp-action="Logout">
                        Logout
                    </a>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-primary me-2"
                       asp-controller="Account"
                       asp-action="Login">
                        Login
                    </a>

                    <a class="btn btn-sm btn-primary"
                       asp-controller="Account"
                       asp-action="Register">
                        Register
                    </a>
                }

            </div>
        </nav>
    </header>
   
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
      
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BolNews.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/lazyload.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
