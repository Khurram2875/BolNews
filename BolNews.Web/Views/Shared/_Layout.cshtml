@using BolNews.Application.Interfaces
@using BolNews.Domain.Entities
@using BolNews.Web.Interfaces
@using BolNews.Web.SEO
@using BolNews.Web.Services

@inject ISeoService SeoService
@inject IUrlService UrlService
@inject SiteProfileService SiteProfileService

@{
    var siteProfile = await SiteProfileService.GetAsync(Context.RequestAborted);
    var siteName = string.IsNullOrWhiteSpace(siteProfile.SiteName) ? "Newsroom" : siteProfile.SiteName;
    var siteTagline = string.IsNullOrWhiteSpace(siteProfile.Tagline) ? "Latest News" : siteProfile.Tagline;
    var adOrigin = Uri.TryCreate(siteProfile.AdScriptUrl, UriKind.Absolute, out var adScriptUri)
        ? adScriptUri.GetLeftPart(UriPartial.Authority)
        : null;
}

<!DOCTYPE html>
<html lang="en" data-theme="@siteProfile.ThemeName">
<head>
    @{
        var defaultImage = $"{UrlService.GetBaseUrl()}/default-og.jpg";
        var ogImage = ViewBag.OgImage ?? defaultImage;
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="@(ViewBag.Robots ?? "index,follow,max-image-preview:large")" />

    @{
        var canonicalRaw = ViewBag.CanonicalUrl as string;
        string canonicalUrl;

        if (string.IsNullOrWhiteSpace(canonicalRaw))
        {
            canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        }
        else if (Uri.TryCreate(canonicalRaw, UriKind.Absolute, out var absoluteCanonical)
        && (absoluteCanonical.Scheme == Uri.UriSchemeHttp || absoluteCanonical.Scheme == Uri.UriSchemeHttps))
        {
            canonicalUrl = absoluteCanonical.ToString();
        }
        else
        {
            var path = canonicalRaw.StartsWith("/") ? canonicalRaw : $"/{canonicalRaw}";
            canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{path}";
        }

        var ogType = ViewBag.OgType as string ?? "website";
        var metaTitle = ViewBag.MetaTitle as string;
        var viewTitle = ViewData["Title"] as string;
        var pageTitle = !string.IsNullOrWhiteSpace(viewTitle)
            ? viewTitle
            : !string.IsNullOrWhiteSpace(metaTitle)
                ? metaTitle
                : $"{siteName} - {siteTagline}";
        var metaDescription = ViewBag.MetaDescription as string;
        var pageDescription = !string.IsNullOrWhiteSpace(metaDescription)
            ? metaDescription
            : $"Latest news from {siteName}";
    }

    <!-- SEO -->
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />

    @if (!string.IsNullOrWhiteSpace(ViewBag.MetaKeywords as string))
    {
        <meta name="keywords" content="@ViewBag.MetaKeywords" />
    }

    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="en" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:author" content="@(ViewBag.Author ?? "")" />
    <meta property="og:source" content="@(ViewBag.Source ?? "")" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />

    @if (ViewBag.ArticleTags is IEnumerable<BolNews.Application.DTOs.TagDto> articleTags)
    {
        foreach (var tag in articleTags)
        {
            <meta property="article:tag" content="@tag.Name" />
        }
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@ogImage" />

    @if (!string.IsNullOrWhiteSpace(ViewBag.MetaKeywords as string))
    {
        <meta name="twitter:label1" content="Tags" />
        <meta name="twitter:data1" content="@ViewBag.MetaKeywords" />
    }

    <!-- Styles -->
    <link rel="icon" type="image/x-icon" href="@Url.Content(siteProfile.FaviconUrl)" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/site-theme.css" />
    <link rel="stylesheet" href="~/BolNews.Web.styles.css" asp-append-version="true" />
    <style>
        :root { --bn-brand-primary: @siteProfile.PrimaryColor; --bn-brand-accent: @siteProfile.AccentColor; }
        [data-theme] {
            --bn-accent: var(--bn-brand-primary);
            --bn-accent-hover: color-mix(in srgb, var(--bn-brand-primary) 86%, black);
            --bn-nav-active: var(--bn-brand-primary);
            --bn-ticker-bg: var(--bn-brand-accent);
        }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @if (!string.IsNullOrWhiteSpace(adOrigin)) { <link rel="dns-prefetch" href="@adOrigin"> }
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preload"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          as="style"
          onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    </noscript>
    <link href="https://fonts.googleapis.com/css2?family=Belleza&family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600&display=swap"
          rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)

    @{
        var baseUrl = UrlService.GetBaseUrl();
        var orgSchema = SeoService.BuildOrganizationSchema(baseUrl, siteProfile.SiteName, siteProfile.HeaderLogoUrl);
        var webSiteSchema = SeoService.BuildWebSiteSchema(baseUrl, siteProfile.SiteName);
    }

    @if (ViewBag.Page is int page)
    {
        var basePath = Context.Request.Path;
        var query = Context.Request.Query;

        var queryString = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(query.ToString())
            .Where(q => q.Key.ToLower() != "page")
            .SelectMany(q => q.Value, (k, v) => $"{k.Key}={v}");

        var baseQuery = string.Join("&", queryString);

        string BuildUrl(int targetPage)
        {
            var pagePart = targetPage > 1 ? $"page={targetPage}" : "";
            var fullQuery = string.Join("&", new[] { baseQuery, pagePart }
                .Where(x => !string.IsNullOrEmpty(x)));
            return string.IsNullOrEmpty(fullQuery)
                ? basePath
                : $"{basePath}?{fullQuery}";
        }

        if (page > 1)
        {
            <link rel="prev" href="@BuildUrl(page - 1)" />
        }

        if (ViewBag.HasNextPage == true)
        {
            <link rel="next" href="@BuildUrl(page + 1)" />
        }
    }

    <script type="application/ld+json">@Html.Raw(orgSchema)</script>
    <script type="application/ld+json">@Html.Raw(webSiteSchema)</script>

    <!-- Theme init: apply saved theme before paint to avoid flash -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem('bolnews-theme');
                if (t && ['default','dark','editorial','bold'].includes(t)) {
                    document.documentElement.setAttribute('data-theme', t);
                }
            } catch (e) {}
        })();
    </script>
</head>
<body data-auto-refresh="@(ViewData["EnableTimedRefresh"] is true ? "true" : "false")">

    <partial name="_Header" />

    @* Sample ad placement: top leaderboard immediately after header, before homepage/content. *@
    @await Component.InvokeAsync("AdZone", new { zone = "site.top" })

    <main class="bn-main">
        @RenderBody()
    </main>

    @* Sample ad placement: bottom BTF immediately before footer. *@
    @await Component.InvokeAsync("AdZone", new { zone = "site.bottom" })

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/lazyload.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/bookmarks.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @if (ViewData["EnableTimedRefresh"] is true)
    {
        <script src="~/js/public-page-refresh.js" asp-append-version="true"></script>
    }
    @if (!string.IsNullOrWhiteSpace(siteProfile.AdScriptUrl))
    {
    <script>
        (function () {
            var adScriptLoaded = false;
            var adScriptUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(siteProfile.AdScriptUrl));

            function loadAdScript() {
                if (adScriptLoaded) return;
                adScriptLoaded = true;

                var script = document.createElement('script');
                script.src = adScriptUrl;
                script.async = true;
                document.head.appendChild(script);
            }

            function scheduleAdScript() {
                if ('requestIdleCallback' in window) {
                    window.requestIdleCallback(loadAdScript, { timeout: 2500 });
                    return;
                }

                window.setTimeout(loadAdScript, 1200);
            }

            if (document.readyState === 'complete') {
                scheduleAdScript();
            } else {
                window.addEventListener('load', scheduleAdScript, { once: true });
            }
        })();
    </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
