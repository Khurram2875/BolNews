@using BolNews.Web.SEO

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <!-- ✅ SEO -->
    <title>@(ViewBag.MetaTitle ?? "Bol News")</title>
    <meta name="description" content="@(ViewBag.MetaDescription ?? "Latest news from Bol News")" />
    <link rel="canonical" href="@(ViewBag.CanonicalUrl ?? "")" />

    <!-- ✅ Open Graph -->
    <meta property="og:title" content="@(ViewBag.MetaTitle ?? "")" />
    <meta property="og:description" content="@(ViewBag.MetaDescription ?? "")" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="@(ViewBag.CanonicalUrl ?? "")" />
    <meta property="og:image" content="@(ViewBag.OgImage ?? "")" />

    <!-- ✅ Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewBag.MetaTitle ?? "")" />
    <meta name="twitter:description" content="@(ViewBag.MetaDescription ?? "")" />
    <meta name="twitter:image" content="@(ViewBag.OgImage ?? "")" />

    <!-- Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BolNews.Web.styles.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous"> *@
    @if (ViewBag.CategorySlug != null)
    {
        if (ViewBag.Page > 1)
        {
            <link rel="prev" href="/news/@ViewBag.CategorySlug?page=@(ViewBag.Page - 1)" />
        }

        if (ViewBag.HasNextPage == true)
        {
            <link rel="next" href="/news/@ViewBag.CategorySlug?page=@(ViewBag.Page + 1)" />
        }
    }
</head>

<body>
    <header id="main-header">
        <div class="container py-3">
            <div class="row align-items-center">
                <div class="col-4 fw-bold">
                    @DateTime.UtcNow.Date.ToString("ddd, dd-MMMM-yyyy")
                </div>
                <div class="col-4 text-center">
                    <img src="/images/logo-black.png" style="height: 60px; width: auto;" alt="Logo" />
                </div>
                <div class="col-4 text-end">
                    <a href="#" class="text-danger fw-bold text-decoration-none">Watch Live</a>
                </div>
            </div>
        </div>

        <div class="container-md mb-2">
            @await Component.InvokeAsync("BreakingNews")
        </div>

        <nav id="sticky-navbar" class="navbar navbar-expand-lg navbar-light border-bottom border-top bg-white p-0" style="padding-left:20%">
            <div class="d-flex justify-content-between align-items-center container">
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <div class="navbar-collapse justify-content-center collapse" id="navbarNav">
                    @await Component.InvokeAsync("NavbarCategories")
                </div>

                <form method="get" action="/search" class="d-flex align-items-center ms-2">
                    <input type="text" name="q" class="form-control form-control-sm d-none d-lg-block me-1" placeholder="Search..." style="width: 150px;">
                    <button class="btn btn-link text-dark p-0" type="submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                        </svg>
                    </button>
                </form>
            </div>
        </nav>
    </header>
   @*  <header>
        <div class="container mb-4">
            <div class="row">
                <div class="col-md-4">@DateTime.UtcNow.Date.ToString("ddd, dd-MMMM-yyyy")</div>
				<div class="col-md-4"><img src="~/images/logo-black.png" sizes="80%" /></div>
                <div class="col-md-4">Place holder for a link</div>
            </div>
            
