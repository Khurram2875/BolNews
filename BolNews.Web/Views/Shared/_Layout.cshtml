@using BolNews.Application.Interfaces
@using BolNews.Domain.Entities
@using BolNews.Web.Interfaces
@using BolNews.Web.SEO
@using BolNews.Web.Services

@inject ISeoService SeoService
@inject IUrlService UrlService
@inject IAdService AdService

<!DOCTYPE html>
<html lang="en" data-theme="default">
<head>
    @{
        var defaultImage = $"{UrlService.GetBaseUrl()}/default-og.jpg";
        var ogImage = ViewBag.OgImage ?? defaultImage;
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    @{
        var canonicalRaw = ViewBag.CanonicalUrl as string;
        var canonicalUrl = string.IsNullOrWhiteSpace(canonicalRaw)
            ? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}"
            : (Uri.TryCreate(canonicalRaw, UriKind.Absolute, out var absoluteCanonical)
                ? absoluteCanonical.ToString()
                : $"{Context.Request.Scheme}://{Context.Request.Host}{canonicalRaw}");

        var ogType = ViewBag.OgType as string ?? "website";
    }
    <!-- SEO -->
    
    <title>@(ViewData["Title"] ?? "Bol News - Latest News, Politics, Sports and Entertainment")</title>
    <meta name="description" content="@(ViewBag.MetaDescription ?? "Latest news from Bol News")" />
    @if (!string.IsNullOrWhiteSpace(ViewBag.MetaKeywords as string))
    {
        <meta name="keywords" content="@ViewBag.MetaKeywords" />
    }
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:title" content="@(ViewBag.MetaTitle ?? "")" />
    <meta property="og:description" content="@(ViewBag.MetaDescription ?? "")" />
    <meta property="og:author" content="@(ViewBag.Author ??"")"/>
    <meta property="og:source" content="@(ViewBag.Source ?? "")" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    @if (ViewBag.ArticleTags is IEnumerable<BolNews.Application.DTOs.TagDto> articleTags)
    {
        foreach (var tag in articleTags)
        {
            <meta property="article:tag" content="@tag.Name" />
        }
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewBag.MetaTitle ?? "")" />
    <meta name="twitter:description" content="@(ViewBag.MetaDescription ?? "")" />
    <meta name="twitter:image" content="@ogImage" />
    @if (!string.IsNullOrWhiteSpace(ViewBag.MetaKeywords as string))
    {
        <meta name="twitter:label1" content="Tags" />
        <meta name="twitter:data1" content="@ViewBag.MetaKeywords" />
    }

    <!-- Styles -->
    <link rel="icon" type="image/x-icon" href="~/bol_network.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BolNews.Web.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Include Font Awesome 6 in your <head> section -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Belleza&family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600&display=swap"
          rel="stylesheet">

    @{
        var baseUrl = UrlService.GetBaseUrl();
        var orgSchema = SeoService.BuildOrganizationSchema(baseUrl);
        var webSiteSchema = SeoService.BuildWebSiteSchema(baseUrl);
    }

    @if (ViewBag.Page is int page)
    {
        var basePath = Context.Request.Path;
        var query = Context.Request.Query;

        var queryString = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(query.ToString())
        .Where(q => q.Key.ToLower() != "page")
        .SelectMany(q => q.Value, (k, v) => $"{k.Key}={v}");

        var baseQuery = string.Join("&", queryString);

        string BuildUrl(int targetPage)
        {
            var pagePart = targetPage > 1 ? $"page={targetPage}" : "";
            var fullQuery = string.Join("&", new[] { baseQuery, pagePart }.Where(x => !string.IsNullOrEmpty(x)));
            return string.IsNullOrEmpty(fullQuery) ? basePath : $"{basePath}?{fullQuery}";
        }

        if (page > 1)
        {
            <link rel="prev" href="@BuildUrl(page - 1)" />
        }
        if (ViewBag.HasNextPage == true)
        {
            <link rel="next" href="@BuildUrl(page + 1)" />
        }
    }
    <!-- Ads 
    <script src="https://avads.live/s/av-bolnews.js"></script>  -->
    <!-- Ads -->
    <script type="application/ld+json">@Html.Raw(orgSchema)</script>
    <script type="application/ld+json">@Html.Raw(webSiteSchema)</script>
     

    <!-- Theme init: apply saved theme before paint to avoid flash -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem('bolnews-theme');
                if (t && ['default','dark','editorial','bold'].includes(t)) {
                    document.documentElement.setAttribute('data-theme', t);
                }
            } catch (e) {}
        })();
    </script>
</head>
<body>

    <partial name="_Header" />

    @* Sample ad placement: top leaderboard immediately after header, before homepage/content. *@
    <div class="bn-ad-code-block bn-ad-code-block--top" aria-label="Advertisement">
        <div id="Bolnews_Top_Leaderboard_ATF" data-ad-slot="top-leaderboard-atf"></div>
    </div>

    <main class="bn-main">
        @RenderBody()
    </main>

    @* Sample ad placement: bottom BTF immediately before footer. *@
    <div class="bn-ad-code-block bn-ad-code-block--bottom" aria-label="Advertisement">
        <div id="Bolnews_Bottom_BTF" data-ad-slot="bottom-btf"></div>
    </div>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/lazyload.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ── Theme switcher ──────────────────────────────────────
        function bnSetTheme(name, btn) {
            document.documentElement.setAttribute('data-theme', name);
            document.querySelectorAll('.bn-theme-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            try { localStorage.setItem('bolnews-theme', name); } catch (e) {}
        }

        // Mark correct button active on load
        (function () {
            try {
                var saved = localStorage.getItem('bolnews-theme') || 'default';
                var btn = document.querySelector('.bn-theme-btn[data-t="' + saved + '"]');
                if (btn) {
                    document.querySelectorAll('.bn-theme-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                }
            } catch (e) {}
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
