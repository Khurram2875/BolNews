@model IReadOnlyList<BolNews.Web.ViewModels.LiveEventCarouselItemVM>
@if (Model.Count > 0)
{
    var items = Model.ToList();

    <section class="bn-live-events mb-4" aria-label="Live events">
        @* <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="mb-0">Live Updates</h2>
            <button class="btn btn-sm btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#liveEventsCarouselWrap"
                    aria-expanded="true" aria-controls="liveEventsCarouselWrap">
                Hide
            </button>
        </div> *@

        <div class="show collapse" id="liveEventsCarouselWrap">
            <div id="liveEventsCarousel" class="carousel slide" data-bs-ride="carousel">

                @if (items.Count > 1)
                {
                    <div class="carousel-indicators">
                        @for (int i = 0; i < items.Count; i++)
                        {
                            <button type="button"
                                    data-bs-target="#liveEventsCarousel"
                                    data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")"
                                    aria-current="@(i == 0 ? "true" : "false")"
                                    aria-label="Live event @(i + 1)">
                            </button>
                        }
                    </div>
                }

                <div class="carousel-inner rounded">
                    @for (int i = 0; i < items.Count; i++)
                    {
                        var item = items[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <a class="bn-live-event-card d-block" href="/live/@item.Slug">
                                <div class="bn-live-event-card__image">
                                    <img loading="lazy"
                                         decoding="async"
                                         src="@item.ImageUrl"
                                         width="280"
                                         height="280"
                                         class="bn-live-img"
                                         alt="@item.Title" />

                                    <h3 class="bn-live-event-card__title">@item.Title</h3>

                                    @if (item.ShowLiveBadge)
                                    {
                                        <span class="bn-live-badge">LIVE</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.LatestUpdate))
                                {
                                    <div class="bn-live-event-card__text">@item.LatestUpdate</div>
                                }
                            </a>
                        </div>
                    }
                </div>

                @if (items.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#liveEventsCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#liveEventsCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                }
            </div>
        </div>
    </section>
}
