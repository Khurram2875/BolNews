<div class="bn-section-header"><span class="bn-section-title">Popular Right Now</span></div>
<div class="bn-secondary-grid" style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem;">
    @foreach (var item in Model)
    {
        <a href="/news/@item.CategorySlug/@item.Slug"
           class="bn-card track-click d-flex flex-column h-100 text-decoration-none"
           data-article-id="@item.Id">
            
            <div class="bn-card-img">
                <img class="lazy-image d-block w-100"
                     src="/images/placeholder.png"
                     data-src="@item.FeaturedImageThumb"
                     alt="@item.Title"
                     loading="lazy" />
            </div>
            
            <div class="bn-card-body d-flex flex-column flex-grow-1">
                <div class="bn-card-tag">@item.CategoryName</div>
                <h3 class="bn-card-title fs-6 fw-bold mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    @item.Title
                </h3>
                <div class="bn-card-meta text-muted small mt-auto">
                    <span>@item.AuthorName</span>
                    <span class="bn-card-meta-dot"></span>
                    <span>@item.TimeAgo</span>
                </div>
            </div>
            
        </a>
    }
</div>