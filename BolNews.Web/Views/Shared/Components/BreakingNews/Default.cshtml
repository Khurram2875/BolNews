@model List<BolNews.Domain.Entities.BreakingNews>

<div class="breaking-news-bar">

    <span class="badge bg-danger me-2">HEADLINES</span>

    <div class="ticker-wrapper">
        <div class="ticker">

            @foreach (var item in Model)
            {
                <span class="d-inline-flex align-items-center me-4">

                    <span class="badge rounded-circle bg-danger ms-1 p-1"
                          style="width:8px;height:8px;">
                    </span>

                    @if (item.Article != null)
                    {
                        <a href="/news/@item.Article.Category.Slug/@item.Article.Slug"
                           class="track-click"
                           data-article-id="@item.ArticleId">

                            @item.Text

                        </a>
                    }
                    else
                    {
                        <span>

                            @item.Text

                        </span>
                    }

                </span>
            }

        </div>
    </div>

</div>