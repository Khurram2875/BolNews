@model List<BolNews.Domain.Entities.BreakingNews>

<div class="breaking-news-bar">

    <span class="badge bg-danger me-2">HEADLINES</span>

    <div class="ticker-wrapper">
        <div class="ticker">

            @for (int i = 0; i < 2; i++)
            {
                foreach (var item in Model)
                {
                    <span class="ticker-item">

                        <span class="ticker-dot"></span>

                        @if (item.Article != null)
                        {
                            <a href="/@item.Article.Category.Slug/@item.Article.Slug"
                               class="track-click"
                               data-article-id="@item.ArticleId">
                                @item.Text
                            </a>
                        }
                        else
                        {
                            <span>@item.Text</span>
                        }

                    </span>
                }
            }

        </div>
    </div>

</div>