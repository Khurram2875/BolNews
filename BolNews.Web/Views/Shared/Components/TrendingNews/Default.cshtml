@* TrendingNews/Default.cshtml — updated with bn- classes *@

<div class="bn-widget-title">Trending</div>

<div class="trending-tabs">
    <a href="?type=today" class="@(ViewBag.Type == "today" ? "active" : "")">Today</a>
    <a href="?type=week" class="@(ViewBag.Type == "week" ? "active" : "")">This Week</a>
    <a href="?type=month" class="@(ViewBag.Type == "month" ? "active" : "")">This Month</a>
</div>

@{
    int rank = 1;
}
@foreach (var item in Model)
{
    <a href="/news/@item.CategorySlug/@item.Slug"
       class="bn-trending-item track-click"
       data-article-id="@item.Id">
        <div class="bn-trending-num">@(rank.ToString("D2"))</div>
        <div>
            <div class="bn-trending-title">@item.Title</div>
            <div class="bn-trending-meta">@item.CategoryName · @item.TimeAgo</div>
        </div>
    </a>
    rank++;
}
