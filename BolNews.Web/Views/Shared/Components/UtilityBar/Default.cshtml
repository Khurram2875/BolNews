        GBP: <strong>@Model.Forex.GBP</strong> |
        AED: <strong>@Model.Forex.AED</strong> |
        SAR: <strong>@Model.Forex.SAR</strong> |
        KWD: <strong>@Model.Forex.KWD</strong> 
    </div>

@*     <div>
        🟡 Gold (24K):
        <strong>Rs. @Model.Gold.Price24K</strong>
    </div> *@
   

</div>
