<div class="utility-bar d-flex justify-content-between bg-light px-3 py-2">

    <!-- Weather -->
    <div>
       @*  <img src="@Model.Weather.Icon" style="width:24px;" /> *@
         @Model.Weather.City:<strong>@Model.Weather.Temperature°C</strong>
        (@Model.Weather.Condition) | Feels Like: <strong>@Model.Weather.FeelsLike°C</strong>| 
        Humidity: <strong>@Model.Weather.Humidity%</strong> |
        Wind: <strong>@Model.Weather.WindMph mph</strong>

    </div>

    
    <div>
        💱 USD: <strong>@Model.Forex.USD</strong> |
