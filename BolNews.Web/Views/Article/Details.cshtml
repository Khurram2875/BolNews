@using BolNews.Web.Areas.Admin.ViewModels
@using System.Text.Json
@using BolNews.Web.SEO

@model ArticleDetailsPageVM

@{
    ViewData["Title"] = Model.Article.MetaTitle ?? Model.Article.Title;
}

<!-- ── Breadcrumb ──────────────────────────────────────────── -->
<div style="background:var(--bn-surface-alt);border-bottom:1px solid var(--bn-border);">
    <div class="container py-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-family:var(--bn-font-ui);font-size:12px;">
                <li class="breadcrumb-item"><a href="/" style="color:var(--bn-text-muted);text-decoration:none;">Home</a></li>
                <li class="breadcrumb-item"><a href="/news" style="color:var(--bn-text-muted);text-decoration:none;">News</a></li>
                <li class="breadcrumb-item">
                    <a href="/news/@Model.Article.CategorySlug" style="color:var(--bn-accent);text-decoration:none;">@Model.Article.CategoryName</a>
                </li>
                <li class="breadcrumb-item active" style="color:var(--bn-text-muted);" aria-current="page">
                    @(Model.Article.Title.Length > 50 ? Model.Article.Title.Substring(0, 50) + "…" : Model.Article.Title)
                </li>
            </ol>
        </nav>
    </div>
</div>

<!-- ── Main layout ────────────────────────────────────────── -->
<div class="container" style="padding-top:32px;padding-bottom:48px;">
    <div class="row g-4">

        <!-- ── Article column ──────────────────────────────── -->
        <div class="col-lg-8">
            <article itemscope itemtype="https://schema.org/NewsArticle">

                <!-- Category tag + title -->
                <div class="mb-3">
                    <a href="/news/@Model.Article.CategorySlug" class="bn-tag d-inline-block mb-3">@Model.Article.CategoryName</a>
                    <h1 itemprop="headline" style="
                        font-family:var(--bn-font-display);
                        font-size:clamp(22px,3.5vw,34px);
                        font-weight:800;
                        line-height:1.2;
                        color:var(--bn-text-primary);
                        margin-top:10px;">
                        @Model.Article.Title
                    </h1>
                </div>

                <!-- Summary / deck -->
                @if (!string.IsNullOrEmpty(Model.Article.Summary))
                {
                    <p style="
                            font-family:var(--bn-font-body);
                            font-size:18px;
                            font-weight:600;
                            color:var(--bn-text-body);
                            line-height:1.55;
                            border-left:3px solid var(--bn-accent);
                            padding-left:14px;
                            margin-bottom:20px;">
                        @Model.Article.Summary
                    </p>
                }

                <!-- Author bar -->
                <div style="
                    display:flex;
                    align-items:center;
                    justify-content:space-between;
                    flex-wrap:wrap;
                    gap:12px;
                    padding:14px 16px;
                    background:var(--bn-surface-alt);
                    border-radius:var(--bn-radius-md);
                    margin-bottom:22px;
                    border:1px solid var(--bn-border);">
                    <a href="/author/@Model.Article.AuthorSlug"
                       style="display:flex;align-items:center;gap:11px;text-decoration:none;color:inherit;">
                        <img src="@Model.Article.AuthorImage"
                             alt="@Model.Article.AuthorName"
                             itemprop="image"
                             style="width:42px;height:42px;border-radius:50%;object-fit:cover;flex-shrink:0;"
                             loading="lazy" />
                        <div>
                            <div style="font-family:var(--bn-font-ui);font-size:13px;font-weight:700;color:var(--bn-text-primary);">
                                @Model.Article.AuthorName
                            </div>
                            <div style="font-family:var(--bn-font-ui);font-size:11px;color:var(--bn-text-muted);">
                                Journalist at Bol News
                            </div>
                        </div>
                    </a>
                    <div style="font-family:var(--bn-font-ui);font-size:11px;color:var(--bn-text-muted);display:flex;gap:14px;flex-wrap:wrap;">
                        @if (Model.Article.PublishedAt.HasValue)
                        {
                            <span itemprop="datePublished" content="@Model.Article.PublishedAt.Value.ToString("yyyy-MM-dd")">
                                📅 @Model.Article.PublishedAt.Value.ToString("dd MMM yyyy")
                            </span>
                        }
                        else
                        {
                            <span  content="Not published">
                                Not published
                            </span>
                        }
                        @if (Model.Article.UpdatedAt.HasValue)
                        {
                            <span itemprop="dateModified" content="@Model.Article.UpdatedAt.Value.ToString("yyyy-MM-dd")">
                                🔄 Updated @Model.Article.UpdatedAt.Value.ToString("dd MMM yyyy")
                            </span>
                        }
                        @if (Model.Article.ReadingTimeMinutes > 0)
                        {
                            <span>⏱ @Model.Article.ReadingTimeMinutes min read</span>
                        }
                    </div>
                </div>

                <!-- Featured image -->
                @if (!string.IsNullOrEmpty(Model.Article.FeaturedImageLarge))
                {
                    <figure style="margin:0 0 24px;" itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
                        <img src="@Model.Article.FeaturedImageLarge"
                             alt="@Model.Article.Title"
                             itemprop="url"
                             style="width:100%;border-radius:var(--bn-radius-md);display:block;max-height:500px;object-fit:cover;"
                             loading="eager" />
                        <meta itemprop="width" content="1200" />
                        <meta itemprop="height" content="675" />
                    </figure>
                }

                <!-- Article body -->
                <div class="bn-article-body" itemprop="articleBody">
                    @Html.Raw(Model.Article.Content)
                </div>

                <!-- Share bar -->
                <div style="
                    display:flex;
                    align-items:center;
                    gap:10px;
                    flex-wrap:wrap;
                    padding:18px 0;
                    margin-top:28px;
                    border-top:1px solid var(--bn-border);
                    border-bottom:1px solid var(--bn-border);">
                    <span style="font-family:var(--bn-font-ui);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--bn-text-muted);">Share</span>
                    <a href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString($"{Model.BaseUrl}/news/{Model.Article.CategorySlug}/{Model.Article.Slug}")&text=@Uri.EscapeDataString(Model.Article.Title)"
                       target="_blank" rel="noopener"
                       style="display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:20px;font-family:var(--bn-font-ui);font-size:12px;font-weight:600;background:#000;color:#fff;text-decoration:none;">
                        𝕏 Twitter
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString($"{Model.BaseUrl}/news/{Model.Article.CategorySlug}/{Model.Article.Slug}")"
                       target="_blank" rel="noopener"
                       style="display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:20px;font-family:var(--bn-font-ui);font-size:12px;font-weight:600;background:#1877f2;color:#fff;text-decoration:none;">
                        Facebook
                    </a>
                    <a href="https://wa.me/?text=@Uri.EscapeDataString($"{Model.Article.Title} - {Model.BaseUrl}/news/{Model.Article.CategorySlug}/{Model.Article.Slug}")"
                       target="_blank" rel="noopener"
                       style="display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:20px;font-family:var(--bn-font-ui);font-size:12px;font-weight:600;background:#25d366;color:#fff;text-decoration:none;">
                        WhatsApp
                    </a>
                    <button onclick="navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='Copied!')"
                            style="display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:20px;font-family:var(--bn-font-ui);font-size:12px;font-weight:600;background:var(--bn-surface-alt);color:var(--bn-text-body);border:1px solid var(--bn-border);cursor:pointer;">
                        Copy Link
                    </button>
                </div>

                <!-- Author bio card -->
                <div style="
                    display:flex;
                    gap:18px;
                    padding:22px;
                    background:var(--bn-surface);
                    border:1px solid var(--bn-border);
                    border-radius:var(--bn-radius-md);
                    margin-top:28px;
                    box-shadow:var(--bn-shadow);">
                    <img src="@Model.Article.AuthorImage"
                         alt="@Model.Article.AuthorName"
                         style="width:64px;height:64px;border-radius:50%;object-fit:cover;flex-shrink:0;"
                         loading="lazy" />
                    <div>
                        <div style="font-family:var(--bn-font-ui);font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--bn-text-muted);margin-bottom:4px;">About the author</div>
                        <a href="/author/@Model.Article.AuthorSlug"
                           style="font-family:var(--bn-font-display);font-size:17px;font-weight:700;color:var(--bn-text-primary);text-decoration:none;">
                            @Model.Article.AuthorName
                        </a>
                        <p style="font-family:var(--bn-font-body);font-size:13px;color:var(--bn-text-muted);margin-top:5px;margin-bottom:0;line-height:1.6;">
                            Journalist at Bol News
                        </p>
                    </div>
                </div>

            </article>

            <!-- ── Related Articles ──────────────────────────── -->
            @if (Model.RelatedArticles != null && Model.RelatedArticles.Any())
            {
                <div style="margin-top:40px;">
                    <div class="bn-section-header">
                        <span class="bn-section-title">Related Articles</span>
                        <a href="/news/@Model.Article.CategorySlug" class="bn-section-link">More in @Model.Article.CategoryName →</a>
                    </div>
                    <div class="row g-3 mt-1">
                        @foreach (var item in Model.RelatedArticles)
                        {
                            <div class="col-sm-6">
                                <a href="/news/@item.CategorySlug/@item.Slug"
                                   class="bn-card track-click d-flex flex-column h-100"
                                   data-article-id="@item.Id"
                                   style="text-decoration:none;">
                                    <div class="bn-card-img">
                                        <img src="@item.FeaturedImageThumb"
                                             alt="@item.Title"
                                             loading="lazy"
                                             style="width:100%;height:100%;object-fit:cover;" />
                                    </div>
                                    <div class="bn-card-body">
                                        <div class="bn-card-tag">@item.CategoryName</div>
                                        <h3 class="bn-card-title">@item.Title</h3>
                                        <div class="bn-card-meta">
                                            <span>@item.TimeAgo</span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- ── Sidebar ──────────────────────────────────────── -->
        <aside class="col-lg-4">
            <div style="position:sticky;top:70px;">

                <!-- Trending widget -->
                <div class="bn-widget">
                    @await Component.InvokeAsync("TrendingNews",
                    new { type = Context.Request.Query["type"].ToString() })
                </div>

                <!-- Latest news widget -->
                <div class="bn-widget mb-4">
                    <div class="bn-widget-title">Latest News</div>
                    <div class="bn-scroll-container">
                        @await Component.InvokeAsync("LatestNews", new { count = 6 })
                    </div>
                </div>

               
            </div>
        </aside>

    </div>
</div>

<!-- ── Article body typography ───────────────────────────── -->
<style>
    .bn-article-body {
        font-family: var(--bn-font-body);
        font-size: 17px;
        line-height: 1.8;
        color: var(--bn-text-body);
    }

        .bn-article-body p {
            margin-bottom: 1.4em;
        }

        .bn-article-body h2 {
            font-family: var(--bn-font-display);
            font-size: 22px;
            font-weight: 700;
            color: var(--bn-text-primary);
            margin: 1.8em 0 0.6em;
        }

        .bn-article-body h3 {
            font-family: var(--bn-font-display);
            font-size: 18px;
            font-weight: 700;
            color: var(--bn-text-primary);
            margin: 1.5em 0 0.5em;
        }

        .bn-article-body img {
            max-width: 100%;
            border-radius: var(--bn-radius-md);
            margin: 1em 0;
        }

        .bn-article-body blockquote {
            border-left: 3px solid var(--bn-accent);
            padding: 10px 18px;
            margin: 1.5em 0;
            background: var(--bn-surface-alt);
            border-radius: 0 var(--bn-radius-sm) var(--bn-radius-sm) 0;
            font-style: italic;
            color: var(--bn-text-muted);
        }

        .bn-article-body a {
            color: var(--bn-accent);
            text-decoration: underline;
        }

        .bn-article-body ul, .bn-article-body ol {
            padding-left: 1.5em;
            margin-bottom: 1.4em;
        }

        .bn-article-body li {
            margin-bottom: 0.4em;
        }
</style>

<!-- ── SEO Schemas (preserved exactly) ───────────────────── -->
<script type="application/ld+json">@Html.Raw(Model.ArticleSchemaJson)</script>
<script type="application/ld+json">@Html.Raw(Model.BreadcrumbSchemaJson)</script>
@section Scripts
{
   <script>
document.addEventListener('DOMContentLoaded', function () {
    const embeds = document.querySelectorAll('.bn-article-body .quill-social-embed');
    if (embeds.length === 0) return;

    const globalScriptTracker = new Set();

    // ==========================================
    // PASS 1: STRUCTURAL RESTORATION & SANITIZATION
    // ==========================================
    embeds.forEach(function (container) {
        const encodedData = container.getAttribute('data-raw-html');
        if (encodedData) {
            try {
                const originalHtml = decodeURIComponent(escape(atob(encodedData)));
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = originalHtml;
                
                // Track dynamic external runtime scripts while filtering out YouTube/Google payloads
                tempDiv.querySelectorAll('script').forEach(function(scriptTag) {
                    if (scriptTag.src && !scriptTag.src.includes('youtube.com') && !scriptTag.src.includes('google.com')) {
                        globalScriptTracker.add(scriptTag.src);
                    }
                });
                
                tempDiv.querySelectorAll('script').forEach(el => el.remove());

                // --- OPTIMIZED YOUTUBE LAZY ENGINE ---
                const youtubeIframe = tempDiv.querySelector('iframe[src*="youtube.com"], iframe[src*="youtu.be"]');
                if (youtubeIframe) {
                    const originalSrc = youtubeIframe.getAttribute('src');
                    const videoIdMatch = originalSrc.match(/(?:embed\/|v=|v%3D|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
                    if (videoIdMatch && videoIdMatch[1]) {
                        const videoId = videoIdMatch[1];
                        youtubeIframe.setAttribute('srcdoc', `
                            <style>
                                * { padding:0; margin:0; overflow:hidden; box-sizing:border-box; }
                                html, body { height:100%; width:100%; background:#000; display:flex; align-items:center; justify-content:center; }
                                img { position:absolute; width:100%; height:100%; object-fit:cover; top:0; left:0; opacity:0.85; transition: opacity 0.2s; }
                                span { height:60px; width:60px; font-size:30px; color:white; text-align:center; line-height:60px; background:rgba(0,0,0,0.75); position:absolute; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; transition: all 0.2s ease; border: 2px solid rgba(255,255,255,0.5); }
                                a:hover img { opacity: 1; }
                                a:hover span { background: #ff0000; transform: scale(1.1); border-color: #fff; }
                            </style>
                            <a href="${originalSrc}?autoplay=1" style="display:flex; width:100%; height:100%; align-items:center; justify-content:center;">
                                <img src="https://img.youtube.com/vi/${videoId}/hqdefault.jpg" alt="Video Thumbnail">
                                <span>▶</span>
                            </a>
                        `);
                    }
                }
                // -------------------------------------

                container.innerHTML = tempDiv.innerHTML;
            } catch (e) {
                console.error("Failed to decode social framework:", e);
            }
        }
    });

    // ==========================================
    // PASS 2: ASYNCHRONOUS ENGINE PROVISIONING
    // ==========================================
    window.twttr = (function(d, s, id) {
        var js, fjs = d.getElementsByTagName(s)[0], t = window.twttr || {};
        if (d.getElementById(id)) return t;
        js = d.createElement(s); js.id = id;
        js.src = "https://platform.twitter.com/widgets.js";
        fjs.parentNode.insertBefore(js, fjs);
        t._e = []; t.ready = function(f) { t._e.push(f); };
        return t;
    }(document, "script", "twitter-wjs"));

    globalScriptTracker.forEach(function(scriptUrl) {
        if (scriptUrl.includes('twitter.com') || scriptUrl.includes('x.com')) return; 
        if (!document.querySelector(`script[src="${scriptUrl}"]`)) {
            const scriptNode = document.createElement('script');
            scriptNode.src = scriptUrl;
            scriptNode.async = true;
            scriptNode.charset = "utf-8";
            document.head.appendChild(scriptNode);
        }
    });

    // ==========================================
    // PASS 3: PROGRAMMATIC EXECUTION (CRITICAL FIX)
    // ==========================================
    setTimeout(function () {
        
        // Handle Twitter isolated rendering programmatically via direct API insertion
        if (window.twttr && typeof window.twttr.ready === 'function') {
            window.twttr.ready(function (tw) {
                embeds.forEach(function (container) {
                    const tweetAnchor = container.querySelector('.twitter-tweet a[href*="/status/"]');
                    if (tweetAnchor) {
                        const href = tweetAnchor.getAttribute('href');
                        // Extract the unique numeric Tweet ID directly from the URL link
                        const tweetIdMatch = href.match(/\/status\/(\d+)/);
                        
                        if (tweetIdMatch && tweetIdMatch[1]) {
                            const tweetId = tweetIdMatch[1];
                            // Clear out the static blockquote string template entirely
                            container.innerHTML = '';
                            // Build a fresh isolated layout widget target directly via Twitter's API
                            tw.widgets.createTweet(tweetId, container, {
                                theme: 'light',
                                align: 'center'
                            }).catch(err => console.error("Twitter dynamic create failed:", err));
                        }
                    }
                });
            });
        }

        // Handle Facebook and TikTok widgets explicitly using element tracking indicators
        embeds.forEach(function (container) {
            if (window.FB) {
                window.FB.XFBML.parse(container);
            }
            if (window.tiktok && window.tiktok.embed && container.querySelector('.tiktok-embed')) {
                window.tiktok.embed.render(container);
            }
        });

    }, 150); 
});
</script>
}


