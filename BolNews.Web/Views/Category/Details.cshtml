@using BolNews.Web.Areas.Admin.ViewModels
@model CategorySectionVM

@{
    var categoryName = Model.CategoryName ?? ViewBag.CategorySlug;
}

<!-- ── Breadcrumb ──────────────────────────────────────────── -->
<div style="background:var(--bn-surface-alt);border-bottom:1px solid var(--bn-border);">
    <div class="container py-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-family:var(--bn-font-ui);font-size:12px;">
                <li class="breadcrumb-item"><a href="/" style="color:var(--bn-text-muted);text-decoration:none;">Home</a></li>
                <li class="breadcrumb-item active" style="color:var(--bn-text-muted);" aria-current="page">@categoryName</li>
            </ol>
        </nav>
    </div>
</div>

<!-- ── Category header ────────────────────────────────────── -->
<div style="background:var(--bn-nav-bg);padding:28px 0 24px;">
    <div class="container">
        <span class="bn-tag d-inline-block mb-2">Section</span>
        <h1 style="
            font-family:var(--bn-font-display);
            font-size:clamp(26px,4vw,40px);
            font-weight:800;
            color:#fff;
            margin:0;
            line-height:1.2;">
            @categoryName
        </h1>
        @if (!string.IsNullOrEmpty(ViewBag.CategoryDescription as string))
        {
            <p style="font-family:var(--bn-font-ui);font-size:14px;color:rgba(255,255,255,0.6);margin-top:8px;margin-bottom:0;">
                @Html.Raw(ViewBag.CategoryDescription)
            </p>
        }
    </div>
</div>

<!-- ── Main layout ────────────────────────────────────────── -->
<div class="container" style="padding-top:32px;padding-bottom:48px;">
    <div class="row g-4">

        <!-- ── Articles grid ───────────────────────────────── -->
        <div class="col-lg-8">

            @if (!Model.Articles.Any())
            {
                <div style="
                    padding:60px 24px;
                    text-align:center;
                    background:var(--bn-surface);
                    border-radius:var(--bn-radius-md);
                    border:1px solid var(--bn-border);">
                    <div style="font-size:48px;margin-bottom:12px;">📰</div>
                    <h3 style="font-family:var(--bn-font-display);color:var(--bn-text-primary);">No articles yet</h3>
                    <p style="font-family:var(--bn-font-ui);color:var(--bn-text-muted);">Check back soon for the latest stories in @categoryName.</p>
                    <a href="/" style="font-family:var(--bn-font-ui);font-size:13px;font-weight:600;color:var(--bn-accent);">← Back to Home</a>
                </div>
            }
            else
            {
                <!-- First article: featured large card -->
              
                    var first = Model.Articles.First();
                    var rest  = Model.Articles.Skip(1).ToList();
               

                @if (ViewBag.Page == 1 || ViewBag.Page == null)
                {
                    <a href="/news/@first.CategorySlug/@first.Slug"
                       class="bn-card-featured track-click d-block mb-4"
                       data-article-id="@first.Id"
                       style="text-decoration:none;">
                        <div class="bn-card-featured-img">
                            <img src="@first.FeaturedImageLarge"
                                 alt="@first.Title"
                                 loading="eager"
                                 style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                        <div class="bn-card-featured-body">
                            <div class="bn-card-tag">@first.CategoryName</div>
                            <h2 class="bn-card-featured-title">@first.Title</h2>
                            @if (!string.IsNullOrEmpty(first.Summary))
                            {
                                <p class="bn-card-featured-excerpt">@first.Summary</p>
                            }
                            <div class="bn-card-meta">
                                <span>@first.AuthorName</span>
                                <span class="bn-card-meta-dot"></span>
                                <span>@first.TimeAgo</span>
                                @if (first.ReadingTimeMinutes > 0)
                                {
                                    <span class="bn-card-meta-dot"></span>
                                    <span>@first.ReadingTimeMinutes min read</span>
                                }
                            </div>
                        </div>
                    </a>

                    <!-- Remaining articles as horizontal cards -->
                    @foreach (var item in rest)
                    {
                        <a href="/news/@item.CategorySlug/@item.Slug"
                           class="bn-card-h track-click d-flex"
                           data-article-id="@item.Id"
                           style="text-decoration:none;">
                            <div class="bn-card-h-img">
                                <img src="@item.FeaturedImageThumb"
                                     alt="@item.Title"
                                     loading="lazy"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                            <div class="bn-card-h-body">
                                <div class="bn-card-h-tag">@item.CategoryName</div>
                                <div class="bn-card-h-title">@item.Title</div>
                                <div class="bn-card-h-meta">
                                    @item.AuthorName · @item.TimeAgo
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <!-- All pages after first: uniform horizontal cards -->
                    @foreach (var item in Model.Articles)
                    {
                        <a href="/news/@item.CategorySlug/@item.Slug"
                           class="bn-card-h track-click d-flex"
                           data-article-id="@item.Id"
                           style="text-decoration:none;">
                            <div class="bn-card-h-img">
                                <img src="@item.FeaturedImageThumb"
                                     alt="@item.Title"
                                     loading="lazy"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                            <div class="bn-card-h-body">
                                <div class="bn-card-h-tag">@item.CategoryName</div>
                                <div class="bn-card-h-title">@item.Title</div>
                                <div class="bn-card-h-meta">
                                    @item.AuthorName · @item.TimeAgo
                                </div>
                            </div>
                        </a>
                    }
                }

                <!-- Pagination -->
                <div style="
                    display:flex;
                    align-items:center;
                    justify-content:space-between;
                    padding:20px 0;
                    margin-top:16px;
                    border-top:1px solid var(--bn-border);">
                    <div>
                        @if (ViewBag.Page > 1)
                        {
                            <a href="/news/@ViewBag.CategorySlug?page=@(ViewBag.Page - 1)"
                               style="display:inline-flex;align-items:center;gap:6px;font-family:var(--bn-font-ui);font-size:13px;font-weight:600;color:var(--bn-text-primary);text-decoration:none;padding:8px 16px;border:1px solid var(--bn-border);border-radius:var(--bn-radius-sm);background:var(--bn-surface);transition:all 0.2s;">
                                ← Previous
                            </a>
                        }
                    </div>
                    <span style="font-family:var(--bn-font-ui);font-size:12px;color:var(--bn-text-muted);">
                        Page @ViewBag.Page
                    </span>
                    <div>
                        @if (Model.Articles.Count == ViewBag.PageSize)
                        {
                            <a href="/news/@ViewBag.CategorySlug?page=@(ViewBag.Page + 1)"
                               style="display:inline-flex;align-items:center;gap:6px;font-family:var(--bn-font-ui);font-size:13px;font-weight:600;color:#fff;text-decoration:none;padding:8px 16px;border-radius:var(--bn-radius-sm);background:var(--bn-accent);">
                                Next →
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- ── Sidebar ──────────────────────────────────────── -->
        <aside class="col-lg-4">
            <div style="position:sticky;top:70px;">
                <!-- Trending -->
                <div class="bn-widget">
                    @await Component.InvokeAsync("TrendingNews",
                    new { type = Context.Request.Query["type"].ToString() })
                </div>
                <!-- Latest news -->
                <div class="bn-widget mb-4">
                    <div class="bn-widget-title">Latest News</div>
                    <div class="bn-scroll-container">
                        @await Component.InvokeAsync("LatestNews", new { count = 10 })
                    </div>
                </div>
            </div>
        </aside>

    </div>
</div>

<!-- ── SEO Schemas (preserved exactly) ───────────────────── -->
<script type="application/ld+json">@Html.Raw(Model.CategorySchemaJson)</script>
<script type="application/ld+json">@Html.Raw(Model.BreadcrumbSchemaJson)</script>
