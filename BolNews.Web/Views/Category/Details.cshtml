@using BolNews.Web.Areas.Admin.ViewModels
@model CategorySectionVM

@{
    var categoryName = Model.CategoryName ?? ViewBag.CategorySlug;
}

<div class="bn-container">
    <div class="container" style="padding-top:16px;">
        <div class="bn-category-navigation">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bn-category-breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><a href="/category/@Model.CategorySlug">@categoryName</a></li>
                </ol>
            </nav>
            @if (Model.RelatedCategories.Any())
            {
                <div class="bn-category-pills" aria-label="Related categories">
                    @foreach (var item in Model.RelatedCategories)
                    {
                        <a href="/category/@item.Slug" class="@(item.IsSelected ? "is-active" : null)">@item.Name</a>
                    }
                </div>
            }
        </div>
    </div>

    <div class="container" style="padding-top:32px;padding-bottom:48px;">
        <div class="row g-4">
            <main class="col-lg-8">
                <h1 class="visually-hidden">@categoryName</h1>
                @if (Model.FeaturedArticle is { } featured)
                {
                    <a href="/@featured.CategorySlug/@featured.Slug" class="bn-category-featured track-click d-block" data-article-id="@featured.Id">
                        <img src="@featured.FeaturedImageLarge" alt="@featured.Title" loading="eager" />
                        <div class="bn-category-featured-body">
                            <div class="bn-category-label">Latest in @categoryName</div>
                            <h2>@featured.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(featured.Summary))
                            {
                                <p>@featured.Summary</p>
                            }
                            <span>@featured.TimeAgo</span>
                        </div>
                    </a>
                }

                @if (Model.Articles.Any())
                {
                    <div class="row g-3 mt-1">
                        @foreach (var item in Model.Articles)
                        {
                            <div class="col-6 col-md-4">
                                <a href="/@item.CategorySlug/@item.Slug" class="bn-category-card track-click d-block h-100" data-article-id="@item.Id">
                                    <div class="bn-category-card-img">
                                        <img src="@item.FeaturedImageMedium" alt="@item.Title" loading="lazy" />
                                    </div>
                                    <h2>@item.Title</h2>
                                    <span>@item.TimeAgo</span>
                                </a>
                            </div>
                        }
                    </div>
                }
                else if (Model.Page == 1)
                {
                    <p class="bn-category-empty">No additional stories are available in @categoryName yet.</p>
                }

                <nav class="bn-category-pagination" aria-label="Category pagination">
                    @if (Model.Page > 1)
                    {
                        <a href="/category/@Model.CategorySlug?page=@(Model.Page - 1)">← Previous</a>
                    }
                    else
                    {
                        <span></span>
                    }
                    <span>Page @Model.Page</span>
                    @if (Model.HasNextPage)
                    {
                        <a href="/category/@Model.CategorySlug?page=@(Model.Page + 1)">Next →</a>
                    }
                    else
                    {
                        <span></span>
                    }
                </nav>
            </main>

            <aside class="col-lg-4">
                <div style="position:sticky;top:70px;">
                    <!-- Sidebar Ad — Top -->
                    <div class="bn-ad-slot mb-4">
                        <div id="Bolnews_Sidebar_Top_ATF" data-ad-slot="sidebar-top-atf"></div>
                    </div>
                    <div class="bn-story-rail"><h2>Latest News</h2></div>
                    <div class="mb-4">
                        @await Component.InvokeAsync("LatestNews", new { count = 8 })
                    </div>
                    <div class="bn-story-rail"><h2>Trending</h2></div>
                        @await Component.InvokeAsync("TrendingNews", new { type = Context.Request.Query["type"].ToString() })
                    
                </div>
            </aside>
        </div>
    </div>
</div>

<style>
    .bn-category-breadcrumb { display:inline-flex; font-family:var(--bn-font-body); font-size:12px; font-weight:600; background:#fff; border:1px solid #dee2e6; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,.08); padding:13px; margin:0; }
    .bn-category-breadcrumb a { color:#000; text-decoration:none; }
    .bn-category-breadcrumb .active a { color:#C4161C; }
    .bn-category-navigation { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    .bn-category-pills { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .bn-category-pills a { border:1px solid #dee2e6; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,.08); color:#000; font-family:var(--bn-font-body); font-size:12px; font-weight:600; padding:13px; text-decoration:none; }
    .bn-category-pills a:hover, .bn-category-pills a.is-active { background:#C4161C; border-color:#C4161C; color:#fff; }
    .bn-category-featured { color:inherit; text-decoration:none; border-top:3px double #00000087; border-bottom:3px double #00000087; padding:8px 0 12px; }
    .bn-category-featured > img { display:block; width:100%; max-height:420px; object-fit:cover; }
    .bn-category-featured-body { padding:12px 10px 0; }
    .bn-category-label { color:#C4161C; font-family:var(--bn-font-ui); font-size:12px; font-weight:700; text-transform:uppercase; }
    .bn-category-featured h1 { color:#C4161C; font-family:var(--bn-font-body); font-size:22px; font-weight:600; line-height:32px; margin:6px 0; }

    .bn-category-featured h2 {
        color: #C4161C;
        font-family: var(--bn-font-body);
        font-size: 22px;
        font-weight: 600;
        line-height: 32px;
        margin: 6px 0;
    }
    .bn-category-featured p { color:#000; font-family:var(--bn-font-body); font-size:14px; line-height:22px; margin:0 0 8px; }
    .bn-category-featured span, .bn-category-card span { color:var(--bn-text-muted); font-family:var(--bn-font-ui); font-size:11px; }
    .bn-category-card { color:inherit; text-decoration:none; border:1px solid rgba(0,0,0,.08); border-radius:3px; box-shadow:0 0 5px rgba(0,0,0,.15); padding:7px; transition:box-shadow .2s ease; }
    .bn-category-card:hover { box-shadow:0 0 5px rgba(0,0,0,.35); }
    .bn-category-card-img { aspect-ratio:5/3; overflow:hidden; margin-bottom:7px; }
    .bn-category-card-img img { width:100%; height:100%; object-fit:cover; }
    .bn-category-card h2 { color:#C4161C; font-family:var(--bn-font-ui); font-size:13px; font-weight:600; line-height:20px; text-align:center; margin:0 0 7px; }
    .bn-category-card:hover h2 { color:#000; }
    .bn-category-card span { display:block; text-align:center; }
    .bn-category-pagination { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:12px; margin-top:28px; padding-top:20px; border-top:1px solid var(--bn-border); font-family:var(--bn-font-ui); font-size:13px; }
    .bn-category-pagination > :first-child { justify-self:start; }
    .bn-category-pagination > :last-child { justify-self:end; }
    .bn-category-pagination a { border:1px solid var(--bn-border); border-radius:var(--bn-radius-sm); color:var(--bn-text-primary); padding:8px 16px; text-decoration:none; }
    .bn-category-pagination a:last-child { background:var(--bn-accent); border-color:var(--bn-accent); color:#fff; }
    .bn-category-empty { color:var(--bn-text-muted); font-family:var(--bn-font-ui); margin-top:24px; }
</style>

<script type="application/ld+json">@Html.Raw(Model.CategorySchemaJson)</script>
<script type="application/ld+json">@Html.Raw(Model.BreadcrumbSchemaJson)</script>
