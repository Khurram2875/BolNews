@model CategorySectionVM
<div class="container mt-4">
	<div class="row">

		<!-- 🟢 LEFT SIDEBAR (Latest) -->
		<div class="col-md-3" style="border-right:solid; border-width:thin;">
			@await Component.InvokeAsync("LatestNews", new { count = 6 })
		</div>

		<div class="col-md-6">
			@if (!string.IsNullOrEmpty(ViewBag.CategoryDescription))
			{
				<div class="mb-4">
					@Html.Raw(ViewBag.CategoryDescription)
				</div>
			}

			<h1>@ViewBag.CategorySlug</h1>
			@foreach (var article in Model.Articles)
			{
				<div>

					<a asp-route="articleDetails"
					   asp-route-categorySlug="@article.CategorySlug"
					   asp-route-slug="@article.Slug">
						@article.Title
					</a>
				</div>
			}
			<div class="pagination">

				@if (ViewBag.Page > 1)
				{
					<a href="/news/@ViewBag.CategorySlug?page=@(ViewBag.Page - 1)">Previous</a>
				}

				<span>Page @ViewBag.Page</span>

				@if (Model.Articles.Count == ViewBag.PageSize)
				{
					<a href="/news/@ViewBag.CategorySlug?page=@(ViewBag.Page + 1)">Next</a>
				}

			</div>
		</div>
		<div class="col-md-3">
			@await Component.InvokeAsync("TrendingNews",
			new { type = Context.Request.Query["type"].ToString() })
		</div>
	</div>
</div>

@using BolNews.Web.Areas.Admin.ViewModels

<script type="application/ld+json">
	@Html.Raw(Model.CategorySchemaJson)
<script type="application/ld+json">
	@Html.Raw(Model.BreadcrumbSchemaJson)
</script>
