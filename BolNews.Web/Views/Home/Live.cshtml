@{
    ViewData["Title"] = "Bol News Live";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/live.css" asp-append-version="true" />
}

<div class="site grid-container hfeed container" id="page">
    <div class="site-content" id="content">
        <div class="bn-home-shell">
            <div class="mb-4 py-0">
                <div class="d-flex align-items-center gap-3">
                    <img decoding="async" width="47" height="46" src="~/images/small-logo.png" class="img-fluid" alt="BOL News Logo">
                    <h1 class="h3 fw-bold text-dark m-0" style="letter-spacing: -0.5px;">
                        Live BOL NEWS | BOL NEWS LIVE STREAMING
                    </h1>
                </div>
            </div>

            <div>
                <div class="e-con-inner">
                    <div class="elementor-shortcode">
                        <div class="gy-live-wrapper">
                            <div class="gy-live-thumbnail" id="gy-live-thumb">
                                <img decoding="async" src="https://img.youtube.com/vi/M8DGZa5xX5A/maxresdefault.jpg" alt="Watch Live Stream">
                                <div class="gy-live-play-btn"></div>
                                <div class="gy-live-overlay">Watch Live</div>
                            </div>

                            <div class="gy-live-player" id="gy-live-player">
                                <iframe id="gy-live-iframe"
                                        src=""
                                        allow="autoplay; encrypted-media"
                                        sandbox="allow-scripts allow-same-origin allow-forms allow-presentation"
                                        allowfullscreen>
                                </iframe>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/live.js" asp-append-version="true"></script>
}
