<div class="container py-5 text-center">
    <h1>@T["Page not found"]</h1>
    <p>
        The page you're looking for doesn't exist or may have been moved.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
        Return Home
    </a>
    <div class="mt-4">
        <a asp-controller="Category" asp-action="Details" asp-route-categorySlug="pakistan">@T["Pakistan"]</a> ·
        <a asp-controller="Category" asp-action="Details" asp-route-categorySlug="world">@T["World"]</a> ·
        <a asp-controller="Category" asp-action="Details" asp-route-categorySlug="sports">@T["Sports"]</a> ·
        <a asp-controller="Category" asp-action="Details" asp-route-categorySlug="entertainment">@T["Entertainment"]</a>
    </div>
</div>