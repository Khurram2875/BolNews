@using BolNews.Web.Areas.Admin.ViewModels
@using BolNews.Web.Services
@inject BolNews.Web.Services.SiteProfileService SiteProfileService
@model HomePageVM

@section Styles {
    <link rel="stylesheet" href="~/css/pages/@(ViewData["IsRtl"] is true ? "home.rtl.css" : "home.css")" asp-append-version="true" />
}

@{
    var siteProfile = await SiteProfileService.GetAsync(Context.RequestAborted);
    ViewData["EnableTimedRefresh"] = true;
    ViewData["Title"] = siteProfile.DefaultMetaTitle;
    ViewBag.MetaTitle = siteProfile.DefaultMetaTitle;
    ViewBag.MetaDescription = siteProfile.DefaultMetaDescription;
    // ViewData["Title"] = "Home";

    // All slot decisions (pinning, counts, de-duplication) live in HomeLayoutBuilder; this view only renders them.
    var slots = HomeLayoutBuilder.Build(Model, siteProfile.HomeLayout);
    var layout = slots.Layout;

    var showLatestRail = layout.LatestEnabled && (slots.Latest.Any() || layout.ShowPoll || layout.ShowLiveEvents);
    var showFeaturedRail = layout.FeaturedEnabled && (slots.Featured.Any() || (layout.ShowShows && slots.ShowCarouselImages.Any()));
    var firstRailIsFeatured = layout.FeaturedRailFirst;
    var hasFirstRail = firstRailIsFeatured ? showFeaturedRail : showLatestRail;
    var hasSecondRail = firstRailIsFeatured ? showLatestRail : showFeaturedRail;
    var heroLayoutClass = hasFirstRail && hasSecondRail ? "" : hasFirstRail ? " bn-home-hero--left-only" : hasSecondRail ? " bn-home-hero--right-only" : " bn-home-hero--center-only";
}

<h1 class="visually-hidden">@siteProfile.SiteName – @siteProfile.Tagline</h1>
<div class="bn-container bn-container--home">
    @if (slots.TopStory != null)
    {
        <section class="bn-home-hero bn-home-hero--three@(heroLayoutClass)" aria-label="@T["Top stories"]">
            @if (!firstRailIsFeatured && showLatestRail)
            {
                @await Component.InvokeAsync("HomeLatest", new { slots })
            }
            @if (firstRailIsFeatured && showFeaturedRail)
            {
                @await Component.InvokeAsync("HomeFeatured", new { slots })
            }

            @await Component.InvokeAsync("HomeTopStories", new { slots })

            @if (firstRailIsFeatured && showLatestRail)
            {
                @await Component.InvokeAsync("HomeLatest", new { slots })
            }
            @if (!firstRailIsFeatured && showFeaturedRail)
            {
                @await Component.InvokeAsync("HomeFeatured", new { slots })
            }
        </section>
    }
</div>

@await Component.InvokeAsync("AdZone", new { zone = "home.content" })

@await Component.InvokeAsync("HomeCategories", new { slots })
