@using BolNews.Web.Areas.Admin.ViewModels
@model HomePageVM

@{
	ViewData["Title"] = "Home";
}

<div class="container">
	<div class="bn-hero">

		@if (Model.TopStory != null)
		{
			<div class="d-flex bg-dark justify-content-left container" style="border-radius: 12px;">
				<h3 style="font-family: var(--bn-font-display); font-size: clamp(26px, 4vw, 30px); font-weight: 800; color: #fff; margin: 0; line-height: 1.2;">
					Latest Stories
				</h3>
			</div>

			<div class="bn-hero-grid bg-dark mt-1">

				<a href="/news/@Model.TopStory.CategorySlug/@Model.TopStory.Slug"
				   class="bn-hero-card bn-hero-main track-click"
				   data-article-id="@Model.TopStory.Id">
					<img src="@Model.TopStory.FeaturedImageLarge"
						 alt="@Model.TopStory.Title"
						 loading="eager" />
					<div class="bn-hero-overlay"></div>
					<div class="bn-hero-content">
						<span class="bn-tag">@Model.TopStory.CategoryName</span>
						<h1 class="bn-hero-title">@Model.TopStory.Title</h1>
						<div class="bn-hero-meta">
							<span>@Model.TopStory.AuthorName</span>
							<span>·</span>
							<span>@Model.TopStory.TimeAgo</span>
							@if (Model.TopStory.ReadingTimeMinutes > 0)
							{
								<span>·</span>
								<span>@Model.TopStory.ReadingTimeMinutes min read</span>
							}
						</div>
					</div>
				</a>

				@if (Model.SecondaryStories != null && Model.SecondaryStories.Count > 2)
				{
					<div class="bn-sidebar-panel bg-dark rounded p-3 text-white">
						<div class="bn-sidebar-scroll bg-dark text-white" style="max-height: 450px; overflow-y: auto; padding-right: 8px;">

							@* Skips the first story to optimize feed density and pulls adjacent articles *@
							@foreach (var item in Model.SecondaryStories.Take(8))
							{
								<a href="/news/@item.CategorySlug/@item.Slug"
								   class="bn-list-item d-flex align-items-center text-decoration-none border-bottom border-secondary track-click py-3 text-white"
								   data-article-id="@item.Id">

									<div class="bn-list-thumb me-3 flex-shrink-0" style="width: 120px; height: 75px; overflow: hidden; border-radius: 4px;">
										<img src="@item.FeaturedImageThumb"
											 alt="@item.Title"
											 class="w-100 h-100 object-fit-cover"
											 loading="lazy" />
									</div>

									<div class="bn-list-content flex-grow-1">
										<h3 class="bn-list-title fw-bold fs-6 lh-sm m-0 mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
											@item.Title
										</h3>
										<div class="bn-list-meta text-muted small">
											<span>@item.TimeAgo</span>
										</div>
									</div>

								</a>
							}

						</div>
					</div>
				}

			</div>
		}

		@{
			var secondaryCards = Model.SecondaryStories.Skip(8).Take(12).ToList();
		}

		@if (secondaryCards != null && secondaryCards.Any())
		{
			var cardChunks = secondaryCards.Chunk(4).ToList();

			<div id="multiCardCarousel" class="carousel slide mt-4" data-bs-ride="carousel" data-bs-interval="false">

				<div class="carousel-inner">
					@for (int i = 0; i < cardChunks.Count; i++)
					{
						var chunk = cardChunks[i];

						<div class="carousel-item @(i == 0 ? "active" : "")">
							<div class="row g-3 px-0">
								@foreach (var item in chunk)
								{
									<div class="col-9 col-sm-6 col-md-6 col-lg-3">
										<a href="/news/@item.CategorySlug/@item.Slug"
										   class="bn-card track-click d-block h-100 text-decoration-none"
										   data-article-id="@item.Id">

											<div class="bn-card-img">
												<img class="lazy-image d-block w-100"
													 src="/images/placeholder.png"
													 data-src="@item.FeaturedImageThumb"
													 alt="@item.Title"
													 loading="lazy" />
											</div>

											<div class="bn-card-body">
												<div class="bn-card-tag">@item.CategoryName</div>
												<h3 class="bn-card-title">@item.Title</h3>
												<div class="bn-card-meta">
													<span>@item.AuthorName</span>
													<span class="bn-card-meta-dot"></span>
													<span>@item.TimeAgo</span>
												</div>
											</div>

										</a>
									</div>
								}
							</div>
						</div>
					}
				</div>

				<button class="carousel-control-prev" type="button" data-bs-target="#multiCardCarousel" data-bs-slide="prev">
					<span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
					<span class="visually-hidden">Previous</span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#multiCardCarousel" data-bs-slide="next">
					<span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
					<span class="visually-hidden">Next</span>
				</button>

			</div>
		}

	</div>
</div>
<div class="mt-4">
	@await Component.InvokeAsync("SmartTrending", new { count = 5 })
</div>
@if (Model.CategorySections.Count > 2)
{
	<div class="bn-cat-strip mt-4">
		<div class="container">
			@foreach (var cat in Model.CategorySections)
			{
				<div class="mb-5">

					<div class="bn-section-header">
						<span class="bn-section-title">@cat.CategoryName</span>
						<a href="/news/@cat.CategorySlug" class="bn-section-link">More →</a>
					</div>

					<div class="bn-cat-grid">
						@foreach (var item in cat.Articles.Take(4))
						{
							<a href="/news/@item.CategorySlug/@item.Slug"
							   class="bn-card track-click"
							   data-article-id="@item.Id">
								<div class="bn-card-img">
									<img class="lazy-image"
										 src="/images/placeholder.png"
										 data-src="@item.FeaturedImageThumb"
										 alt="@item.Title"
										 loading="lazy" />
								</div>
								<div class="bn-card-body">
									<div class="bn-card-tag">@item.CategoryName</div>
									<h3 class="bn-card-title">@item.Title</h3>
									<div class="bn-card-meta">
										<span>@item.AuthorName</span>
										<span class="bn-card-meta-dot"></span>
										<span>@item.TimeAgo</span>
									</div>
								</div>
							</a>
						}
					</div>

				</div>
			}
		</div>

	</div>
}

