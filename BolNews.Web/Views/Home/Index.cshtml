@using BolNews.Web.Areas.Admin.ViewModels
@model HomePageVM

@{
    ViewData["Title"] = "Home";
}

<!-- ============================================================
     HERO + SECONDARY GRID
     ============================================================ -->
<div class="container">
    <div class="bn-hero">

        <!-- Hero 3-panel grid -->
        @if (Model.TopStory != null)
        {
            <div class="bn-hero-grid">

                <!-- Main hero story -->
                <a href="/news/@Model.TopStory.CategorySlug/@Model.TopStory.Slug"
                   class="bn-hero-card bn-hero-main track-click"
                   data-article-id="@Model.TopStory.Id">
                    <img src="@Model.TopStory.FeaturedImageLarge"
                         alt="@Model.TopStory.Title"
                         loading="eager" />
                    <div class="bn-hero-overlay"></div>
                    <div class="bn-hero-content">
                        <span class="bn-tag">@Model.TopStory.CategoryName</span>
                        <h1 class="bn-hero-title">@Model.TopStory.Title</h1>
                        <div class="bn-hero-meta">
                            <span>@Model.TopStory.AuthorName</span>
                            <span>·</span>
                            <span>@Model.TopStory.TimeAgo</span>
                            @if (Model.TopStory.ReadingTimeMinutes > 0)
                            {
                                <span>·</span>
                                <span>@Model.TopStory.ReadingTimeMinutes min read</span>
                            }
                        </div>
                    </div>
                </a>

                <!-- Side stories (first 2 of SecondaryStories) -->
                @if (Model.SecondaryStories.Count > 0)
                {
                    var side1 = Model.SecondaryStories[0];
                    <a href="/news/@side1.CategorySlug/@side1.Slug"
                       class="bn-hero-card bn-hero-side-top track-click"
                       data-article-id="@side1.Id">
                        <img src="@side1.FeaturedImageMedium"
                             alt="@side1.Title"
                             loading="eager" />
                        <div class="bn-hero-overlay"></div>
                        <div class="bn-hero-content">
                            <span class="bn-tag">@side1.CategoryName</span>
                            <h2 class="bn-hero-title">@side1.Title</h2>
                            <div class="bn-hero-meta"><span>@side1.TimeAgo</span></div>
                        </div>
                    </a>
                }

                @if (Model.SecondaryStories.Count > 1)
                {
                    var side2 = Model.SecondaryStories[1];
                    <a href="/news/@side2.CategorySlug/@side2.Slug"
                       class="bn-hero-card bn-hero-side-bottom track-click"
                       data-article-id="@side2.Id">
                        <img src="@side2.FeaturedImageMedium"
                             alt="@side2.Title"
                             loading="eager" />
                        <div class="bn-hero-overlay"></div>
                        <div class="bn-hero-content">
                            <span class="bn-tag">@side2.CategoryName</span>
                            <h2 class="bn-hero-title">@side2.Title</h2>
                            <div class="bn-hero-meta"><span>@side2.TimeAgo</span></div>
                        </div>
                    </a>
                }

            </div>
        
            <!-- /bn-hero-grid -->
        }

        <!-- Secondary cards row (stories 3–6) -->
        @{
            var secondaryCards = Model.SecondaryStories.Skip(2).Take(6).ToList();
        }
        @if (secondaryCards.Any())
        {
            <div class="bn-secondary-grid">
                @foreach (var item in secondaryCards)
                {
                    <a href="/news/@item.CategorySlug/@item.Slug"
                       class="bn-card track-click"
                       data-article-id="@item.Id">
                        <div class="bn-card-img">
                            <img class="lazy-image"
                                 src="/images/placeholder.png"
                                 data-src="@item.FeaturedImageThumb"
                                 alt="@item.Title"
                                 loading="lazy" />
                        </div>
                        <div class="bn-card-body">
                            <div class="bn-card-tag">@item.CategoryName</div>
                            <h3 class="bn-card-title">@item.Title</h3>
                            <div class="bn-card-meta">
                                <span>@item.AuthorName</span>
                                <span class="bn-card-meta-dot"></span>
                                <span>@item.TimeAgo</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }

    </div><!-- /bn-hero -->
</div><!-- /container -->
<!-- ============================================================
     MAIN LAYOUT: Latest | Opinion | Sidebar
     ============================================================ -->
<div class="container">
    <div class="bn-main-layout">

        <!-- Column 1: Latest News (ViewComponent) -->
        <div>
            <div class="bn-section-header">
                <span class="bn-section-title">Latest News</span>
                <a href="/news" class="bn-section-link">All News →</a>
            </div>
            @await Component.InvokeAsync("LatestNews", new { count = 6 })
        </div>

        <!-- Column 2: Category sections -->
        <div>
            @foreach (var cat in Model.CategorySections.Take(2))
            {
                <div class="mb-4">
                    <div class="bn-section-header">
                        <span class="bn-section-title">@cat.CategoryName</span>
                        <a href="/news/@cat.CategorySlug" class="bn-section-link">More →</a>
                    </div>

                    @{
                        var featuredArticle = cat.Articles.FirstOrDefault();
                        var listArticles = cat.Articles.Skip(1).ToList();
                    }

                    @if (featuredArticle != null)
                    {
                        <a href="/news/@featuredArticle.CategorySlug/@featuredArticle.Slug"
                           class="bn-card-featured track-click"
                           data-article-id="@featuredArticle.Id">
                            <div class="bn-card-featured-img">
                                <img class="lazy-image"
                                     src="/images/placeholder.png"
                                     data-src="@featuredArticle.FeaturedImageMedium"
                                     alt="@featuredArticle.Title"
                                     loading="lazy" />
                            </div>
                            <div class="bn-card-featured-body">
                                <div class="bn-card-tag">@featuredArticle.CategoryName</div>
                                <h3 class="bn-card-featured-title">@featuredArticle.Title</h3>
                                @if (!string.IsNullOrEmpty(featuredArticle.MetaDescription))
                                {
                                    <p class="bn-card-featured-excerpt">@featuredArticle.MetaDescription</p>
                                }
                                <div class="bn-card-meta">
                                    <span>@featuredArticle.AuthorName</span>
                                    <span class="bn-card-meta-dot"></span>
                                    <span>@featuredArticle.TimeAgo</span>
                                </div>
                            </div>
                        </a>
                    }

                    @foreach (var item in listArticles.Take(3))
                    {
                        <a href="/news/@item.CategorySlug/@item.Slug"
                           class="bn-card-h track-click"
                           data-article-id="@item.Id">
                            <div class="bn-card-h-img">
                                <img class="lazy-image"
                                     src="/images/placeholder.png"
                                     data-src="@item.FeaturedImageThumb"
                                     alt="@item.Title"
                                     loading="lazy" />
                            </div>
                            <div class="bn-card-h-body">
                                <div class="bn-card-h-tag">@item.CategoryName</div>
                                <div class="bn-card-h-title">@item.Title</div>
                                <div class="bn-card-h-meta">@item.TimeAgo</div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        <!-- Sidebar -->
        <aside class="bn-sidebar">

            <!-- Newsletter -->
            <div class="bn-newsletter">
                <h5>Stay Informed</h5>
                <p>Top stories delivered to your inbox every morning.</p>
                <div class="bn-newsletter-form">
                    <input type="email" class="bn-newsletter-input" placeholder="Your email" />
                    <button class="bn-newsletter-btn" type="button">Subscribe</button>
                </div>
            </div>

            <!-- Trending (ViewComponent) -->
            <div class="bn-widget">
                @await Component.InvokeAsync("TrendingNews",
                new { type = Context.Request.Query["type"].ToString() })
            </div>

            <!-- Featured (reuse first 3 secondary stories) -->
            <div class="bn-widget">
                <div class="bn-widget-title">Featured</div>
                @foreach (var item in Model.SecondaryStories.Take(3))
                {
                    <a href="/news/@item.CategorySlug/@item.Slug"
                       class="bn-card-h track-click"
                       data-article-id="@item.Id">
                        <div class="bn-card-h-img">
                            <img class="lazy-image"
                                 src="/images/placeholder.png"
                                 data-src="@item.FeaturedImageThumb"
                                 alt="@item.Title"
                                 loading="lazy" />
                        </div>
                        <div class="bn-card-h-body">
                            <div class="bn-card-h-tag">@item.CategoryName</div>
                            <div class="bn-card-h-title">@item.Title</div>
                            <div class="bn-card-h-meta">@item.TimeAgo</div>
                        </div>
                    </a>
                }
            </div>

        </aside>

    </div><!-- /bn-main-layout -->
</div>

<!-- ============================================================
     CATEGORY SECTIONS (remaining sections after the first 2)
     ============================================================ -->
@if (Model.CategorySections.Count > 2)
{
    <div class="bn-cat-strip">
        <div class="container">
            @foreach (var cat in Model.CategorySections.Skip(2))
            {
                <div class="mb-5">
                    <div class="bn-section-header">
                        <span class="bn-section-title">@cat.CategoryName</span>
                        <a href="/news/@cat.CategorySlug" class="bn-section-link">More →</a>
                    </div>
                    <div class="bn-cat-grid">
                        @foreach (var item in cat.Articles.Take(4))
                        {
                            <a href="/news/@item.CategorySlug/@item.Slug"
                               class="bn-card track-click"
                               data-article-id="@item.Id">
                                <div class="bn-card-img">
                                    <img class="lazy-image"
                                         src="/images/placeholder.png"
                                         data-src="@item.FeaturedImageThumb"
                                         alt="@item.Title"
                                         loading="lazy" />
                                </div>
                                <div class="bn-card-body">
                                    <div class="bn-card-tag">@item.CategoryName</div>
                                    <h3 class="bn-card-title">@item.Title</h3>
                                    <div class="bn-card-meta">
                                        <span>@item.AuthorName</span>
                                        <span class="bn-card-meta-dot"></span>
                                        <span>@item.TimeAgo</span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
<!-- ============================================================
	Smart Trending (ViewComponent) - This is a new section that can be placed in the sidebar or as a full-width section before the footer. It uses the new GetTrendingAsync method with time-based filtering.
     ============================================================ -->
@await Component.InvokeAsync("SmartTrending", new { count = 5 })
