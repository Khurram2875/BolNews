@inject BolNews.Web.Services.SiteProfileService SiteProfileService
@{
    var profile = await SiteProfileService.GetAsync(Context.RequestAborted);
    ViewData["Title"] = $"About Us - {profile.SiteName}";
}
<main class="bn-container bn-information-page">
    <h1>About Us - @profile.SiteName</h1>
    @if (!string.IsNullOrWhiteSpace(profile.AboutContent))
    {
        <div class="bn-site-page-content">@profile.AboutContent</div>
    }
    else
    {
        <p>This page has not been configured yet. An administrator can add its content in Publisher Settings.</p>
    }
</main>
