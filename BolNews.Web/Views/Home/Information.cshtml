@inject BolNews.Web.Services.SiteProfileService SiteProfileService
@{
    var profile = await SiteProfileService.GetAsync(Context.RequestAborted);
    var page = ViewData["InformationPage"]?.ToString();
    var pageTitle = page switch
    {
        "about" => "About Us",
        "contact" => "Contact Us",
        "advertise" => "Advertise",
        "blogs" => "Blogs",
        "branded-content" => "Branded Content",
        "editorial-policy" => "Editorial Policy",
        "privacy" => "Privacy Policy",
        "terms-of-service" => "Terms of Service",
        _ => profile.SiteName
    };
    var customContent = page switch
    {
        "about" => profile.AboutContent,
        "contact" => profile.ContactContent,
        "advertise" => profile.AdvertiseContent,
        "blogs" => profile.BlogsContent,
        "branded-content" => profile.BrandedContent,
        "editorial-policy" => profile.EditorialPolicyContent,
        "privacy" => profile.PrivacyPolicyContent,
        "terms-of-service" => profile.TermsOfServiceContent,
        _ => null
    };
    ViewData["Title"] = $"{pageTitle} - {profile.SiteName}";
}

<div class="bn-container" style="padding-top:20px">
    <div class="container" style="padding-top:48px;padding-bottom:48px">
        <div class="row g-4">
            <main class="col-lg-8 bn-information-page">
                <h1>@pageTitle - @profile.SiteName</h1>
                @if (!string.IsNullOrWhiteSpace(customContent))
                {
                    <div class="bn-site-page-content">@customContent</div>
                }
                else
                {
                    <div class="alert alert-info">
                        This page has not been configured yet. An administrator can add its content in Publisher Settings.
                    </div>
                }
            </main>
            <aside class="col-lg-4">
                <div style="position:sticky;top:70px">
                    <div class="bn-story-rail"><h2>Latest News</h2></div>
                    @await Component.InvokeAsync("LatestNews", new { count = 8 })
                </div>
            </aside>
        </div>
    </div>
</div>

<style>
    .bn-site-page-content { white-space: pre-line; }
    .bn-information-page { font-family: var(--bn-font-body); color: var(--bn-text-primary); font-size: 16px; line-height: 1.55; }
    .bn-information-page h1 { font-family: var(--bn-font-body); font-size: 22px; font-weight: 700; margin: 0 0 30px; }
</style>
