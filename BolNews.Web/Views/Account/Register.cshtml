@model RegisterVM

@{
    ViewData["Title"] = "Register";
}

<div style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:40px 16px;background:var(--bn-bg);">
    <div style="
        width:100%;
        max-width:440px;
        background:var(--bn-surface);
        border-radius:var(--bn-radius-lg);
        border:1px solid var(--bn-border);
        box-shadow:var(--bn-shadow-hover);
        overflow:hidden;">

        <!-- Header strip -->
        <div style="background:var(--bn-nav-bg);padding:24px;text-align:center;">
            <a href="/" style="font-family:'Playfair Display',Georgia,serif;font-size:26px;font-weight:800;color:#fff;text-decoration:none;">
                Bol<span style="color:var(--bn-accent);">News</span>
            </a>
        </div>

        <div style="padding:28px 28px 32px;">
            <h2 style="font-family:var(--bn-font-display);font-size:22px;font-weight:700;color:var(--bn-text-primary);margin-bottom:4px;">Create an Account</h2>
            <p style="font-family:var(--bn-font-ui);font-size:13px;color:var(--bn-text-muted);margin-bottom:24px;">Fill in the details below to get started.</p>

            <form asp-action="Register" method="post" novalidate>

                <div style="margin-bottom:16px;">
                    <label asp-for="FullName" style="display:block;font-family:var(--bn-font-ui);font-size:12px;font-weight:600;color:var(--bn-text-body);margin-bottom:5px;"></label>
                    <input asp-for="FullName"
                           placeholder="Enter your full name"
                           style="
                               width:100%;padding:10px 13px;
                               font-family:var(--bn-font-ui);font-size:14px;
                               border:1px solid var(--bn-border);
                               border-radius:var(--bn-radius-sm);
                               background:var(--bn-surface);
                               color:var(--bn-text-primary);
                               outline:none;"
                           onfocus="this.style.borderColor='var(--bn-accent)'"
                           onblur="this.style.borderColor='var(--bn-border)'" />
                    <span asp-validation-for="FullName" style="font-family:var(--bn-font-ui);font-size:11px;color:#dc2626;"></span>
                </div>

                <div style="margin-bottom:16px;">
                    <label asp-for="Email" style="display:block;font-family:var(--bn-font-ui);font-size:12px;font-weight:600;color:var(--bn-text-body);margin-bottom:5px;"></label>
                    <input asp-for="Email"
                           placeholder="name@example.com"
                           style="
                               width:100%;padding:10px 13px;
                               font-family:var(--bn-font-ui);font-size:14px;
                               border:1px solid var(--bn-border);
                               border-radius:var(--bn-radius-sm);
                               background:var(--bn-surface);
                               color:var(--bn-text-primary);
                               outline:none;"
                           onfocus="this.style.borderColor='var(--bn-accent)'"
                           onblur="this.style.borderColor='var(--bn-border)'" />
                    <span asp-validation-for="Email" style="font-family:var(--bn-font-ui);font-size:11px;color:#dc2626;"></span>
                </div>

                <div style="margin-bottom:16px;">
                    <label asp-for="Password" style="display:block;font-family:var(--bn-font-ui);font-size:12px;font-weight:600;color:var(--bn-text-body);margin-bottom:5px;"></label>
                    <input asp-for="Password"
                           type="password"
                           placeholder="Create a password"
                           style="
                               width:100%;padding:10px 13px;
                               font-family:var(--bn-font-ui);font-size:14px;
                               border:1px solid var(--bn-border);
                               border-radius:var(--bn-radius-sm);
                               background:var(--bn-surface);
                               color:var(--bn-text-primary);
                               outline:none;"
                           onfocus="this.style.borderColor='var(--bn-accent)'"
                           onblur="this.style.borderColor='var(--bn-border)'" />
                    <span asp-validation-for="Password" style="font-family:var(--bn-font-ui);font-size:11px;color:#dc2626;"></span>
                </div>

                <div style="margin-bottom:24px;">
                    <label asp-for="ConfirmPassword" style="display:block;font-family:var(--bn-font-ui);font-size:12px;font-weight:600;color:var(--bn-text-body);margin-bottom:5px;"></label>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           placeholder="Repeat your password"
                           style="
                               width:100%;padding:10px 13px;
                               font-family:var(--bn-font-ui);font-size:14px;
                               border:1px solid var(--bn-border);
                               border-radius:var(--bn-radius-sm);
                               background:var(--bn-surface);
                               color:var(--bn-text-primary);
                               outline:none;"
                           onfocus="this.style.borderColor='var(--bn-accent)'"
                           onblur="this.style.borderColor='var(--bn-border)'" />
                    <span asp-validation-for="ConfirmPassword" style="font-family:var(--bn-font-ui);font-size:11px;color:#dc2626;"></span>
                </div>

                <button type="submit"
                        style="
                            width:100%;padding:12px;
                            background:var(--bn-accent);
                            color:#fff;border:none;
                            border-radius:var(--bn-radius-sm);
                            font-family:var(--bn-font-ui);font-size:14px;font-weight:700;
                            cursor:pointer;
                            transition:background 0.2s;"
                        onmouseover="this.style.background='var(--bn-accent-hover)'"
                        onmouseout="this.style.background='var(--bn-accent)'">
                    Create Account
                </button>

                <div asp-validation-summary="ModelOnly"
                     style="font-family:var(--bn-font-ui);font-size:12px;color:#dc2626;margin-top:12px;text-align:center;"></div>

            </form>

            <p style="font-family:var(--bn-font-ui);font-size:13px;color:var(--bn-text-muted);text-align:center;margin-top:22px;margin-bottom:0;">
                Already have an account?
                <a asp-action="Login" style="color:var(--bn-accent);font-weight:600;text-decoration:none;">Login here</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
