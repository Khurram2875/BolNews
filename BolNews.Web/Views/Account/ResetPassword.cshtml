@using BolNews.Web.ViewModels.Account
@model ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
}

<div style="
    min-height:70vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px 16px;
    background:var(--bn-bg);">

    <div style="
        width:100%;
        max-width:460px;
        background:var(--bn-surface);
        border-radius:var(--bn-radius-lg);
        border:1px solid var(--bn-border);
        box-shadow:var(--bn-shadow-hover);
        overflow:hidden;">

        <div style="
            background:var(--bn-nav-bg);
            padding:24px;
            text-align:center;">

            <a href="/"
               style="
                   font-family:'Playfair Display',Georgia,serif;
                   font-size:26px;
                   font-weight:800;
                   color:#fff;
                   text-decoration:none;">
                Bol<span style="color:var(--bn-accent);">News</span>
            </a>
        </div>

        <div style="padding:28px 28px 32px;">

            <h2 style="
                font-family:var(--bn-font-display);
                font-size:22px;
                font-weight:700;
                color:var(--bn-text-primary);
                margin-bottom:4px;">
                Reset Password
            </h2>

            <p style="
                font-family:var(--bn-font-ui);
                font-size:13px;
                color:var(--bn-text-muted);
                margin-bottom:24px;">
                Enter a new password for your account.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div style="
                        margin-bottom:18px;
                        padding:11px 14px;
                        background:#fff5f5;
                        border-radius:var(--bn-radius-sm);
                        border:1px solid #fecaca;
                        font-family:var(--bn-font-ui);
                        font-size:13px;
                        color:#dc2626;">

                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Code" type="hidden" />
                <input asp-for="Email" type="hidden" />


                <!-- New Password -->
                <div style="margin-bottom:16px;">

                    <label asp-for="NewPassword"
                           style="
                               display:block;
                               font-family:var(--bn-font-ui);
                               font-size:12px;
                               font-weight:600;
                               color:var(--bn-text-body);
                               margin-bottom:5px;">
                    </label>

                    <input asp-for="NewPassword"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Enter new password"
                           style="
                               width:100%;
                               padding:10px 13px;
                               font-family:var(--bn-font-ui);
                               font-size:14px;
                               border:1px solid var(--bn-border);
                               border-radius:var(--bn-radius-sm);
                               background:var(--bn-surface);
                               color:var(--bn-text-primary);
                               outline:none;
                               transition:border-color 0.2s;"
                           onfocus="this.style.borderColor='var(--bn-accent)'"
                           onblur="this.style.borderColor='var(--bn-border)'" />

                    <span asp-validation-for="NewPassword"
                          style="
                              display:block;
                              margin-top:4px;
                              font-family:var(--bn-font-ui);
                              font-size:12px;
                              color:#dc2626;">
                    </span>

                </div>


                <!-- Confirm Password -->
                <div style="margin-bottom:22px;">

                    <label asp-for="ConfirmPassword"
                           style="
                               display:block;
                               font-family:var(--bn-font-ui);
                               font-size:12px;
                               font-weight:600;
                               color:var(--bn-text-body);
                               margin-bottom:5px;">
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Confirm new password"
                           style="
                               width:100%;
                               padding:10px 13px;
                               font-family:var(--bn-font-ui);
                               font-size:14px;
                               border:1px solid var(--bn-border);
                               border-radius:var(--bn-radius-sm);
                               background:var(--bn-surface);
                               color:var(--bn-text-primary);
                               outline:none;
                               transition:border-color 0.2s;"
                           onfocus="this.style.borderColor='var(--bn-accent)'"
                           onblur="this.style.borderColor='var(--bn-border)'" />

                    <span asp-validation-for="ConfirmPassword"
                          style="
                              display:block;
                              margin-top:4px;
                              font-family:var(--bn-font-ui);
                              font-size:12px;
                              color:#dc2626;">
                    </span>

                </div>


                <button type="submit"
                        style="
                            width:100%;
                            padding:12px;
                            background:var(--bn-accent);
                            color:#fff;
                            border:none;
                            border-radius:var(--bn-radius-sm);
                            font-family:var(--bn-font-ui);
                            font-size:14px;
                            font-weight:700;
                            cursor:pointer;
                            transition:background 0.2s;"
                        onmouseover="this.style.background='var(--bn-accent-hover)'"
                        onmouseout="this.style.background='var(--bn-accent)'">
                    Reset Password
                </button>

            </form>

            <div style="
                text-align:center;
                margin-top:20px;">

                <a asp-action="Login"
                   style="
                       font-family:var(--bn-font-ui);
                       font-size:12px;
                       color:var(--bn-accent);
                       text-decoration:none;">
                    Back to Login
                </a>

            </div>

        </div>
    </div>
</div>