{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "quill-image-resize-module@3.0.0",
      "destination": "wwwroot/lib/quill-image-resize-module/"
    },
    {
      "library": "quill-image-resize-module-v2@3.0.0",
      "destination": "wwwroot/lib/quill/modules/quill-image-resize-module-v2/",
