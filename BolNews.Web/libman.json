      ]
    },
    {
      "provider": "unpkg",
      "library": "quill@2.0.3",
      "destination": "wwwroot/lib/quill/",
      "files": [
        "dist/quill.js",
        "dist/quill.snow.css"
      ]
    }
  ]
}