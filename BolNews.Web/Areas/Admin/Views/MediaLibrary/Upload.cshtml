@using BolNews.Application.DTOs
@using BolNews.Domain.Enums
@model MediaAssetDto

@{
    ViewData["Title"] = "Upload Media";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Upload Media</h2>

<form asp-action="Upload"
      method="post"
      enctype="multipart/form-data"
      class="card card-body"
      id="mediaUploadForm">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label>File</label>

        <input id="mediaFile"
               name="upload"
               type="file"
               class="form-control"
               required />

        <span class="text-danger">
            @Html.ValidationMessage("upload")
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="MediaType"></label>

        <select asp-for="MediaType"
                asp-items="Html.GetEnumSelectList<MediaType>()"
                class="form-select"
                id="mediaType">
        </select>
    </div>

    <div id="videoThumbnailStatus"
         class="alert alert-info d-none">
        Generating video thumbnail...
    </div>

    <div class="mb-3">
        <label asp-for="Caption"></label>
        <input asp-for="Caption" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AltText"></label>
        <input asp-for="AltText" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Credit"></label>
        <input asp-for="Credit" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Tags (comma separated)</label>
        <input asp-for="TagsInput" class="form-control" />
    </div>

    <!-- Browser-generated video thumbnail -->
    <input type="file"
           id="videoThumbnail"
           name="videoThumbnail"
           hidden />

    <button type="submit"
            class="btn btn-primary"
            id="uploadButton">
        Upload
    </button>
</form>

<script>
    (() => {

        const fileInput = document.getElementById("mediaFile");
        const mediaType = document.getElementById("mediaType");
        const thumbnailInput = document.getElementById("videoThumbnail");
        const status = document.getElementById("videoThumbnailStatus");
        const form = document.getElementById("mediaUploadForm");
        const uploadButton = document.getElementById("uploadButton");

        const videoTypeValue = "@((int)MediaType.Video)";

        fileInput.addEventListener("change", async function () {

            thumbnailInput.value = "";

            if (mediaType.value !== videoTypeValue) {
                status.classList.add("d-none");
                return;
            }

            const file = fileInput.files[0];

            if (!file) {
                status.classList.add("d-none");
                return;
            }

            if (!file.type.startsWith("video/")) {
                return;
            }

            try {
                status.textContent = "Generating video thumbnail...";
                status.classList.remove("d-none");

                uploadButton.disabled = true;

                const thumbnailFile = await generateVideoThumbnail(file);

                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(thumbnailFile);

                thumbnailInput.files = dataTransfer.files;

                status.textContent = "Video thumbnail ready.";
                status.classList.remove("alert-info");
                status.classList.add("alert-success");

            } catch (error) {

                console.error("Video thumbnail generation failed:", error);

                status.textContent =
                    "Could not generate video thumbnail. Please try again.";

                status.classList.remove("alert-info");
                status.classList.add("alert-danger");

            } finally {
                uploadButton.disabled = false;
            }
        });

        mediaType.addEventListener("change", function () {

            thumbnailInput.value = "";

            status.classList.add("d-none");

            if (mediaType.value !== videoTypeValue) {
                return;
            }

            const file = fileInput.files[0];

            if (file) {
                fileInput.dispatchEvent(new Event("change"));
            }
        });

        form.addEventListener("submit", function (event) {

            if (mediaType.value === videoTypeValue &&
                fileInput.files.length > 0 &&
                thumbnailInput.files.length === 0) {

                event.preventDefault();

                alert("Please wait while the video thumbnail is generated.");
            }
        });

            function generateVideoThumbnail(file) {

        return new Promise((resolve, reject) => {

            const video = document.createElement("video");

            video.preload = "metadata";
            video.muted = true;
            video.playsInline = true;

            const objectUrl = URL.createObjectURL(file);

            video.src = objectUrl;

            video.addEventListener("loadedmetadata", async () => {

                try {

                    if (!video.videoWidth || !video.videoHeight) {
                        throw new Error("Could not determine video dimensions.");
                    }

                    if (!video.duration || !isFinite(video.duration)) {
                        throw new Error("Could not determine video duration.");
                    }

                    const canvas = document.createElement("canvas");

                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;

                    const context = canvas.getContext("2d");

                    if (!context) {
                        throw new Error("Canvas is not supported.");
                    }

                    // Sample several positions in the video.
                    const percentages = [0.10, 0.25, 0.50, 0.75];

                    let bestCanvas = null;
                    let bestBrightness = -1;

                    for (const percentage of percentages) {

                        const time = Math.min(
                            video.duration - 0.1,
                            Math.max(0.1, video.duration * percentage)
                        );

                        await seekVideo(video, time);

                        context.clearRect(
                            0,
                            0,
                            canvas.width,
                            canvas.height
                        );

                        context.drawImage(
                            video,
                            0,
                            0,
                            canvas.width,
                            canvas.height
                        );

                        const brightness = calculateBrightness(
                            context,
                            canvas.width,
                            canvas.height
                        );

                        if (brightness > bestBrightness) {

                            bestBrightness = brightness;

                            bestCanvas =
                                document.createElement("canvas");

                            bestCanvas.width = canvas.width;
                            bestCanvas.height = canvas.height;

                            const bestContext =
                                bestCanvas.getContext("2d");

                            bestContext.drawImage(
                                canvas,
                                0,
                                0
                            );
                        }
                    }

                    if (!bestCanvas) {
                        throw new Error(
                            "Could not capture a video frame."
                        );
                    }

                    bestCanvas.toBlob(blob => {

                        if (!blob) {
                            reject(
                                new Error(
                                    "Could not create thumbnail."
                                )
                            );

                            return;
                        }

                        const thumbnail = new File(
                            [blob],
                            "video-thumbnail.jpg",
                            {
                                type: "image/jpeg",
                                lastModified: Date.now()
                            }
                        );

                        URL.revokeObjectURL(objectUrl);

                        resolve(thumbnail);

                    }, "image/jpeg", 0.85);

                } catch (error) {

                    URL.revokeObjectURL(objectUrl);

                    reject(error);
                }
            });

            video.addEventListener("error", () => {

                URL.revokeObjectURL(objectUrl);

                reject(
                    new Error(
                        "The selected video could not be loaded."
                    )
                );
            });

            function seekVideo(videoElement, time) {

                return new Promise((resolve, reject) => {

                    const onSeeked = () => {
                        cleanup();
                        resolve();
                    };

                    const onError = () => {
                        cleanup();
                        reject(
                            new Error("Could not seek video.")
                        );
                    };

                    const cleanup = () => {
                        videoElement.removeEventListener(
                            "seeked",
                            onSeeked
                        );

                        videoElement.removeEventListener(
                            "error",
                            onError
                        );
                    };

                    videoElement.addEventListener(
                        "seeked",
                        onSeeked,
                        { once: true }
                    );

                    videoElement.addEventListener(
                        "error",
                        onError,
                        { once: true }
                    );

                    videoElement.currentTime = time;
                });
            }

            function calculateBrightness(
                context,
                width,
                height) {

                // Sample a smaller version of the frame
                // to keep the calculation lightweight.
                const sampleWidth = 100;
                const sampleHeight = Math.max(
                    1,
                    Math.round(
                        height * (sampleWidth / width)
                    )
                );

                const sampleCanvas =
                    document.createElement("canvas");

                sampleCanvas.width = sampleWidth;
                sampleCanvas.height = sampleHeight;

                const sampleContext =
                    sampleCanvas.getContext("2d");

                sampleContext.drawImage(
                    context.canvas,
                    0,
                    0,
                    sampleWidth,
                    sampleHeight
                );

                const imageData =
                    sampleContext.getImageData(
                        0,
                        0,
                        sampleWidth,
                        sampleHeight
                    );

                const data = imageData.data;

                let totalBrightness = 0;

                for (let i = 0; i < data.length; i += 4) {

                    const r = data[i];
                    const g = data[i + 1];
                    const b = data[i + 2];

                    totalBrightness +=
                        (r * 0.299) +
                        (g * 0.587) +
                        (b * 0.114);
                }

                return totalBrightness /
                    (data.length / 4);
            }
        });
    }

    })();
</script>