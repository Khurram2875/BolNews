@using BolNews.Application.DTOs
@using BolNews.Domain.Enums
@model MediaAssetDto
@{ ViewData["Title"] = "Upload Media"; Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml"; }
<h2>Upload Media</h2><form asp-action="Upload" method="post" enctype="multipart/form-data" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label>File</label><input name="upload" type="file" class="form-control" required /><span class="text-danger">@Html.ValidationMessage("upload")</span></div><div class="mb-3"><label asp-for="MediaType"></label><select asp-for="MediaType" asp-items="Html.GetEnumSelectList<MediaType>()" class="form-select"></select></div><div class="mb-3"><label asp-for="Caption"></label><input asp-for="Caption" class="form-control" /></div><div class="mb-3"><label asp-for="AltText"></label><input asp-for="AltText" class="form-control" /></div><div class="mb-3"><label asp-for="Credit"></label><input asp-for="Credit" class="form-control" /></div><div class="mb-3"><label>Tags (comma separated)</label><input asp-for="TagsInput" class="form-control" /></div><button class="btn btn-primary">Upload</button></form>
