@using BolNews.Application.DTOs
@model MediaAssetDto
@{ ViewData["Title"] = "Edit Media"; Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml"; }
<h2>Edit Media Metadata</h2><form asp-action="Edit" method="post" class="card card-body"><input asp-for="Id" type="hidden" /><input asp-for="MediaType" type="hidden" /><input asp-for="Url" type="hidden" /><div class="mb-3"><label asp-for="Caption"></label><input asp-for="Caption" class="form-control" /></div><div class="mb-3"><label asp-for="AltText"></label><input asp-for="AltText" class="form-control" /></div><div class="mb-3"><label asp-for="Credit"></label><input asp-for="Credit" class="form-control" /></div><div class="mb-3"><label>Tags (comma separated)</label><input asp-for="TagsInput" class="form-control" /></div><button class="btn btn-primary">Save changes</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
