@model BolNews.Domain.Entities.SiteProfile
@{
    ViewData["Title"] = "Publisher Settings";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Publisher Settings</h1>
        <p class="text-muted mb-0">Configure this installation’s name, brand, theme, metadata, and legal page text.</p>
    </div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ErrorMessage"] is string failure) { <div class="alert alert-danger">@failure</div> }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form asp-action="Index" method="post" id="siteSettingsForm">
        @Html.AntiForgeryToken()
        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Publisher identity</div><div class="card-body row g-3">
            <div class="col-md-6"><label asp-for="SiteName" class="form-label">Publisher name</label><input asp-for="SiteName" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="ShortName" class="form-label">Short name</label><input asp-for="ShortName" class="form-control" /></div>
            <div class="col-12"><label asp-for="Tagline" class="form-label"></label><input asp-for="Tagline" class="form-control" /></div>
            <div class="col-md-4">
                <label asp-for="HeaderLogoUrl" class="form-label">Header logo URL/path</label>
                <input asp-for="HeaderLogoUrl" class="form-control" placeholder="/uploads/brand/header-logo.png" />
                <div class="input-group mt-2"><input id="HeaderLogoUpload" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" aria-label="Choose header logo" /><button class="btn btn-outline-secondary" type="button" data-brand-upload="HeaderLogoUrl" data-file-input="HeaderLogoUpload">Upload</button></div>
                <div class="form-text" data-upload-status="HeaderLogoUrl">JPG, PNG, or WEBP; max 2 MB. Save settings after uploading.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="FooterLogoUrl" class="form-label">Footer logo URL/path</label>
                <input asp-for="FooterLogoUrl" class="form-control" placeholder="/uploads/brand/footer-logo.png" />
                <div class="input-group mt-2"><input id="FooterLogoUpload" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" aria-label="Choose footer logo" /><button class="btn btn-outline-secondary" type="button" data-brand-upload="FooterLogoUrl" data-file-input="FooterLogoUpload">Upload</button></div>
                <div class="form-text" data-upload-status="FooterLogoUrl">JPG, PNG, or WEBP; max 2 MB. Save settings after uploading.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="FaviconUrl" class="form-label">Favicon URL/path</label>
                <input asp-for="FaviconUrl" class="form-control" placeholder="/uploads/brand/favicon.ico" />
                <div class="input-group mt-2"><input id="FaviconUpload" type="file" class="form-control" accept=".ico,.jpg,.jpeg,.png,.webp,image/x-icon,image/jpeg,image/png,image/webp" aria-label="Choose favicon" /><button class="btn btn-outline-secondary" type="button" data-brand-upload="FaviconUrl" data-file-input="FaviconUpload">Upload</button></div>
                <div class="form-text" data-upload-status="FaviconUrl">ICO, JPG, PNG, or WEBP; max 2 MB. Save settings after uploading.</div>
            </div>
            <div class="col-md-4"><label asp-for="PrimaryColor" class="form-label">Primary brand color</label><input asp-for="PrimaryColor" type="color" class="form-control form-control-color" /></div>
            <div class="col-md-4"><label asp-for="AccentColor" class="form-label">Accent color</label><input asp-for="AccentColor" type="color" class="form-control form-control-color" /></div>
            <div class="col-md-4"><label asp-for="ThemeName" class="form-label">Color theme</label><select asp-for="ThemeName" class="form-select"><option value="default">Default</option><option value="dark">Dark</option><option value="editorial">Editorial</option><option value="bold">Bold</option></select><div class="form-text">Applies the color palette across public pages and the admin workspace.</div></div>
            <div class="col-md-4"><label asp-for="FontFamily" class="form-label">Site font family</label><select asp-for="FontFamily" class="form-select">
                @foreach (var font in (IEnumerable<string>)ViewBag.FontFamilies) { <option value="@font">@font</option> }
            </select><div class="form-text">Applies to public and admin text. Web fonts are loaded only for the selected family. Any .ttf/.otf/.woff/.woff2 file placed in wwwroot/fonts appears here automatically (file name = font name).</div></div>
            <div class="col-md-4"><label asp-for="BaseFontSizePx" class="form-label">Base text size (px)</label><input asp-for="BaseFontSizePx" type="number" min="12" max="24" step="1" class="form-control" /><span asp-validation-for="BaseFontSizePx" class="text-danger"></span><div class="form-text">Default 16. Scales the whole public site's rem-based text (article pages, live pages, polls, cards that use relative sizes). Parts with fixed pixel sizes keep their size.</div></div>
            <div class="col-md-4"><label asp-for="ArticleFontSizePx" class="form-label">Article body text size (px)</label><input asp-for="ArticleFontSizePx" type="number" min="0" max="40" step="1" class="form-control" /><span asp-validation-for="ArticleFontSizePx" class="text-danger"></span><div class="form-text">0 keeps the theme default. Urdu Nastaliq usually reads best at 20–24 px.</div></div>
            <div class="col-md-4"><label asp-for="LanguageCode" class="form-label">Public site language</label><select asp-for="LanguageCode" class="form-select"><option value="en">English (left-to-right)</option><option value="ur">Urdu (right-to-left)</option></select><div class="form-text">Urdu switches public pages to right-to-left layout with an Urdu font and Urdu labels. The admin area stays left-to-right; article, live event and poll text editors switch to right-to-left.</div></div>
            <div class="col-md-6"><label asp-for="LiveStreamUrl" class="form-label">Live page path</label><input asp-for="LiveStreamUrl" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="LiveVideoEmbedUrl" class="form-label">Live player embed URL</label><input asp-for="LiveVideoEmbedUrl" class="form-control" placeholder="https://www.youtube.com/embed/..." /></div>
            <div class="col-md-6"><label asp-for="LiveThumbnailUrl" class="form-label">Live player thumbnail URL/path</label><input asp-for="LiveThumbnailUrl" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="UrduEditionUrl" class="form-label">Other language edition URL</label><input asp-for="UrduEditionUrl" class="form-control" placeholder="https://..." /></div>
            <div class="col-md-6"><label asp-for="CopyrightText" class="form-label">Copyright text</label><input asp-for="CopyrightText" class="form-control" /></div>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Public navigation categories</div><div class="card-body">
            <p class="text-muted">Home and Latest stay fixed. Choose up to nine parent categories below; their slot numbers set the display order. Leave a slot blank to show fewer categories.</p>
            <div class="row g-3">
                @{
                    var navigationCategories = (IEnumerable<BolNews.Domain.Entities.Category>)ViewBag.NavigationCategories;
                    var navigationOrder = (IEnumerable<int>)ViewBag.NavigationCategoryOrder;
                    var selectedNavigationIds = navigationOrder.ToList();
                }
                @for (var slot = 0; slot < 9; slot++)
                {
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label" for="navigationCategoryOrder_@slot">Position @(slot + 1)</label>
                        <select id="navigationCategoryOrder_@slot" name="navigationCategoryOrder" class="form-select" data-navigation-order>
                            <option value="">— Not selected —</option>
                            @foreach (var category in navigationCategories)
                            {
                                if (selectedNavigationIds.ElementAtOrDefault(slot) == category.Id)
                                {
                                    <option value="@category.Id" selected>@category.Name</option>
                                }
                                else
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                    </div>
                }
            </div>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Footer navigation</div><div class="card-body row g-3">
            <p class="text-muted">Enter one link per line as <code>Label|/path</code>. Use a full HTTPS URL for external sites. Clear a column to hide it.</p>
            <div class="col-md-4"><label asp-for="FooterColumnOneLinks" class="form-label">Column one</label><textarea asp-for="FooterColumnOneLinks" class="form-control" rows="7"></textarea></div>
            <div class="col-md-4"><label asp-for="FooterColumnTwoLinks" class="form-label">Column two</label><textarea asp-for="FooterColumnTwoLinks" class="form-control" rows="7"></textarea></div>
            <div class="col-md-4"><label asp-for="FooterColumnThreeLinks" class="form-label">Column three</label><textarea asp-for="FooterColumnThreeLinks" class="form-control" rows="7"></textarea></div>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Search and advertising integration</div><div class="card-body row g-3">
            <div class="col-md-6"><label asp-for="DefaultMetaTitle" class="form-label"></label><input asp-for="DefaultMetaTitle" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="DefaultMetaDescription" class="form-label"></label><textarea asp-for="DefaultMetaDescription" class="form-control" rows="2"></textarea></div>
            <div class="col-12"><label asp-for="AdScriptUrl" class="form-label">Ad provider script URL</label><input asp-for="AdScriptUrl" class="form-control" placeholder="https://..." /><div class="form-text">Leave blank to disable the provider script. Ad unit div IDs are managed separately under Ad Placements.</div></div>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Style controls</div><div class="card-body">
            <p class="text-muted">Adjust headline and heading looks without writing CSS. Leave a box empty to keep the theme default. Colours use <code>#RRGGBB</code>.</p>
            @{
                var style = BolNews.Domain.Entities.StyleSettings.Normalize(Model.Style);
                var weights = new[] { 100, 200, 300, 400, 500, 600, 700, 800, 900 };
                var elements = new[]
                {
                    (Field: "ArticleHeadline", Label: "Article headline (H1 on article page)", S: style.ArticleHeadline),
                    (Field: "BodyH1", Label: "Heading 1 inside article text", S: style.BodyH1),
                    (Field: "BodyH2", Label: "Heading 2 inside article text", S: style.BodyH2),
                    (Field: "BodyH3", Label: "Heading 3 inside article text", S: style.BodyH3),
                    (Field: "BodyH4", Label: "Heading 4 inside article text", S: style.BodyH4),
                    (Field: "SectionTitle", Label: "Section titles on home/category pages", S: style.SectionTitle)
                };
            }
            <div class="table-responsive"><table class="table table-sm align-middle">
                <thead><tr><th>Element</th><th style="width:110px">Size (px)</th><th style="width:130px">Weight</th><th style="width:150px">Colour</th><th style="width:120px">Line height</th></tr></thead>
                <tbody>
                @foreach (var el in elements)
                {
                    <tr>
                        <td>@el.Label</td>
                        <td><input type="number" min="10" max="80" class="form-control form-control-sm" name="Style.@(el.Field).SizePx" value="@el.S.SizePx" /></td>
                        <td><select class="form-select form-select-sm" name="Style.@(el.Field).Weight">
                            <option value="">Default</option>
                            @foreach (var w in weights) { <option value="@w" selected="@(el.S.Weight == w)">@w</option> }
                        </select></td>
                        <td><div class="input-group input-group-sm">
                            <input type="color" class="form-control form-control-color" value="@(string.IsNullOrWhiteSpace(el.S.Color) ? "#000000" : el.S.Color)" data-color-picker="@el.Field" />
                            <input type="text" class="form-control" maxlength="7" placeholder="default" name="Style.@(el.Field).Color" value="@el.S.Color" data-color-text="@el.Field" />
                        </div></td>
                        <td><input type="number" step="0.05" min="1" max="3.5" class="form-control form-control-sm" name="Style.@(el.Field).LineHeight" value="@(el.S.LineHeight?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" /></td>
                    </tr>
                }
                </tbody>
            </table></div>
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label">Article text line height</label><input type="number" step="0.05" min="1" max="3.5" class="form-control" name="Style.ArticleLineHeight" value="@(style.ArticleLineHeight?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" /></div>
                <div class="col-md-4"><label class="form-label">Article link colour</label><input type="text" class="form-control" maxlength="7" placeholder="default" name="Style.ArticleLinkColor" value="@style.ArticleLinkColor" /></div>
                <div class="col-md-4"><label class="form-label">Corner roundness (px, 0–32)</label><input type="number" min="0" max="32" class="form-control" name="Style.CornerRadiusPx" value="@style.CornerRadiusPx" /><div class="form-text">Cards, buttons and images. Empty keeps the theme default.</div></div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-4"><label class="form-label">Read-aloud highlight colour</label><div class="input-group">
                    <input type="color" class="form-control form-control-color" value="@(string.IsNullOrWhiteSpace(style.ReadAloudHighlightColor) ? "#FFC800" : style.ReadAloudHighlightColor)" data-color-picker="ReadAloud" />
                    <input type="text" class="form-control" maxlength="7" placeholder="default (yellow)" name="Style.ReadAloudHighlightColor" value="@style.ReadAloudHighlightColor" data-color-text="ReadAloud" /></div>
                    <div class="form-text">Colour of the sentence highlighted while an article is read aloud.</div></div>
                <div class="col-md-8 d-flex align-items-end"><div class="form-check mb-2">@Html.CheckBox("Style.ReadAloudAutoScroll", style.ReadAloudAutoScroll, new { @class = "form-check-input", id = "ra_scroll" })<label class="form-check-label" for="ra_scroll">Scroll the page to follow the sentence being read aloud</label></div></div>
            </div>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Home page layout</div><div class="card-body">
            @{
                var hl = Model.HomeLayout;
                var homeCategories = ((IEnumerable<BolNews.Domain.Entities.Category>)ViewBag.NavigationCategories).ToList();
                var defaultSlugs = BolNews.Domain.Entities.HomeLayoutSettings.DefaultCategorySlugs.ToList();
                var catRows = homeCategories
                    .Select(c =>
                    {
                        var saved = hl.Categories.FirstOrDefault(r => string.Equals(r.Slug, c.Slug, StringComparison.OrdinalIgnoreCase));
                        var defaultIndex = defaultSlugs.FindIndex(x => string.Equals(x, c.Slug, StringComparison.OrdinalIgnoreCase));
                        return new
                        {
                            c.Slug, c.Name,
                            Enabled = hl.CategoriesCustomized ? saved?.Enabled ?? false : defaultIndex >= 0,
                            Count = saved?.Count ?? 4,
                            Order = hl.CategoriesCustomized ? saved?.Order ?? 100 : (defaultIndex >= 0 ? defaultIndex + 1 : 100)
                        };
                    })
                    .OrderBy(r => r.Order).ThenBy(r => r.Name)
                    .ToList();
            }
            <p class="text-muted">Choose which blocks appear on the home page, how many stories each holds, the column order, and where the poll and live events cards go. <strong>Pinned stories always show first</strong> and are never removed by these counts. Use <em>Preview unsaved changes</em> to check the result before saving.</p>
            <div class="row g-3">
                <div class="col-lg-4"><div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-2">Latest rail</div>
                    <div class="form-check mb-2">@Html.CheckBox("HomeLayout.LatestEnabled", hl.LatestEnabled, new { @class = "form-check-input", id = "hl_latest" })<label class="form-check-label" for="hl_latest">Show Latest rail</label></div>
                    <label class="form-label small mb-1" for="hl_latest_count">Stories (1–20)</label>
                    <input id="hl_latest_count" type="number" min="1" max="20" class="form-control form-control-sm" name="HomeLayout.LatestCount" value="@hl.LatestCount" />
                </div></div>
                <div class="col-lg-4"><div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-2">Top stories panel</div>
                    <div class="small text-muted mb-2">The main top story is always shown.</div>
                    <label class="form-label small mb-1" for="hl_top_count">Extra story cards under it (0–6)</label>
                    <input id="hl_top_count" type="number" min="0" max="6" class="form-control form-control-sm mb-2" name="HomeLayout.TopCardCount" value="@hl.TopCardCount" />
                    <div class="form-check mb-2">@Html.CheckBox("HomeLayout.ShowTrending", hl.ShowTrending, new { @class = "form-check-input", id = "hl_trending" })<label class="form-check-label" for="hl_trending">Show trending list</label></div>
                    <label class="form-label small mb-1" for="hl_trending_count">Trending stories (3–10)</label>
                    <input id="hl_trending_count" type="number" min="3" max="10" class="form-control form-control-sm" name="HomeLayout.TrendingCount" value="@hl.TrendingCount" />
                </div></div>
                <div class="col-lg-4"><div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-2">Featured rail</div>
                    <div class="form-check">@Html.CheckBox("HomeLayout.FeaturedEnabled", hl.FeaturedEnabled, new { @class = "form-check-input", id = "hl_featured" })<label class="form-check-label" for="hl_featured">Show Featured rail</label></div>
                    <div class="form-check mb-2">@Html.CheckBox("HomeLayout.ShowShows", hl.ShowShows, new { @class = "form-check-input", id = "hl_shows" })<label class="form-check-label" for="hl_shows">Show Shows carousel</label></div>
                    <label class="form-label small mb-1" for="hl_featured_count">Stories (1–15)</label>
                    <input id="hl_featured_count" type="number" min="1" max="15" class="form-control form-control-sm" name="HomeLayout.FeaturedCount" value="@hl.FeaturedCount" />
                </div></div>
            </div>
            @{
                var orders = new (string Value, string Label)[]
                {
                    ("latest,top,featured", "Latest  |  Top stories  |  Featured (default)"),
                    ("featured,top,latest", "Featured  |  Top stories  |  Latest"),
                    ("top,latest,featured", "Top stories  |  Latest  |  Featured"),
                    ("top,featured,latest", "Top stories  |  Featured  |  Latest"),
                    ("latest,featured,top", "Latest  |  Featured  |  Top stories"),
                    ("featured,latest,top", "Featured  |  Latest  |  Top stories")
                };
                var placements = new (string Value, string Label)[]
                {
                    ("latest-top", "Top of the Latest column"),
                    ("latest-bottom", "Bottom of the Latest column"),
                    ("featured-top", "Top of the Featured column"),
                    ("featured-bottom", "Bottom of the Featured column"),
                    ("hidden", "Hidden")
                };
            }
            <div class="row g-3 mt-1">
                <div class="col-lg-4">
                    <label class="form-label fw-semibold" for="hl_order">Column order (start side first)</label>
                    <select id="hl_order" name="HomeLayout.ColumnOrder" class="form-select">
                        @foreach (var o in orders) { <option value="@o.Value" selected="@(hl.ColumnOrder == o.Value)">@o.Label</option> }
                    </select>
                    <div class="form-text">The first column is on the left in English and on the right in Urdu. A switched-off column leaves a gap-free layout.</div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label fw-semibold" for="hl_poll_place">Poll card position</label>
                    <select id="hl_poll_place" name="HomeLayout.PollPlacement" class="form-select">
                        @foreach (var o in placements) { <option value="@o.Value" selected="@(hl.PollPlacement == o.Value)">@o.Label</option> }
                    </select>
                </div>
                <div class="col-lg-4">
                    <label class="form-label fw-semibold" for="hl_live_place">Live events card position</label>
                    <select id="hl_live_place" name="HomeLayout.LivePlacement" class="form-select">
                        @foreach (var o in placements) { <option value="@o.Value" selected="@(hl.LivePlacement == o.Value)">@o.Label</option> }
                    </select>
                    <div class="form-text">A card in a column that is switched off is not shown.</div>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-lg-4">
                    <label class="form-label fw-semibold" for="hl_side_w">Side column width, desktop (px)</label>
                    <input id="hl_side_w" type="number" min="220" max="420" step="2" class="form-control" name="HomeLayout.SideColumnWidth" value="@hl.SideColumnWidth" />
                    <div class="form-text">Width of the Latest and Featured columns on screens 1200px and wider. Default 292, allowed 220 to 420. The Top stories column takes the rest.</div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label fw-semibold" for="hl_side_w_md">Side column width, small desktop (px)</label>
                    <input id="hl_side_w_md" type="number" min="180" max="340" step="2" class="form-control" name="HomeLayout.SideColumnWidthMd" value="@hl.SideColumnWidthMd" />
                    <div class="form-text">Used between 992px and 1199px wide. Default 245, allowed 180 to 340. Below 992px the columns stack.</div>
                </div>
            </div>

            <hr />
            <div class="form-check mb-2">@Html.CheckBox("HomeLayout.CategoriesEnabled", hl.CategoriesEnabled, new { @class = "form-check-input", id = "hl_cats" })<label class="form-check-label fw-semibold" for="hl_cats">Show category columns below the top stories</label></div>
            <p class="text-muted small">Tick the categories to show, set how many stories each column lists (1–5) and its position (lowest number first; unticked categories can keep 100). The first save of this section replaces the built-in default list (Pakistan, World, Business, Sports, Entertainment, Technology, Health, Lifestyle).</p>
            <div class="table-responsive"><table class="table table-sm align-middle" style="max-width:640px">
                <thead><tr><th style="width:70px">Show</th><th>Category</th><th style="width:110px">Stories</th><th style="width:110px">Position</th></tr></thead>
                <tbody>
                @for (var i = 0; i < catRows.Count; i++)
                {
                    var row = catRows[i];
                    <tr>
                        <td>@Html.CheckBox($"HomeLayout.Categories[{i}].Enabled", row.Enabled, new { @class = "form-check-input" })</td>
                        <td>@row.Name<input type="hidden" name="HomeLayout.Categories[@i].Slug" value="@row.Slug" /></td>
                        <td><input type="number" min="1" max="5" class="form-control form-control-sm" name="HomeLayout.Categories[@i].Count" value="@row.Count" /></td>
                        <td><input type="number" min="1" max="99" class="form-control form-control-sm" name="HomeLayout.Categories[@i].Order" value="@row.Order" /></td>
                    </tr>
                }
                </tbody>
            </table></div>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Article read-aloud voice</div><div class="card-body">
            @{
                var tts = Model.Tts;
                var ttsProviders = ViewBag.TtsProviders as List<BolNews.Web.Services.Tts.ITtsProvider> ?? new();
                var langCode = Model.LanguageCode == "ur" ? "ur" : "en";
                long ttsUsed = ViewBag.TtsUsed is long u ? u : 0;
            }
            @if (tts.IsConfigured)
            {
                <div class="alert alert-success py-2">Provider audio is <strong>active</strong>: visitors hear the audio below, created once per article and reused until the article text changes. Browser voices are used only if the provider fails.</div>
            }
            else
            {
                <div class="alert alert-secondary py-2">No provider is active, so article read-aloud uses the visitor's <strong>browser voices</strong> (free; quality and Urdu availability depend on the visitor's device).</div>
            }
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="tts_provider">Provider</label>
                    <select id="tts_provider" name="Tts.Provider" class="form-select">
                        <option value="" selected="@(tts.Provider == "")">None — use browser voices</option>
                        @foreach (var p in ttsProviders) { <option value="@p.Id" selected="@(tts.Provider == p.Id)" data-needs-region="@(p.NeedsRegion ? "1" : "0")" data-model="@p.DefaultModel" data-voice-help="@p.VoiceHelp" data-key-help="@p.KeyHelp" data-default-voice="@p.DefaultVoice(langCode)">@p.Label</option> }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="tts_key">API key</label>
                    <input id="tts_key" type="password" name="Tts.NewApiKey" class="form-control" autocomplete="new-password" placeholder="@(tts.HasApiKey ? "A key is saved (hidden). Type a new one to replace it." : "Paste the provider API key")" />
                    <div class="form-text" id="tts_key_help">The key is stored encrypted and is never shown again.</div>
                    @if (tts.HasApiKey)
                    {
                        <div class="form-check mt-1">@Html.CheckBox("Tts.ClearApiKey", false, new { @class = "form-check-input", id = "tts_clear" })<label class="form-check-label" for="tts_clear">Remove the saved key</label></div>
                    }
                </div>
                <div class="col-md-4" id="tts_region_wrap">
                    <label class="form-label" for="tts_region">Region</label>
                    <input id="tts_region" name="Tts.Region" class="form-control" value="@tts.Region" placeholder="e.g. southeastasia" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="tts_voice">Voice</label>
                    <input id="tts_voice" name="Tts.Voice" class="form-control" value="@tts.Voice" />
                    <div class="form-text" id="tts_voice_help"></div>
                </div>
                <div class="col-md-4" id="tts_model_wrap">
                    <label class="form-label" for="tts_model">Model</label>
                    <input id="tts_model" name="Tts.Model" class="form-control" value="@tts.Model" />
                    <div class="form-text">Empty = provider default. For Urdu on ElevenLabs use a model that lists Urdu (eleven_v4).</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="tts_limit">Monthly character limit</label>
                    <input id="tts_limit" type="number" min="0" class="form-control" name="Tts.MonthlyCharacterLimit" value="@tts.MonthlyCharacterLimit" />
                    <div class="form-text">0 = no limit. Used this month: @ttsUsed.ToString("N0") characters. When the limit is reached, new articles fall back to browser voices.</div>
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="tts_test" @(tts.IsConfigured ? "" : "disabled")>Test saved voice</button>
                <audio id="tts_test_audio" controls hidden></audio>
                <span class="small" id="tts_test_msg" role="status"></span>
            </div>
            <p class="text-muted small mt-2 mb-0">Audio is created the first time someone listens to an article (not before), saved on this server under <code>uploads/audio</code>, and recreated only after the article text or voice changes. Save the settings before using Test.</p>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Custom HTML blocks</div><div class="card-body">
            <p class="text-muted">Add your own content (promo banners, notices, newsletter links, partner logos) in fixed places on the site. Allowed: paragraphs, headings, bold/italic/underline, lists, links, images, quotes, line breaks and text/background colour. For safety, scripts, iframes/embeds, forms, buttons and custom CSS classes or layout styles are removed when you save. Use <em>Preview unsaved changes</em> to see the result; saved blocks show your cleaned version.</p>
            @foreach (var slot in BolNews.Domain.Entities.CustomBlocks.Slots)
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="Blocks_@slot.Key">@slot.Label <span class="text-muted fw-normal">— @slot.Where</span></label>
                    <textarea id="Blocks_@slot.Key" name="Blocks.@slot.Key" class="form-control font-monospace" rows="4" maxlength="20000" placeholder="&lt;p&gt;&lt;strong&gt;Subscribe&lt;/strong&gt; to our &lt;a href=&quot;/newsletter&quot;&gt;newsletter&lt;/a&gt;&lt;/p&gt;">@Model.Blocks.Get(slot.Key)</textarea>
                </div>
            }
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Custom frontend styles</div><div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="form-check mb-0">@Html.CheckBox("Style.CustomCssEnabled", Model.Style.CustomCssEnabled, new { @class = "form-check-input", id = "css_enabled" })<label class="form-check-label" for="css_enabled">Apply this CSS to the public site</label></div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="bnCssPreview">Preview unsaved CSS</button>
            </div>
            <div class="row g-3">
                <div class="col-lg-8">
                    <label asp-for="CustomCss" class="form-label">Additional CSS</label>
                    <div id="bnCssEditorHost"></div>
                    <textarea asp-for="CustomCss" class="form-control font-monospace" rows="14" placeholder=".bn-brand-logo img { max-height: 70px; }"></textarea>
                    <div class="d-flex justify-content-between small text-muted mt-1"><span>Red marks show errors; yellow marks show unknown site classes. Press Ctrl+Space for suggestions.</span><span id="bnCssCount"></span></div>
                    <span asp-validation-for="CustomCss" class="text-danger small"></span>
                </div>
                <div class="col-lg-4">
                    <div class="btn-group btn-group-sm w-100 mb-2" role="group" aria-label="Reference">
                        <button type="button" class="btn btn-outline-secondary active" data-css-tab="snippets">Snippets</button>
                        <button type="button" class="btn btn-outline-secondary" data-css-tab="classes">Classes</button>
                        <button type="button" class="btn btn-outline-secondary" data-css-tab="variables">Variables</button>
                    </div>
                    <input type="search" id="bnCssSearch" class="form-control form-control-sm mb-2" placeholder="Search" autocomplete="off" />
                    <div id="bnCssList" class="bn-css-list"></div>
                </div>
            </div>
            <div class="form-text mt-2">CSS is applied across the public site after the built-in theme styles. Scripts, <code>@@import</code> and HTML are not allowed. If a rule ever breaks the site, add <code>?nocss=1</code> to any public page address to see it without custom CSS, or untick the box above. Earlier CSS is kept in Style version history.</div>
            <style>
                .bn-css-list{max-height:420px;overflow:auto;border:1px solid var(--bs-border-color,#dee2e6);border-radius:6px}
                .bn-css-item{padding:8px 10px;border-bottom:1px solid var(--bs-border-color,#dee2e6)}
                .bn-css-item:last-child{border-bottom:0}
                .bn-css-code{margin:6px 0 0;padding:6px 8px;background:#f4f5f7;border-radius:4px;font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere}
            </style>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Social links</div><div class="card-body row g-3">
            <div class="col-md-4"><label asp-for="FacebookUrl" class="form-label"></label><input asp-for="FacebookUrl" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="XUrl" class="form-label">X URL</label><input asp-for="XUrl" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="YouTubeUrl" class="form-label"></label><input asp-for="YouTubeUrl" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="InstagramUrl" class="form-label"></label><input asp-for="InstagramUrl" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="TikTokUrl" class="form-label"></label><input asp-for="TikTokUrl" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="WhatsAppUrl" class="form-label"></label><input asp-for="WhatsAppUrl" class="form-control" /></div>
        </div></div>

        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">About, contact, and legal pages</div><div class="card-body">
            <p class="text-muted">Content is plain text and displayed safely. Add your organization’s own information and policies; blank pages will show a setup notice.</p>
            @foreach (var field in new[] {
                (Name: nameof(Model.AboutContent), Label: "About Us", Value: Model.AboutContent),
                (Name: nameof(Model.ContactContent), Label: "Contact Us", Value: Model.ContactContent),
                (Name: nameof(Model.AdvertiseContent), Label: "Advertise", Value: Model.AdvertiseContent),
                (Name: nameof(Model.BlogsContent), Label: "Blogs", Value: Model.BlogsContent),
                (Name: nameof(Model.BrandedContent), Label: "Branded Content", Value: Model.BrandedContent),
                (Name: nameof(Model.EditorialPolicyContent), Label: "Editorial Policy", Value: Model.EditorialPolicyContent),
                (Name: nameof(Model.PrivacyPolicyContent), Label: "Privacy Policy", Value: Model.PrivacyPolicyContent),
                (Name: nameof(Model.TermsOfServiceContent), Label: "Terms of Service", Value: Model.TermsOfServiceContent)
            })
            {
                <div class="mb-3"><label for="@field.Name" class="form-label">@field.Label</label><textarea id="@field.Name" name="@field.Name" class="form-control" rows="4">@field.Value</textarea></div>
            }
        </div></div>
        <button class="btn btn-danger" type="submit">Save publisher settings</button>
        <button class="btn btn-outline-secondary ms-2" type="submit" formaction="@Url.Action("Preview", "SiteSettings", new { area = "Admin" })" formtarget="bnPreviewFrame" formnovalidate onclick="bnShowPreview()">Preview unsaved changes</button>
    </form>

    <div class="card shadow-sm mb-4" id="bnPreviewCard" style="display:none"><div class="card-header fw-semibold d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span>Live preview <span class="text-muted fw-normal">(unsaved — nothing is published until you click Save)</span></span>
        <span class="d-flex gap-2 align-items-center">
            <label class="small text-muted mb-0" for="previewPathInput">Page</label>
            <input id="previewPathInput" form="siteSettingsForm" name="previewPath" class="form-control form-control-sm" style="width:260px" value="/" placeholder="/ or /category-slug or /article-url" />
            <div class="btn-group btn-group-sm" role="group" aria-label="Preview width">
                <button type="button" class="btn btn-outline-secondary" data-preview-width="100%">Desktop</button>
                <button type="button" class="btn btn-outline-secondary" data-preview-width="768px">Tablet</button>
                <button type="button" class="btn btn-outline-secondary" data-preview-width="390px">Phone</button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="bnPickToggle" title="Click elements in the preview to restyle them">Pick element</button>
            <a class="btn btn-sm btn-outline-danger" asp-action="StopPreview">End preview</a>
        </span>
    </div><div class="card-body p-0 bg-light d-flex align-items-stretch">
        <div class="text-center" style="flex:1;min-width:0">
            <iframe name="bnPreviewFrame" id="bnPreviewFrame" title="Site preview" style="width:100%;height:720px;border:0;background:#fff;margin:0 auto;display:block"></iframe>
        </div>
        <div id="bnPickPanel" class="border-start bg-white p-3" style="display:none;width:330px;flex:0 0 330px;max-height:720px;overflow:auto"></div>
    </div></div>

    @{ var versions = ViewBag.Versions as List<BolNews.Domain.Entities.SiteProfileVersion> ?? new(); }
    <div class="card shadow-sm mb-4 mt-4"><div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <span>Style version history <span class="text-muted fw-normal">(last 20 saves)</span></span>
        <form asp-action="ResetStyle" method="post" onsubmit="return confirm('Reset style controls, custom CSS and text sizes to the theme defaults? You can still restore the previous state from this list.');">
            <button class="btn btn-sm btn-outline-danger" type="submit">Reset style to default</button>
        </form>
    </div><div class="card-body p-0">
        @if (versions.Count == 0)
        {
            <p class="text-muted p-3 mb-0">No versions yet. A version is recorded each time you save and something style-related changed.</p>
        }
        else
        {
            <table class="table table-sm mb-0 align-middle">
                <thead><tr><th>#</th><th>When (UTC)</th><th>By</th><th>Note</th><th>Contents</th><th></th></tr></thead>
                <tbody>
                @foreach (var v in versions)
                {
                    BolNews.Domain.Entities.SiteProfileStyleSnapshot? snap = null;
                    try { snap = System.Text.Json.JsonSerializer.Deserialize<BolNews.Domain.Entities.SiteProfileStyleSnapshot>(v.SnapshotJson); } catch (System.Text.Json.JsonException) { }
                    <tr>
                        <td>@v.Id</td>
                        <td>@v.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@v.CreatedBy</td>
                        <td>@v.Note</td>
                        <td class="small text-muted">
                            @if (snap is not null)
                            {
                                <span>@snap.ThemeName, @snap.FontFamily, @snap.PrimaryColor, base @(snap.BaseFontSizePx)px</span>
                                @if (!string.IsNullOrWhiteSpace(snap.StyleSettingsJson) && snap.StyleSettingsJson != "{}") { <span> · style controls</span> }
                                @if (!string.IsNullOrWhiteSpace(snap.CustomCss)) { <span> · custom CSS (@snap.CustomCss.Length chars)</span> }
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="RestoreVersion" asp-route-id="@v.Id" method="post" onsubmit="return confirm('Restore version #@(v.Id)? Current style settings will be replaced (and kept in history).');">
                                <button class="btn btn-sm btn-outline-primary" type="submit">Restore</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div></div>
</div>

@section Scripts {
    <script src="~/lib/bn-css-editor/bn-css-editor.js" asp-append-version="true"></script>
    <script src="~/js/admin/css-catalog-classes.js" asp-append-version="true"></script>
    <script src="~/js/admin/css-catalog.js" asp-append-version="true"></script>
    <script src="~/js/admin/css-editor-init.js" asp-append-version="true"></script>
    <script src="~/js/admin/css-visual-editor.js" asp-append-version="true"></script>
    <script>
        (function () {
            const sel = document.getElementById('tts_provider');
            if (!sel) return;
            function sync() {
                const o = sel.options[sel.selectedIndex];
                const on = !!sel.value;
                document.getElementById('tts_region_wrap').style.display = on && o.dataset.needsRegion === '1' ? '' : 'none';
                document.getElementById('tts_model_wrap').style.display = on && o.dataset.model ? '' : 'none';
                document.getElementById('tts_key_help').textContent = (o.dataset.keyHelp || '') + ' The key is stored encrypted and is never shown again.';
                const v = document.getElementById('tts_voice');
                v.placeholder = o.dataset.defaultVoice || 'required';
                document.getElementById('tts_voice_help').textContent = o.dataset.voiceHelp || '';
            }
            sel.addEventListener('change', sync); sync();

            const btn = document.getElementById('tts_test');
            btn.addEventListener('click', async () => {
                const msg = document.getElementById('tts_test_msg'), audio = document.getElementById('tts_test_audio');
                msg.textContent = 'Contacting provider…'; msg.className = 'small text-muted'; btn.disabled = true;
                try {
                    const res = await fetch('@Url.Action("TestVoice", "SiteSettings", new { area = "Admin" })', { credentials: 'same-origin' });
                    if (!res.ok) throw new Error(await res.text());
                    audio.src = URL.createObjectURL(await res.blob()); audio.hidden = false; await audio.play();
                    msg.textContent = 'Voice works.'; msg.className = 'small text-success';
                } catch (e) {
                    msg.textContent = e.message || 'Test failed.'; msg.className = 'small text-danger';
                } finally { btn.disabled = false; }
            });
        })();
    </script>
    <script>
        function bnShowPreview() {
            document.getElementById('bnPreviewCard').style.display = '';
            setTimeout(() => document.getElementById('bnPreviewCard').scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
        }
        document.querySelectorAll('[data-preview-width]').forEach(b => b.addEventListener('click', () => {
            document.getElementById('bnPreviewFrame').style.width = b.dataset.previewWidth;
        }));
    </script>
    <script>
        document.querySelectorAll('[data-color-picker]').forEach(p => {
            const t = document.querySelector('[data-color-text="' + p.dataset.colorPicker + '"]');
            p.addEventListener('input', () => { t.value = p.value; });
        });
    </script>
    <script>
        (() => {
            const categorySlots = [...document.querySelectorAll('[data-navigation-order]')];
            const updateCategoryOptions = () => {
                const selected = new Set(categorySlots.map(select => select.value).filter(Boolean));
                categorySlots.forEach(select => [...select.options].forEach(option => {
                    option.disabled = option.value !== '' && selected.has(option.value) && select.value !== option.value;
                }));
            };
            categorySlots.forEach(select => select.addEventListener('change', updateCategoryOptions));
            updateCategoryOptions();

            const token = document.querySelector('meta[name="request-verification-token"]')?.content;
            const uploadUrl = '@Url.Action("UploadBrandAsset", "SiteSettings", new { area = "Admin" })';
            document.querySelectorAll('[data-brand-upload]').forEach(button => {
                button.addEventListener('click', async () => {
                    const target = button.dataset.brandUpload;
                    const fileInput = document.getElementById(button.dataset.fileInput);
                    const status = document.querySelector(`[data-upload-status="${target}"]`);
                    const file = fileInput.files[0];
                    if (!file) { status.textContent = 'Choose a file first.'; status.className = 'form-text text-danger'; return; }

                    const form = new FormData();
                    form.append('upload', file);
                    form.append('target', target);
                    button.disabled = true;
                    status.textContent = 'Uploading…';
                    status.className = 'form-text text-muted';
                    try {
                        const response = await fetch(uploadUrl, { method: 'POST', headers: { 'RequestVerificationToken': token }, body: form });
                        const result = await response.json();
                        if (!response.ok) throw new Error(result.error || 'Upload failed.');
                        document.getElementById(target).value = result.path;
                        fileInput.value = '';
                        status.textContent = 'Uploaded. Save publisher settings to apply this path.';
                        status.className = 'form-text text-success';
                    } catch (error) {
                        status.textContent = error.message || 'Upload failed.';
                        status.className = 'form-text text-danger';
                    } finally { button.disabled = false; }
                });
            });
        })();
    </script>
}
