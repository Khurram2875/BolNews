@using BolNews.Web.Areas.Admin.ViewModels
@using System.Linq
@model DashboardVM
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="card border-0 p-3 shadow-sm mb-4">
        <form method="get" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="@Model.FromDate" class="form-label fw-semibold">From Date</label>
                <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="@Model.ToDate" class="form-label fw-semibold">To Date</label>
                <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i> Apply Date Range
                </button>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                    Reset (7 Days)
                </a>
            </div>
        </form>
        <div class="small text-muted mt-2">
            Reporting range: <strong>@Model.FromDate.ToString("dd MMM yyyy")</strong> to <strong>@Model.ToDate.ToString("dd MMM yyyy")</strong>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Analytics Overview</h2>
        <div class="text-muted">Top Editor: <span class="badge bg-success fs-6">🏆 @ViewBag.TopEditor</span></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card stat-card bg-primary border-0 p-3 text-white shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Articles in Range</h6>
                        <h3>@Model.TotalArticles</h3>
                    </div>
                    <i class="bi bi-journal-text fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card stat-card bg-info border-0 p-3 text-white shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Today's Posts</h6>
                        <h3>@Model.ArticlesToday</h3>
                    </div>
                    <i class="bi bi-megaphone fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card stat-card bg-success border-0 p-3 text-white shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Total Published</h6>
                        <h3>@Model.TotalPublishedArticles</h3>
                    </div>
                    <i class="bi bi-check2-circle fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 border-0 p-3 shadow-sm">
                <h6 class="text-muted mb-2">🔥 Trending Topics | Source</h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var t in Model.TrendingTopics)
                    {
                        <span class="badge rounded-pill bg-light text-dark border">@t.Topic (@t.Score) | @t.Source </span>
                       
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card h-100 border-0 p-4 shadow-sm">
                <h5 class="card-title mb-4">📈 Articles Published</h5>
                <canvas id="articlesChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 border-0 p-4 shadow-sm">
                <h5 class="card-title text-danger mb-3">⚠ Needs Attention</h5>
                <div class="list-group list-group-flush">
                    @foreach (var a in Model.LowPerformingArticles)
                    {
                        <div class="list-group-item d-flex align-items-center border-0 px-0">
                            <i class="bi bi-arrow-down-circle text-danger me-2"></i>
                            <span class="text-truncate small">@a.Title</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 p-4 shadow-sm">
                <h5>📊 Category Performance</h5>
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 p-4 shadow-sm">
                <h5>🔥 Top Articles</h5>
                <div style="min-height: 400px; position: relative;">
                    <canvas id="topArticlesChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 p-4 shadow-sm">
        <h5 class="mb-4">👨‍💻 Editor Performance</h5>
        <div class="table-responsive">
            <table class="table-hover table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Editor</th>
                        <th>Articles</th>
                        <th>Total Views</th>
                        <th>Avg Views</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.EditorPerformance)
                    {
                        <tr>
                            <td class="fw-bold">@e.AuthorName</td>
                            <td><span class="badge bg-secondary">@e.ArticleCount</span></td>
                            <td>@e.TotalViews.ToString("N0")</td>
                            <td><span class="text-primary fw-bold">@Math.Round(e.AvgViewsPerArticle)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <canvas id="editorChart" class="mt-4" style="max-height: 250px;"></canvas>
    </div>
</div>
