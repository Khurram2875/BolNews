@using BolNews.Web.Areas.Admin.ViewModels
@using System.Linq
@model DashboardVM
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Analytics Overview</h2>
        <div class="text-muted">Top Editor: <span class="badge bg-success fs-6">🏆 @ViewBag.TopEditor</span></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card stat-card bg-primary border-0 p-3 text-white shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Total Articles</h6>
                        <h3>@Model.TotalArticles</h3>
                    </div>
                    <i class="bi bi-journal-text fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card stat-card bg-info border-0 p-3 text-white shadow-sm">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Today's Posts</h6>
                        <h3>@Model.ArticlesToday</h3>
                    </div>
                    <i class="bi bi-megaphone fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100 border-0 p-3 shadow-sm">
                <h6 class="text-muted mb-2">🔥 Trending Topics</h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var t in Model.TrendingTopics)
                    {
                        <span class="badge rounded-pill bg-light text-dark border">@t.Topic (@t.Score)</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card h-100 border-0 p-4 shadow-sm">
                <h5 class="card-title mb-4">📈 Articles Published</h5>
                <canvas id="articlesChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 border-0 p-4 shadow-sm">
                <h5 class="card-title text-danger mb-3">⚠ Needs Attention</h5>
                <div class="list-group list-group-flush">
                    @foreach (var a in Model.LowPerformingArticles)
                    {
                        <div class="list-group-item d-flex align-items-center border-0 px-0">
                            <i class="bi bi-arrow-down-circle text-danger me-2"></i>
                            <span class="text-truncate small">@a.Title</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 p-4 shadow-sm">
                <h5>📊 Category Performance</h5>
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 p-4 shadow-sm">
                <h5>🔥 Top Articles</h5>
                <div style="min-height: 400px; position: relative;">
                    <canvas id="topArticlesChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 p-4 shadow-sm">
        <h5 class="mb-4">👨‍💻 Editor Performance</h5>
        <div class="table-responsive">
            <table class="table-hover table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Editor</th>
                        <th>Articles</th>
                        <th>Total Views</th>
                        <th>Avg Views</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.EditorPerformance)
                    {
                        <tr>
                            <td class="fw-bold">@e.AuthorName</td>
                            <td><span class="badge bg-secondary">@e.ArticleCount</span></td>
                            <td>@e.TotalViews.ToString("N0")</td>
                            <td><span class="text-primary fw-bold">@Math.Round(e.AvgViewsPerArticle)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <canvas id="editorChart" class="mt-4" style="max-height: 250px;"></canvas>
    </div>
</div>
