<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100 border-0 p-4 shadow-sm">
            <h5 class="mb-3">🔥 Top Performing Articles</h5>
            <div class="dashboard-chart dashboard-chart-tall">
                <canvas id="topChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 border-0 p-4 shadow-sm">
            <h5 class="mb-3">⚠️ Underperforming Articles</h5>
            <div class="dashboard-chart dashboard-chart-tall">
                <canvas id="worstChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card border-0 p-4 shadow-sm">
            <h5 class="mb-3">📊 Clicks vs Impressions</h5>
            <div class="dashboard-chart dashboard-chart-comparison">
                <canvas id="comparisonChart"></canvas>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card {
        transition: transform 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .card {
        border-radius: 15px !important;
    }

    .table thead th {
        border: none;
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #6c757d;
    }

    canvas {
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-chart {
        position: relative;
        width: 100%;
        max-width: 100%;
        overflow: hidden;
    }

    .dashboard-chart-tall {
        height: 420px;
    }

    .dashboard-chart-comparison {
        height: 520px;
    }

    .dashboard-chart canvas {
        display: block;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // 1. Global Configuration
    Chart.defaults.font.family = "'Inter', 'Segoe UI', 'Roboto', sans-serif";
    Chart.defaults.color = '#6c757d'; // Muted text color
    Chart.defaults.plugins.legend.labels.usePointStyle = true;

    // Color Palette
    const colors = {
        primary: '#0d6efd',
        primaryLight: 'rgba(13, 110, 253, 0.1)',
        secondary: '#6c757d',
        success: '#198754',
        info: '#0dcaf0',
        warning: '#ffc107',
        danger: '#dc3545'
    };

    // 2. Articles Published (Line Chart)
    const ctxArticles = document.getElementById('articlesChart').getContext('2d');
    new Chart(ctxArticles, {
        type: 'line',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.Dates)),
            datasets: [{
                label: 'Articles',
                data: @Html.Raw(Json.Serialize(Model.ArticlesPerDay)),
                borderColor: colors.primary,
                backgroundColor: colors.primaryLight,
                fill: true,
                tension: 0.4, // Smooth curves
                pointRadius: 4,
                pointBackgroundColor: colors.primary
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: { beginAtZero: true, grid: { display: false } },
                x: { grid: { display: false } }
            }
        }
    });

    // 3. Top Articles (Horizontal Bar Chart)
    const topArticleUrls = @Html.Raw(Json.Serialize(Model.TopArticleUrls));
    const ctxTop = document.getElementById('topArticlesChart').getContext('2d');
    new Chart(ctxTop, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.TopArticleTitles)),
            datasets: [{
                label: 'Views',
                data: @Html.Raw(Json.Serialize(Model.TopArticleViews)),
                backgroundColor: colors.info,
                borderRadius: 6,
                barThickness: 20 // Keeps bars consistent regardless of title length
            }]
        },
        options: {
            indexAxis: 'y', // Horizontal bars are best for long titles
            responsive: true,
            maintainAspectRatio: false, // Allows the chart to grow vertically to fit text
            layout: {
                padding: {
                    left: 20,
                    right: 40 // Extra space for value labels
                }
            },
            plugins: {
                legend: { display: false }
            },
            onClick: function (event, elements) {
                if (!elements.length) {
                    return;
                }

                const articleIndex = elements[0].index;
                const articleUrl = topArticleUrls[articleIndex];

                if (articleUrl) {
                    window.open(articleUrl, '_blank', 'noopener,noreferrer');
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    grid: { display: false }
                },
                y: {
                    grid: { display: false },
                    ticks: {
                        autoSkip: false, // Forces every title to be shown
                        font: {
                            size: 11 // Slightly smaller font helps readability on smaller screens
                        },
                        // This function ensures that if a title is massive, it doesn't break the layout
                        callback: function(value) {
                            const label = this.getLabelForValue(value);
                            if (label.length > 30) {
                                return label.substr(0, 30) + '...'; // Cap at 30 chars just in case
                            }
                            return label;
                        }
                    }
                }
            }
        }
    });

    // 4. Category Performance (Grouped Bar Chart)
    const ctxCat = document.getElementById('categoryChart').getContext('2d');
    new Chart(ctxCat, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.CategoryNames)),
            datasets: [
                {
                    label: 'Total Views',
                    data: @Html.Raw(Json.Serialize(Model.CategoryViews)),
                    backgroundColor: colors.primary,
                    borderRadius: 5
                },
                {
                    label: 'Avg Views/Article',
                    data: @Html.Raw(Json.Serialize(Model.CategoryAvgViews)),
                    backgroundColor: colors.warning,
                    borderRadius: 5
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    // 5. Editor Performance (Bar Chart at bottom of table)
    const ctxEditor = document.getElementById('editorChart').getContext('2d');
    new Chart(ctxEditor, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.EditorNames)),
            datasets: [
                {
                    label: 'Total Views',
                    data: @Html.Raw(Json.Serialize(Model.EditorViews)),
                    backgroundColor: colors.success,
                    borderRadius: 5
                },
                {
                    label: 'Avg Views',
                    data: @Html.Raw(Json.Serialize(Model.EditorAvgViews)),
                    backgroundColor: colors.secondary,
                    borderRadius: 5
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    const topLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.TopArticles.Select(x => x.Title)));

    const topCTR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.TopArticles.Select(x => Math.Round(x.CTR * 100, 2))));

    const topAnalyticsIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.TopArticles.Select(x => x.ArticleId)));

    const worstLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.WorstArticles.Select(x => x.Title)));

    const worstCTR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.WorstArticles.Select(x => Math.Round(x.CTR * 100, 2))));

    const worstAnalyticsIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.WorstArticles.Select(x => x.ArticleId)));

    const worstClicks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.WorstArticles.Select(x => x.Clicks)));

    const worstImpressions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.WorstArticles.Select(x => x.Impressions)));

    // Scale the underperforming chart to the actual CTR range so very small CTRs remain visible.
    const worstMaxCtr = Math.max(...worstCTR, 0);
    const worstCtrAxisMax = worstMaxCtr > 0
        ? Math.max(Math.ceil(worstMaxCtr * 1.25 * 100) / 100, 0.05)
        : 0.05;

    const chartLabel = function(value) {
        const label = this.getLabelForValue(value);
        return label.length > 55 ? label.substring(0, 55) + '…' : label;
    };

    const setPointerCursor = function(event, elements, chart) {
        chart.canvas.style.cursor = elements.length ? 'pointer' : 'default';
    };

    const openDashboardArticle = function(articleId) {
        if (!articleId) {
            return;
        }

        window.open(
            '/Admin/Dashboard/OpenArticle?id=' + encodeURIComponent(articleId),
            '_blank',
            'noopener,noreferrer'
        );
    };

    const getClickedIndex = function(chart, event, elements) {
        if (elements && elements.length) {
            return elements[0].index;
        }

        const nearest = chart.getElementsAtEventForMode(
            event,
            'nearest',
            { intersect: false },
            true
        );

        return nearest.length ? nearest[0].index : -1;
    };

    new Chart(document.getElementById('topChart'), {
        type: 'bar',
        data: {
            labels: topLabels,
            datasets: [{
                label: 'CTR (%)',
                data: topCTR,
                backgroundColor: colors.info,
                borderRadius: 5,
                barThickness: 18
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            onHover: setPointerCursor,
            onClick: function (event, elements) {
                const index = getClickedIndex(this, event, elements);

                if (index >= 0) {
                    openDashboardArticle(topAnalyticsIds[index]);
                }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        title: function(items) { return topLabels[items[0].dataIndex]; }
                    }
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    title: { display: true, text: 'CTR (%)' }
                },
                y: {
                    grid: { display: false },
                    ticks: {
                        autoSkip: false,
                        callback: chartLabel,
                        font: { size: 11 }
                    }
                }
            }
        }
    });

    new Chart(document.getElementById('worstChart'), {
        type: 'bar',
        data: {
            labels: worstLabels,
            datasets: [{
                label: 'CTR (%)',
                data: worstCTR,
                backgroundColor: colors.warning,
                borderRadius: 5,
                barThickness: 18
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            onHover: setPointerCursor,
            onClick: function (event, elements) {
                const index = getClickedIndex(this, event, elements);

                if (index >= 0) {
                    openDashboardArticle(worstAnalyticsIds[index]);
                }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        title: function(items) {
                            return worstLabels[items[0].dataIndex];
                        },
                        label: function(context) {
                            const index = context.dataIndex;
                            return [
                                'CTR: ' + Number(worstCTR[index]).toFixed(2) + '%',
                                'Clicks: ' + Number(worstClicks[index]).toLocaleString(),
                                'Impressions: ' + Number(worstImpressions[index]).toLocaleString()
                            ];
                        }
                    }
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    max: worstCtrAxisMax,
                    title: { display: true, text: 'CTR (%)' },
                    ticks: {
                        callback: function(value) {
                            return Number(value).toFixed(2) + '%';
                        }
                    }
                },
                y: {
                    grid: { display: false },
                    ticks: {
                        autoSkip: false,
                        callback: chartLabel,
                        font: { size: 11 }
                    }
                }
            }
        }
    });

    const clicks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.TopArticles.Select(x => x.Clicks)));

    const impressions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AnalyticsData.TopArticles.Select(x => x.Impressions)));

    new Chart(document.getElementById('comparisonChart'), {
        type: 'bar',
        data: {
            labels: topLabels,
            datasets: [
                {
                    label: 'Clicks',
                    data: clicks,
                    backgroundColor: colors.info,
                    borderRadius: 5
                },
                {
                    label: 'Impressions',
                    data: impressions,
                    backgroundColor: colors.primary,
                    borderRadius: 5
                }
            ]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            onHover: setPointerCursor,
            onClick: function (event, elements) {
                const index = getClickedIndex(this, event, elements);

                if (index >= 0) {
                    openDashboardArticle(topAnalyticsIds[index]);
                }
            },
            plugins: {
                legend: { position: 'bottom' },
                tooltip: {
                    callbacks: {
                        title: function(items) { return topLabels[items[0].dataIndex]; }
                    }
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    grid: { display: false }
                },
                y: {
                    grid: { display: false },
                    ticks: {
                        autoSkip: false,
                        callback: chartLabel,
                        font: { size: 11 }
                    }
                }
            }
        }
    });
</script>