@model IEnumerable<BolNews.Web.Areas.Admin.ViewModels.ArticleVM>

@{
    ViewData["Title"] = "Articles";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<style>
    .lazy-image {
        filter: blur(10px);
        transition: filter 0.3s;
    }

        .lazy-image.loaded {
            filter: blur(0);
        }
</style>
<h2 class="mb-4">Articles</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Article
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Article List</h5>
    </div>
    <div class="card-body p-0">
        <table class="table-striped table-hover mb-0 table align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Thumbnail</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Published At</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(article.FeaturedImageThumb))
                            {
                                <img class="lazy-image"
                                     src="/images/placeholder.png"
                                     data-src="@($"{article.FeaturedImageThumb}?v=@{article.Id}")"
                                     data-srcset="
                                                @($"{article.FeaturedImageThumb}?v=@{article.Id}") 150w,
                                     @($"{article.FeaturedImageMedium}?v=@{article.Id}") 400w,
                                                @($"{article.FeaturedImageLarge}?v=@{article.Id}") 800w"
                                     style="width:80px; height:80px; object-fit:cover;" />
                            }
                            else
                            {
                                <img src="/images/default-news.png"
                                     style="width:100%;" />
                            }
                        </td>
                        <td>@article.Title</td>
                        <td>@article.AuthorName</td>
                        <td>@article.CategoryName</td>
                        <td>@article.PublishedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="badge @(article.IsPublished ? "bg-success" : "bg-secondary")">
                                @(article.IsPublished ? "Published" : "Draft")
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-warning me-1">
                                Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@article.Id" class="btn btn-sm btn-info me-1">
                                Details
                            </a>
                            <form asp-action="Delete" asp-route-id="@article.Id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this article?');">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
