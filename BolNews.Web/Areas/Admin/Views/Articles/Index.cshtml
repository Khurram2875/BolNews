@using BolNews.Domain.Common
@using BolNews.Domain.Enums
@using BolNews.Web.Areas.Admin.ViewModels
@model IEnumerable<BolNews.Web.Areas.Admin.ViewModels.ArticleVM>

@{
	ViewData["Title"] = "Articles";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
	var canManageHomepagePlacement = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Editor) || User.IsInRole(Roles.SubEditor);
	var canViewRevisionHistory = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Editor) || User.IsInRole(Roles.SubEditor);
	int? pinnedTopStoryArticleId = ViewBag.PinnedTopStoryArticleId as int?;
	var secondaryPlacementByArticleId =
		ViewBag.SecondaryPlacementByArticleId as Dictionary<int, int> ?? new Dictionary<int, int>();
	var returnUrl = Context.Request.Path + Context.Request.QueryString;
	var latestPlacementByArticleId =
	ViewBag.LatestPlacementByArticleId as Dictionary<int, int> ?? new Dictionary<int, int>();
	var featuredPlacementByArticleId =
		ViewBag.FeaturedPlacementByArticleId as Dictionary<int, int> ?? new Dictionary<int, int>();
}
<style>
	.lazy-image {
		filter: blur(10px);
		transition: filter 0.3s;
	}

		.lazy-image.loaded {
			filter: blur(0);
		}
</style>
<h2 class="mb-4">Articles</h2>
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show">
		@TempData["Error"]
		<button type="button"
				class="btn-close"
				data-bs-dismiss="alert">
		</button>
	</div>
}
@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show">
		@TempData["Success"]
		<button type="button"
				class="btn-close"
				data-bs-dismiss="alert">
		</button>
	</div>
}
<div class="mb-3">
	<a asp-action="Create" class="btn btn-primary">
		<i class="bi bi-plus-circle"></i> Create New Article
	</a>
	@if (canManageHomepagePlacement)
	{
		<a asp-area="Admin" asp-controller="EditorialPlacements" asp-action="Index" class="btn btn-outline-dark ms-2">
			<i class="bi bi-pin-angle"></i> Homepage Placement
		</a>
	}
</div>

<div class="card shadow-sm">
	<div class="card-header bg-primary text-white">
		<h5 class="mb-0">Article List</h5>
		@if (ViewBag.CanViewDeleted == true)
			{
				
					@if (ViewBag.ShowingDeleted == true)
					{
					<a asp-action="Index" class="badge bg-warning text-dark" style="text-decoration:none">
							<i class="bi bi-arrow-left"></i> Back to Active Articles
						</a>
					}
					else
					{
						<a asp-action="Index" asp-route-showDeleted="true" class="badge bg-danger text-light" style="text-decoration:none">
							<i class="bi bi-trash"></i> View Deleted Articles
						</a>
					}
				
			}

			@if (ViewBag.ShowingDeleted == true)
			{
				<div class="alert alert-secondary">
					Showing soft-deleted articles. These are hidden from the public site and the normal article list.
				</div>
			}
	</div>
	<div class="card-body p-0">
		@{
			var rowContexts = Model.Select(article => new ArticleRowContext
			{
				Article = article,
				PinnedTopStoryArticleId = pinnedTopStoryArticleId,
				SecondaryPlacementByArticleId = secondaryPlacementByArticleId,
				LatestPlacementByArticleId = latestPlacementByArticleId,
				FeaturedPlacementByArticleId = featuredPlacementByArticleId,
				ReturnUrl = returnUrl,
				CanManageHomepagePlacement = canManageHomepagePlacement,
				CanViewRevisionHistory = canViewRevisionHistory
			}).ToList();
		}

		<!-- Desktop / tablet table -->
		<div class="table-responsive d-none d-md-block">
			<table class="table-striped table-hover table-sm mb-0 table align-middle" style="font-size:smaller">
				<thead class="table-dark">
					<tr>
						<th>Thumbnail</th>
						<th>Title</th>
						<th>Author</th>
						<th>Category</th>
						<th>Status</th>
						<th class="text-center">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var ctx in rowContexts)
					{
						var article = ctx.Article;
						<tr>
							<td>
								@if (!string.IsNullOrEmpty(article.FeaturedImageThumb))
								{
									<img class="lazy-image"
										 src="/images/placeholder.png"
										 data-src="@($"{article.FeaturedImageThumb}?v=@{article.Id}")"
										 style="width:50px; height:50px; object-fit:cover;" />
								}
								else
								{
									<img src="/images/default-news.png" style="width:50px; height:50px; object-fit:cover;" />
								}
							</td>
							<td>@article.Title</td>
							<td>@article.AuthorName</td>
							<td>@article.CategoryName</td>
							<td>@await Html.PartialAsync("_ArticleStatusBadges", ctx)</td>
							<td class="text-center">@await Html.PartialAsync("_ArticleActions", ctx)</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<!-- Mobile card list -->
		<div class="d-md-none">
			@foreach (var ctx in rowContexts)
			{
				var article = ctx.Article;
				<div class="border-bottom p-3">
					<div class="d-flex gap-3">
						@if (!string.IsNullOrEmpty(article.FeaturedImageThumb))
						{
							<img class="lazy-image flex-shrink-0"
								 src="/images/placeholder.png"
								 data-src="@($"{article.FeaturedImageThumb}?v=@{article.Id}")"
								 style="width:64px; height:64px; object-fit:cover; border-radius:4px;" />
						}
						else
						{
							<img src="/images/default-news.png" style="width:64px; height:64px; object-fit:cover; border-radius:4px;" />
						}
						<div class="flex-grow-1 min-width-0">
							<div class="fw-semibold">@article.Title</div>
							<div class="small text-muted">@article.AuthorName &middot; @article.CategoryName</div>
							<div class="mt-1">@await Html.PartialAsync("_ArticleStatusBadges", ctx)</div>
						</div>
					</div>
					<div class="mt-2">@await Html.PartialAsync("_ArticleActions", ctx)</div>
				</div>
			}
		</div>
		@if (ViewBag.TotalPages > 1)
		{
			<div class="card-footer d-flex align-items-center justify-content-between bg-light border-top py-3">
				<div class="text-muted small">
					Showing page <strong>@ViewBag.CurrentPage</strong> of <strong>@ViewBag.TotalPages</strong>
				</div>

				<nav aria-label="Article administration navigation loop">
					<ul class="pagination pagination-sm mb-0">

						<li class="page-item @(ViewBag.HasPreviousPage ? "" : "disabled")">
							<a class="page-item page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })">
								<span aria-hidden="true">&laquo; Previous</span>
							</a>
						</li>

						@for (int i = 1; i <= ViewBag.TotalPages; i++)
						{
							<li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
								<a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
							</li>
						}

						<li class="page-item @(ViewBag.HasNextPage ? "" : "disabled")">
							<a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })">
								<span>Next &raquo;</span>
							</a>
						</li>

					</ul>
				</nav>
			</div>
		}
	</div>
</div>
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmModalLabel">Delete this article?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>This will remove <strong id="deleteConfirmArticleTitle"></strong> from the article list. You can restore it later if needed.</p>
                <label for="deleteConfirmReason" class="form-label small text-muted">
                    Reason for deletion (optional)
                </label>
                <textarea id="deleteConfirmReason" class="form-control" rows="2" placeholder="e.g. duplicate story, factual error, no longer relevant..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger" id="deleteConfirmYesBtn">Yes, delete it</button>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modalEl = document.getElementById('deleteConfirmModal');
        const modal = new bootstrap.Modal(modalEl);
        const titleEl = document.getElementById('deleteConfirmArticleTitle');
        const reasonEl = document.getElementById('deleteConfirmReason');
        const yesBtn = document.getElementById('deleteConfirmYesBtn');

        let pendingForm = null;

        document.querySelectorAll('.js-delete-trigger').forEach(function (btn) {
            btn.addEventListener('click', function () {
                pendingForm = btn.closest('.js-delete-form');
                titleEl.textContent = pendingForm.dataset.articleTitle || 'this article';
                reasonEl.value = ''; // reset so a previous reason doesn't carry over
                modal.show();
            });
        });

        yesBtn.addEventListener('click', function () {
            if (pendingForm) {
                const reasonInput = pendingForm.querySelector('.js-delete-reason-input');
                if (reasonInput) {
                    reasonInput.value = reasonEl.value.trim();
                }
                modal.hide();
                pendingForm.submit();
            }
        });
    });
</script>