@using BolNews.Domain.Common
@using BolNews.Domain.Enums
@model IEnumerable<BolNews.Web.Areas.Admin.ViewModels.ArticleVM>

@{
    ViewData["Title"] = "Articles";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var canManageHomepagePlacement = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Editor);
    int? pinnedTopStoryArticleId = ViewBag.PinnedTopStoryArticleId as int?;
    var secondaryPlacementByArticleId =
        ViewBag.SecondaryPlacementByArticleId as Dictionary<int, int> ?? new Dictionary<int, int>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<style>
    .lazy-image {
        filter: blur(10px);
        transition: filter 0.3s;
    }

        .lazy-image.loaded {
            filter: blur(0);
        }
</style>
<h2 class="mb-4">Articles</h2>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Article
    </a>
    @if (canManageHomepagePlacement)
    {
        <a asp-area="Admin" asp-controller="EditorialPlacements" asp-action="Index" class="btn btn-outline-dark ms-2">
            <i class="bi bi-pin-angle"></i> Homepage Placement
        </a>
    }
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Article List</h5>
    </div>
    <div class="card-body p-0">
        <table class="table-striped table-hover tabel-sm mb-0 table align-middle" style="font-size:smaller">
            <thead class="table-dark">
                <tr>
                    <th>Thumbnail</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                   @*  <th>Published At</th> *@
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(article.FeaturedImageThumb))
                            {
                                <img class="lazy-image"
                                     src="/images/placeholder.png"
                                     data-src="@($"{article.FeaturedImageThumb}?v=@{article.Id}")"
                                     data-srcset="
                                                @($"{article.FeaturedImageThumb}?v=@{article.Id}") 150w,
                                     @($"{article.FeaturedImageMedium}?v=@{article.Id}") 400w,
                                                @($"{article.FeaturedImageLarge}?v=@{article.Id}") 800w"
                                     style="width:50px; height:50px; object-fit:cover;" />
                            }
                            else
                            {
                                <img src="/images/default-news.png"
                                     style="width:100%;" />
                            }
                        </td>
                        <td>@article.Title</td>
                        <td>@article.AuthorName</td>
                        <td>@article.CategoryName</td>
                        @* <td>@article.PublishedAt?.ToString("yyyy-MM-dd HH:mm")</td> *@
                        <td>
                            @switch (article.WorkflowStatus)
                            {
                                case ArticleWorkflowStatus.Draft:
                                    <span class="badge bg-secondary">Draft</span>
                                    break;

                                case ArticleWorkflowStatus.Submitted:
                                    <span class="badge bg-info text-dark">Submitted</span>
                                    break;

                                case ArticleWorkflowStatus.UnderReview:
                                    <span class="badge bg-primary">Under Review</span>
                                    break;

                                case ArticleWorkflowStatus.FactCheckPending:
                                    <span class="badge bg-warning text-dark">Fact Check</span>
                                    break;

                                case ArticleWorkflowStatus.Approved:
                                    <span class="badge bg-success">Approved</span>
                                    break;

                                case ArticleWorkflowStatus.Rejected:
                                    <span class="badge bg-danger">Rejected</span>
                                    break;

                                case ArticleWorkflowStatus.Published:
                                    <span class="badge bg-dark">Published</span>
                                    break;

                                case ArticleWorkflowStatus.Archived:
                                    <span class="badge bg-light text-dark">Archived</span>
                                    break;

                                default:
                                    <span class="badge bg-secondary">Unknown</span>
                                    break;
                            }
                            
                            @if (User.IsInRole(Roles.Author))
                            {
                                <div class="small mt-1">

                                    @if (article.WorkflowStatus == ArticleWorkflowStatus.Submitted ||
                                                                article.WorkflowStatus == ArticleWorkflowStatus.UnderReview)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(article.ReviewerName))
                                        {
                                            <div class="text-muted">
                                                Reviewer: @article.ReviewerName
                                            </div>
                                        }
                                    }

                                    @if (article.WorkflowStatus == ArticleWorkflowStatus.FactCheckPending)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(article.ReviewerName))
                                        {
                                            <div class="text-muted">
                                                Reviewed by: @article.ReviewerName
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(article.FactCheckerName))
                                        {
                                            <div class="text-muted">
                                                Fact Checker: @article.FactCheckerName
                                            </div>
                                        }
                                    }

                                    @if (article.WorkflowStatus == ArticleWorkflowStatus.Rejected &&
                                                                !string.IsNullOrWhiteSpace(article.WorkflowComment))
                                    {
                                        <div class="text-danger mt-1">
                                            Reason: @article.WorkflowComment
                                        </div>
                                    }

                                    @if (article.WorkflowStatus == ArticleWorkflowStatus.Published &&
                                                                article.PublishedAt.HasValue)
                                    {
                                        <div class="text-success mt-1">
                                            
                                            @article.PublishedAt.Value.ToString("g")
                                        </div>
                                    }
                                    
                                </div>
                            }
                            @if (canManageHomepagePlacement)
                            {
                                <div class="small mt-1">
                                    @if (pinnedTopStoryArticleId == article.Id)
                                    {
                                        <span class="badge bg-danger">Top Story</span>
                                    }
                                    @if (secondaryPlacementByArticleId.ContainsKey(article.Id))
                                    {
                                        <span class="badge bg-primary">Secondary Story</span>
                                    }
                                </div>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Discussion"
                               asp-route-id="@article.Id"
                               class="badge bg-primary">
                                Discussion
                            </a> |
                            <a asp-action="Edit" asp-route-id="@article.Id" class="badge bg-warning me-1">
                                Edit
                            </a>
                            <a href="/news/@article.CategorySlug/@article.Slug" target="_blank" class="badge bg-info text-decoration-none me-1">
                                Preview
                            </a>
                            @if (canManageHomepagePlacement && article.IsPublished)
                            {
                                if (pinnedTopStoryArticleId == article.Id)
                                {
                                    <form asp-area="Admin" asp-controller="EditorialPlacements" asp-action="UnpinTopStory" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="badge bg-light border border-danger text-danger">
                                            Unpin Top
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-area="Admin" asp-controller="EditorialPlacements" asp-action="PinTopStory" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="articleId" value="@article.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="badge bg-dark">
                                            Pin Top
                                        </button>
                                    </form>
                                }

                                if (secondaryPlacementByArticleId.TryGetValue(article.Id, out var placementId))
                                {
                                    <form asp-area="Admin" asp-controller="EditorialPlacements" asp-action="UnpinSecondaryStory" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="placementId" value="@placementId" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="badge bg-light border border-primary text-primary">
                                            Unpin Secondary
                                        </button>
                                    </form>
                                }
                                else if (pinnedTopStoryArticleId != article.Id)
                                {
                                    <form asp-area="Admin" asp-controller="EditorialPlacements" asp-action="PinSecondaryStory" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="articleId" value="@article.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="badge bg-primary">
                                            Pin Secondary
                                        </button>
                                    </form>
                                }
                            }
                           @*  <a asp-action="Details" asp-route-id="@article.Id" class="badge bg-info me-1">
                                Details
                            </a> *@
                            @if (User.IsInRole("Admin") || User.IsInRole("Editor") || User.IsInRole("Author"))
                            {
                                <form asp-action="Delete" asp-route-id="@article.Id" method="post" style="display:inline">
                                    <button type="submit" class="badge bg-danger"
                                    onclick="return confirm('Are you sure you want to delete this article?');">
                                        Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer d-flex align-items-center justify-content-between bg-light border-top py-3">
                <div class="text-muted small">
                    Showing page <strong>@ViewBag.CurrentPage</strong> of <strong>@ViewBag.TotalPages</strong>
                </div>

                <nav aria-label="Article administration navigation loop">
                    <ul class="pagination pagination-sm mb-0">

                        <li class="page-item @(ViewBag.HasPreviousPage ? "" : "disabled")">
                            <a class="page-item page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })">
                                <span aria-hidden="true">&laquo; Previous</span>
                            </a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })">
                                <span>Next &raquo;</span>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
