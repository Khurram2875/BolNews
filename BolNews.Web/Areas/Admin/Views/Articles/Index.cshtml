@model IEnumerable<BolNews.Web.Areas.Admin.ViewModels.ArticleVM>

@{
    ViewData["Title"] = "Articles";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Articles</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Article
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Article List</h5>
    </div>
    <div class="card-body p-0">
        <table class="table-striped table-hover mb-0 table align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Published At</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model)
                {
                    <tr>
                        <td>@article.Title</td>
                        <td>@article.AuthorName</td>
                        <td>@article.CategoryName</td>
                        <td>@article.PublishedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="badge @(article.IsPublished ? "bg-success" : "bg-secondary")">
                                @(article.IsPublished ? "Published" : "Draft")
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-warning me-1">
                                Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@article.Id" class="btn btn-sm btn-info me-1">
                                Details
                            </a>
                            <form asp-action="Delete" asp-route-id="@article.Id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this article?');">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>