@using BolNews.Domain.Common
@using System.Text.Json
@model BolNews.Web.Areas.Admin.ViewModels.ArticleVM
<link href="~/css/site.css" rel="stylesheet" />
@{
	ViewData["Title"] = "Create Article";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
	var isAdmin = User.IsInRole(Roles.Admin);
	var isEditor = User.IsInRole(Roles.Editor);
	var isSubEditor = User.IsInRole(Roles.SubEditor);
	var isAuthor = User.IsInRole(Roles.Author);

	var canPublish = isAdmin || isEditor || isSubEditor;
	var canEditorsPick = isAdmin || isEditor;
	var canFactCheck = isAdmin || isEditor || isSubEditor;
}
<div id="headlineSuggestions"></div>

<div class="card shadow-sm">
	<div class="card-header bg-primary text-white">
		<h4 class="mb-0">Create New Article</h4>
	</div>
	<div class="card-body">
		
		<form id="articleForm" asp-action="Create" method="post" enctype="multipart/form-data">
			@Html.AntiForgeryToken()
			<div asp-validation-summary="ModelOnly"
				 id="validationSummary"
				 class="alert alert-danger d-none">
			</div>

			<div class="mb-3">
				<label asp-for="Title" class="form-label"></label>
				<div class="input-group">
					<input asp-for="Title" id="Title" class="form-control" />
					<button type="button" class="btn btn-info" onclick="generateHeadlines()">
						Suggestions
					</button>
				</div>
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Slug" class="form-label"></label>
				<input asp-for="Slug" id="Slug" class="form-control" readonly style="background-color: #e9ecef;" />
				<span asp-validation-for="Slug" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Summary" class="form-label"></label>
				<textarea asp-for="Summary" id="Summary" class="form-control" rows="3"></textarea>
				<span asp-validation-for="Summary" class="text-danger"></span>
			</div>

			<!-- CATEGORY CONTROL (Moved Here with id="CategoryId") -->
			<div class="mb-3">
				<label asp-for="CategoryId" class="form-label">Category</label>
				<select asp-for="CategoryId" id="CategoryId" class="form-select" asp-items="ViewBag.Categories">
					<option value="">-- Select Category --</option>
				</select>
				<span asp-validation-for="CategoryId" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="ReporterId" class="form-label">Reporter / Source</label>
				<select asp-for="ReporterId" class="form-select" asp-items="ViewBag.Reporters">
					<option value="">-- Select Reporter / Source --</option>
				</select>
				<span asp-validation-for="ReporterId" class="text-danger"></span>
			</div>

			<div id="metaContainer" class="position-relative rounded p-2">

				<!-- LOADING SPINNER OVERLAY (Hidden by default) -->
				<div id="metaSpinner" class="position-absolute w-100 h-100 d-none justify-content-center align-items-center start-0 top-0 rounded"
					 style="background: rgba(255,255,255,0.7); z-index: 5;">
					<div class="text-center">
						<div class="spinner-border text-primary" role="status"></div>
						<div class="text-primary fw-bold mt-1" style="font-size: 0.85rem;">Gemini is writing metadata...</div>
					</div>
				</div>

				<!-- META TITLE -->
				<div class="mb-3">
					<label class="form-label fw-bold">Meta Title</label>
					<input asp-for="MetaTitle" id="MetaTitle" class="form-control" />
					<small class="text-muted d-block mt-1">
						<i class="bi bi-robot text-info"></i> AI generated. Feel free to tweak it if you want.
					</small>
					<span asp-validation-for="MetaTitle" class="text-danger"></span>
				</div>

				<!-- META DESCRIPTION -->
				<div class="mb-3">
					<label class="form-label fw-bold">Meta Description</label>
					<textarea asp-for="MetaDescription" id="MetaDescription" class="form-control" rows="2"></textarea>
					<small class="text-muted d-block mt-1">
						<i class="bi bi-robot text-info"></i> AI generated. Feel free to tweak it if you want.
					</small>
					<span asp-validation-for="MetaDescription" class="text-danger"></span>
				</div>
			</div>

			@* <div class="mb-3">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" id="editor" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div> *@

			<div class="mb-3">

				<div class="d-flex justify-content-between align-items-center mb-2">
					<label asp-for="Content" class="form-label mb-0"></label>

					<button type="button"
							id="btnCheckGrammar"
							class="btn btn-outline-primary">
						Check Grammar
					</button>
				</div>

				<input type="hidden" asp-for="Content" id="Content" />

				<div class="row g-3">

					<!-- LEFT: Editor column -->
					<div id="editorColumn" class="col-12">

						<!-- Your existing image/media controls -->
						<div class="mb-2">

							<button type="button"
									id="imgLeft"
									class="badge bg-dark">
								Image Left
							</button>

							<button type="button"
									id="imgCenter"
									class="badge bg-dark">
								Image Center
							</button>

							<button type="button"
									id="imgRight"
									class="badge bg-dark">
								Image Right
							</button> |
							<button type="button"
									id="imgSmall"
									class="badge bg-dark">
								Small
							</button>

							<button type="button"
									id="imgMedium"
									class="badge bg-dark">
								Medium
							</button>

							<button type="button"
									id="imgLarge"
									class="badge bg-dark">
								Large
							</button>

							<button type="button"
									id="imgFull"
									class="badge bg-dark">
								Full Width
							</button>
							<button type="button" id="btnSocialEmbed" class="badge bg-primary">
								⚡ Embed Social Code
							</button>
						</div>

						<div id="editor"></div>

						<span asp-validation-for="Content"
							  class="text-danger">
						</span>

					</div>
					<!-- END editorColumn -->
					<!-- RIGHT: Grammar panel column -->
					<div id="grammarPanelColumn"
						 class="col-lg-4 d-none">

						<div class="grammar-review-panel">

							<div class="d-flex justify-content-between align-items-center mb-3">
								<div>
									<h5 class="mb-1">
										Grammar Suggestions
									</h5>

									<small id="grammarIssueCount"
										   class="text-muted">
										No review performed
									</small>
								</div>

								<button type="button"
										id="btnCloseGrammar"
										class="btn-close"
										aria-label="Close">
								</button>
							</div>

							<div id="grammarLoading"
								 class="d-none py-4 text-center">

								<div class="spinner-border spinner-border-sm"
									 role="status">
								</div>

								<span class="ms-2">
									Checking content...
								</span>
							</div>

							<div id="grammarSuggestions">
								<div class="text-muted py-4 text-center">
									Click <strong>Check Grammar</strong>
									to review the article content.
								</div>
							</div>

							<div id="grammarActions"
								 class="d-none border-top mt-3 pt-3">

								<button type="button"
										id="btnApplyAllGrammar"
										class="btn btn-primary w-100">
									Apply All Suggestions
								</button>
							</div>

						</div>

					</div>
					<!-- END grammarPanelColumn -->

				</div>
				<!-- END Bootstrap row -->

			</div>

			<div class="mb-3">
				<label class="form-label">Featured Image</label>
				<input asp-for="FeaturedMediaId" type="hidden" />
				<button type="button" class="btn btn-outline-primary btn-sm mb-2" data-media-picker="featured">Choose from Media Library</button>
				<input type="file" asp-for="ImageFile" class="form-control" />
				<span asp-validation-for="ImageFile" class="text-danger"></span>
			</div>

			<div class="row">
				<div class="col-md-6 mb-3">
					<label asp-for="FeaturedImageAltText" class="form-label">Featured Image Alt Text</label>
					<input asp-for="FeaturedImageAltText" class="form-control" />
				</div>
				<div class="col-md-6 mb-3">
					<label asp-for="FeaturedImageCredit" class="form-label">Featured Image Credit</label>
					<input asp-for="FeaturedImageCredit" class="form-control" />
				</div>
			</div>
			<div class="mb-3">
				<label asp-for="FeaturedImageCaption" class="form-label">Featured Image Caption</label>
				<input asp-for="FeaturedImageCaption" class="form-control" />
			</div>

			@await Html.PartialAsync("_TagEditor", null, new ViewDataDictionary(ViewData)
			{
				["InputName"] = nameof(Model.ArticleTagsInput),
				["InputId"] = nameof(Model.ArticleTagsInput),
				["Label"] = "Article Tags",
				["HelpText"] = "Tags support topic pages, search matching, related articles, and SEO keywords.",
				["ExistingValue"] = string.IsNullOrWhiteSpace(Model.ArticleTagsInput) ? "[]" : Model.ArticleTagsInput
			})

			@await Html.PartialAsync("_TagEditor", null, new ViewDataDictionary(ViewData)
			{
				["InputName"] = nameof(Model.FeaturedImageTagsInput),
				["InputId"] = nameof(Model.FeaturedImageTagsInput),
				["Label"] = "Featured Image Tags",
				["HelpText"] = "Image tags describe the visual content and enrich structured image metadata.",
				["ExistingValue"] = string.IsNullOrWhiteSpace(Model.FeaturedImageTagsInput) ? "[]" : Model.FeaturedImageTagsInput
			})

			@if (!string.IsNullOrEmpty(Model.FeaturedImageLarge))
			{
				<div class="mb-3">
					<img src="@Model.FeaturedImageLarge" alt="Current Image" class="img-fluid rounded" style="max-height:150px;" />
				</div>
			}



			<div class="card mt-4">
				<div class="card-header">
					Editorial Workflow
				</div>

				<div class="card-body">

					@if (canPublish)
					{
						<div class="form-check mb-3">
							<input asp-for="IsPublished"
								   class="form-check-input" />

							<label asp-for="IsPublished"
								   class="form-check-label">
								Publish Immediately
							</label>
						</div>
					}

					@if (canFactCheck)
					{
						<div class="form-check mb-3">
							<input asp-for="IsFactChecked"
								   class="form-check-input" />

							<label asp-for="IsFactChecked"
								   class="form-check-label">
								Fact Checked
							</label>
						</div>
					}

					@if (isSubEditor || isEditor || isAdmin)
					{
						<div class="mb-3">
							<label asp-for="EditorialPriority"
								   class="form-label">
								Editorial Priority
							</label>

							<select asp-for="EditorialPriority"
									class="form-select">
								@if (isSubEditor)
								{
									<option value="0">Normal</option>
									<option value="1">Important</option>
								}
								else
								{
									<option value="0">Normal</option>
									<option value="1">Important</option>
									<option value="2">High Priority</option>
									<option value="3">Critical</option>
								}
							</select>
						</div>
					}

					@if (canEditorsPick)
					{
						<div class="form-check mb-3">
							<input asp-for="IsEditorsPick"
								   class="form-check-input" />

							<label asp-for="IsEditorsPick"
								   class="form-check-label">
								Editor's Pick
							</label>
						</div>
					}

				</div>
			</div>
			@if (isAuthor)
			{
				<div class="form-check mb-3">
					<input asp-for="SubmitForReview"
						   class="form-check-input" />

					<label asp-for="SubmitForReview"
						   class="form-check-label">
						Submit For Editorial Review
					</label>
				</div>
			}


			<button type="submit" id="btnSaveArticle" class="btn btn-success">
				<i class="bi bi-check-circle"></i> Save
			</button>
			<a asp-action="Index" class="btn btn-secondary ms-2">
				<i class="bi bi-arrow-left-circle"></i> Cancel
			</a>
		</form>
	</div>
</div>
@await Html.PartialAsync("_MediaLibraryPicker")
<div class="modal fade" id="saveChoiceModal" tabindex="-1" aria-labelledby="saveChoiceModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="saveChoiceModalLabel">How would you like to save this article?</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p class="text-muted mb-3">You haven't chosen "Publish Immediately" or "Submit for Editorial Review." Pick one option below, or save it as a draft.</p>
				<div class="d-grid gap-2">
					<button type="button" id="choiceModalDraftBtn" class="btn btn-outline-secondary">
						<i class="bi bi-file-earmark"></i> Save as Draft
					</button>
					<button type="button" id="choiceModalPublishBtn" class="btn btn-success">
						<i class="bi bi-check-circle"></i> Publish Immediately
					</button>
					<button type="button" id="choiceModalReviewBtn" class="btn btn-primary">
						<i class="bi bi-send"></i> Submit for Editorial Review
					</button>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts
{
	<script src="~/js/tag-editor.js" asp-append-version="true"></script>
	@await Html.PartialAsync("_ValidationScriptsPartial")
	<script>

		// ============================================================
		// HEADLINE GENERATION
		// ============================================================

		async function generateHeadlines() {

			const title = document.getElementById("Title").value;

			const res = await fetch('/admin/articles/generateheadlines', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify(title)
			});

			const data = await res.json();

			let html = "<ul>";

			data.suggestions.forEach(s => {
				html += `<li onclick="useHeadline('${s}')">${s}</li>`;
			});

			html += "</ul>";

			document.getElementById("headlineSuggestions").innerHTML = html;
		}


		function useHeadline(text) {
			document.getElementById("Title").value = text;
		}


		// ============================================================
		// MAIN PAGE INITIALIZATION
		// ============================================================

		document.addEventListener('DOMContentLoaded', function () {
			const publishImmediately = document.getElementById('IsPublished');
			const submitForReview = document.getElementById('SubmitForReview');

			function syncEditorialReviewAvailability() {
				if (!publishImmediately || !submitForReview) {
					return;
				}

				const isPublishingImmediately = publishImmediately.checked;
				submitForReview.disabled = isPublishingImmediately;

				if (isPublishingImmediately) {
					submitForReview.checked = false;
				}
			}

			publishImmediately?.addEventListener(
				'change',
				syncEditorialReviewAvailability);

			syncEditorialReviewAvailability();
			//=========================================================
			// ALERT ON SAVE BUTTON
			// START===================================================
			const articleForm = document.getElementById('articleForm');
			const saveArticleButton = document.getElementById('btnSaveArticle');
			let saveChoiceConfirmed = false;
			let formSubmitLocked = false;

			const saveChoiceModalEl = document.getElementById('saveChoiceModal');
			const saveChoiceModal = saveChoiceModalEl ? new bootstrap.Modal(saveChoiceModalEl) : null;

			const draftBtn = document.getElementById('choiceModalDraftBtn');
			const publishBtn = document.getElementById('choiceModalPublishBtn');
			const reviewBtn = document.getElementById('choiceModalReviewBtn');

			

			if (articleForm && saveChoiceModal) {

				articleForm.addEventListener('submit', function (e) {
					if (formSubmitLocked) {
						e.preventDefault();
						return;
					}

					if (!validateArticleFormBeforeSubmit()) {
						e.preventDefault();
						saveChoiceConfirmed = false;
						return;
					}

					if (saveChoiceConfirmed) {
						lockArticleFormForSubmit();
						return;
					}

					const isPublishChecked = publishImmediately?.checked ?? false;
					const isReviewChecked = submitForReview?.checked ?? false;

					if (!isPublishChecked && !isReviewChecked) {
						e.preventDefault();

						if (publishBtn) publishBtn.style.display = publishImmediately ? '' : 'none';
						if (reviewBtn) reviewBtn.style.display = submitForReview ? '' : 'none';

						saveChoiceModal.show();
						return;
					}

					lockArticleFormForSubmit();
				});

				draftBtn?.addEventListener('click', function () {
					saveChoiceModal.hide();
					submitArticleFormFromChoice();
				});

				publishBtn?.addEventListener('click', function () {
					if (publishImmediately) {
						publishImmediately.checked = true;
						syncEditorialReviewAvailability();
					}
					saveChoiceModal.hide();
					submitArticleFormFromChoice();
				});

				reviewBtn?.addEventListener('click', function () {
					if (submitForReview) {
						submitForReview.checked = true;
					}
					saveChoiceModal.hide();
					submitArticleFormFromChoice();
				});
			}

			function submitArticleFormFromChoice() {
				saveChoiceConfirmed = true;

				if (!validateArticleFormBeforeSubmit()) {
					saveChoiceConfirmed = false;
					return;
				}

				articleForm.requestSubmit();
			}

			function validateArticleFormBeforeSubmit() {
				ensureSlugFromTitle();
				syncArticleEditorContent();
				clearContentValidationMessage();

				let isValid = true;

				if (window.jQuery && jQuery.validator) {
					isValid = jQuery(articleForm).valid();
				}
				else {
					isValid = articleForm.checkValidity();
				}

				if (!hasArticleEditorContent()) {
					isValid = false;
					showContentValidationMessage('Please enter article content.');
				}

				if (!isValid) {
					scrollToFirstValidationError();
				}

				return isValid;
			}

			function ensureSlugFromTitle() {
				const titleInput = document.getElementById('Title');
				const slugInput = document.getElementById('Slug');

				if (!titleInput || !slugInput || slugInput.value.trim()) {
					return;
				}

				slugInput.value = titleInput.value
					.toLowerCase()
					.trim()
					.replace(/[^a-z0-9\s-]/g, '')
					.replace(/\s+/g, '-')
					.replace(/-+/g, '-');
			}

			function syncArticleEditorContent() {
				const contentInput = document.getElementById('Content');

				if (!contentInput || !window.quill) {
					return;
				}

				contentInput.value = window.quill.root.innerHTML;
			}

			function hasArticleEditorContent() {
				if (window.quill) {
					return window.quill.getText().trim().length > 0;
				}

				const contentInput = document.getElementById('Content');
				const contentValue = contentInput?.value?.trim() ?? '';

				return contentValue.length > 0 && contentValue !== '<p><br></p>';
			}

			function showContentValidationMessage(message) {
				const contentInput = document.getElementById('Content');
				const contentMessage = document.querySelector('[data-valmsg-for="Content"]');

				contentInput?.classList.add('input-validation-error');

				if (contentMessage) {
					contentMessage.textContent = message;
					contentMessage.classList.remove('field-validation-valid');
					contentMessage.classList.add('field-validation-error');
				}
			}

			function clearContentValidationMessage() {
				const contentInput = document.getElementById('Content');
				const contentMessage = document.querySelector('[data-valmsg-for="Content"]');

				contentInput?.classList.remove('input-validation-error');

				if (contentMessage) {
					contentMessage.textContent = '';
					contentMessage.classList.remove('field-validation-error');
					contentMessage.classList.add('field-validation-valid');
				}
			}

			function scrollToFirstValidationError() {
				const firstError =
					document.querySelector('.input-validation-error, .field-validation-error:not(:empty)');

				firstError?.scrollIntoView({
					behavior: 'smooth',
					block: 'center'
				});
			}

			function lockArticleFormForSubmit() {
				formSubmitLocked = true;

				if (!saveArticleButton) {
					return;
				}

				saveArticleButton.disabled = true;
				saveArticleButton.dataset.originalHtml = saveArticleButton.innerHTML;
				saveArticleButton.innerHTML =
					'<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Saving...';
			}
			// END======================================================

			// ========================================================
			// AUTO-FILL SLUG
			// ========================================================

			const titleInput = document.getElementById("Title");

			if (titleInput) {

				titleInput.addEventListener("blur", function () {

					const titleValue = this.value;

					if (titleValue.trim() !== "") {

						const slugValue = titleValue
							.toLowerCase()
							.trim()
							.replace(/[^a-z0-9\s-]/g, '')
							.replace(/\s+/g, '-')
							.replace(/-+/g, '-');

						const slugInput =
							document.getElementById("Slug");

						if (slugInput) {
							slugInput.value = slugValue;
						}

						const summaryInput =
							document.getElementById("Summary");

						if (summaryInput) {
							summaryInput.focus();
						}
					}
				});
			}


			// ========================================================
			// GEMINI META TITLE / DESCRIPTION GENERATION
			// ========================================================

			const categoryInput =
				document.getElementById("CategoryId");

			if (categoryInput) {

				categoryInput.addEventListener(
					"change",
					async function () {

						const title =
							document.getElementById("Title")?.value;

						const summary =
							document.getElementById("Summary")?.value;

						const categoryDropdown = this;

						const categoryText =
							categoryDropdown.options[
								categoryDropdown.selectedIndex
							].text;

						if (
							!title ||
							!summary ||
							!categoryDropdown.value
						) {
							return;
						}

						const spinner =
							document.getElementById("metaSpinner");

						const metaTitleInput =
							document.getElementById("MetaTitle");

						const metaDescInput =
							document.getElementById("MetaDescription");

						if (spinner) {
							spinner.classList.remove("d-none");
							spinner.classList.add("d-flex");
						}

						if (metaTitleInput) {
							metaTitleInput.disabled = true;
						}

						if (metaDescInput) {
							metaDescInput.disabled = true;
						}

						try {

							const response = await fetch(
								'/admin/articles/generatemetadata',
								{
									method: 'POST',
									headers: {
										'Content-Type': 'application/json'
									},
									body: JSON.stringify({
										title: title,
										summary: summary,
										category: categoryText
									})
								}
							);

							if (response.ok) {

								const data =
									await response.json();

								if (metaTitleInput) {
									metaTitleInput.value =
										data.metaTitle;
								}

								if (metaDescInput) {
									metaDescInput.value =
										data.metaDescription;
								}
							}
							else {
								console.error(
									"Failed to fetch meta data from Gemini."
								);
							}
						}
						catch (error) {

							console.error(
								"Error connecting to metadata generator endpoint:",
								error
							);
						}
						finally {

							if (spinner) {
								spinner.classList.remove("d-flex");
								spinner.classList.add("d-none");
							}

							if (metaTitleInput) {
								metaTitleInput.disabled = false;
							}

							if (metaDescInput) {
								metaDescInput.disabled = false;
							}

							document
								.getElementById("editor")
								?.focus();
						}
					}
				);
			}


			// ========================================================
			 var summary = document.getElementById('validationSummary');
				if (summary && summary.querySelectorAll('li').length > 0) {
					summary.classList.remove('d-none');
					summary.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			// ========================================================
		});

	</script>

	<script src="~/js/article-editor.js" asp-append-version="true"></script>
	<script src="~/js/media-library-picker.js" asp-append-version="true"></script>
}
