@model BolNews.Web.Areas.Admin.ViewModels.ArticleVM

@{
    ViewData["Title"] = "Create Article";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div id="headlineSuggestions"></div>
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Create New Article</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <div class="row">
                    <div class="btn-group">
                        
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    
                        <button type="button" class="btn btn-sm btn-info" onclick="generateHeadlines()">
                            Suggestions
                        </button>
                    </div>
                </div>
                
                
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label>Meta Title</label>
                <input asp-for="MetaTitle" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Meta Description</label>
                <textarea asp-for="MetaDescription" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Summary" class="form-label"></label>
                <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" id="editor" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Featured Image</label>
                <input type="file" asp-for="ImageFile" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.FeaturedImageLarge))
            {
                <div class="mb-3">
                    <img src="@Model.FeaturedImageLarge" alt="Current Image" class="img-fluid rounded" style="max-height:150px;" />
                </div>
            }

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AuthorId" class="form-label">Author</label>
                <select asp-for="AuthorId" class="form-select" asp-items="ViewBag.Authors">
                    <option value="">-- Select Author --</option>
                </select>
                <span asp-validation-for="AuthorId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PublishedAt" class="form-label"></label>
                <input asp-for="PublishedAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="PublishedAt" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsPublished" class="form-check-input" />
                <label asp-for="IsPublished" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i> Save
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="bi bi-arrow-left-circle"></i> Cancel
            </a>
        </form>
    </div>
</div>
<script>
        async function generateHeadlines() {
        const title = document.getElementById("Title").value;

        const res = await fetch('/admin/articles/generateheadlines', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(title)
        });

        const data = await res.json();

        let html = "<ul>";
        data.suggestions.forEach(s => {
            html += `<li onclick="useHeadline('${s}')">${s}</li>`;
        });
        html += "</ul>";

        document.getElementById("headlineSuggestions").innerHTML = html;
    }

    function useHeadline(text) {
        document.getElementById("Title").value = text;
    }
</script>