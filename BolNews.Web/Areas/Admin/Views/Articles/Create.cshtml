@using BolNews.Domain.Common
@model BolNews.Web.Areas.Admin.ViewModels.ArticleVM

@{
    ViewData["Title"] = "Create Article";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var isAdmin = User.IsInRole(Roles.Admin);
    var isEditor = User.IsInRole(Roles.Editor);
    var isSubEditor = User.IsInRole(Roles.SubEditor);
    var isAuthor = User.IsInRole(Roles.Author);

    var canPublish = isAdmin || isEditor || isSubEditor;
    var canEditorsPick = isAdmin || isEditor;
    var canFactCheck = isAdmin || isEditor || isSubEditor;
}
<div id="headlineSuggestions"></div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Create New Article</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Title" id="Title" class="form-control" />
                    <button type="button" class="btn btn-info" onclick="generateHeadlines()">
                        Suggestions
                    </button>
                </div>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" id="Slug" class="form-control" readonly style="background-color: #e9ecef;" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Summary" class="form-label"></label>
                <textarea asp-for="Summary" id="Summary" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <!-- CATEGORY CONTROL (Moved Here with id="CategoryId") -->
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Category</label>
                <select asp-for="CategoryId" id="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div id="metaContainer" class="position-relative rounded p-2">

                <!-- LOADING SPINNER OVERLAY (Hidden by default) -->
                <div id="metaSpinner" class="position-absolute w-100 h-100 d-none justify-content-center align-items-center start-0 top-0 rounded"
                     style="background: rgba(255,255,255,0.7); z-index: 5;">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="text-primary fw-bold mt-1" style="font-size: 0.85rem;">Gemini is writing metadata...</div>
                    </div>
                </div>

                <!-- META TITLE -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Meta Title</label>
                    <input asp-for="MetaTitle" id="MetaTitle" class="form-control" />
                    <small class="text-muted d-block mt-1">
                        <i class="bi bi-robot text-info"></i> AI generated. Feel free to tweak it if you want.
                    </small>
                </div>

                <!-- META DESCRIPTION -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Meta Description</label>
                    <textarea asp-for="MetaDescription" id="MetaDescription" class="form-control" rows="2"></textarea>
                    <small class="text-muted d-block mt-1">
                        <i class="bi bi-robot text-info"></i> AI generated. Feel free to tweak it if you want.
                    </small>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" id="editor" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Featured Image</label>
                <input type="file" asp-for="ImageFile"  class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.FeaturedImageLarge))
            {
                <div class="mb-3">
                    <img src="@Model.FeaturedImageLarge" alt="Current Image" class="img-fluid rounded" style="max-height:150px;" />
                </div>
            }

            

            <div class="card mt-4">
                <div class="card-header">
                    Editorial Workflow
                </div>

                <div class="card-body">

                    @if (canPublish)
                    {
                        <div class="form-check mb-3">
                            <input asp-for="IsPublished"
                                   class="form-check-input" />

                            <label asp-for="IsPublished"
                                   class="form-check-label">
                                Publish Immediately
                            </label>
                        </div>
                    }

                    @if (canFactCheck)
                    {
                        <div class="form-check mb-3">
                            <input asp-for="IsFactChecked"
                                   class="form-check-input" />

                            <label asp-for="IsFactChecked"
                                   class="form-check-label">
                                Fact Checked
                            </label>
                        </div>
                    }

                    @if (isSubEditor || isEditor || isAdmin)
                    {
                        <div class="mb-3">
                            <label asp-for="EditorialPriority"
                                   class="form-label">
                                Editorial Priority
                            </label>

                            <select asp-for="EditorialPriority"
                                    class="form-select">
                                @if (isSubEditor)
                                {
                                    <option value="0">Normal</option>
                                    <option value="1">Important</option>
                                }
                                else
                                {
                                    <option value="0">Normal</option>
                                    <option value="1">Important</option>
                                    <option value="2">High Priority</option>
                                    <option value="3">Critical</option>
                                }
                            </select>
                        </div>
                    }

                    @if (canEditorsPick)
                    {
                        <div class="form-check mb-3">
                            <input asp-for="IsEditorsPick"
                                   class="form-check-input" />

                            <label asp-for="IsEditorsPick"
                                   class="form-check-label">
                                Editor's Pick
                            </label>
                        </div>
                    }

                </div>
            </div>
            @if (isAuthor)
            {
                <div class="form-check mb-3">
                    <input asp-for="SubmitForReview"
                           class="form-check-input" />

                    <label asp-for="SubmitForReview"
                           class="form-check-label">
                        Submit For Editorial Review
                    </label>
                </div>
            }
           @*  <div class="mb-3">
                <label asp-for="PublishedAt" class="form-label"></label>
                <input asp-for="PublishedAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="PublishedAt" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsPublished" class="form-check-input" />
                <label asp-for="IsPublished" class="form-check-label"></label>
            </div> *@

            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i> Save
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="bi bi-arrow-left-circle"></i> Cancel
            </a>
        </form>
    </div>
</div>
<script>
        async function generateHeadlines() {
        const title = document.getElementById("Title").value;

        const res = await fetch('/admin/articles/generateheadlines', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(title)
        });

        const data = await res.json();

        let html = "<ul>";
        data.suggestions.forEach(s => {
            html += `<li onclick="useHeadline('${s}')">${s}</li>`;
        });
        html += "</ul>";

        document.getElementById("headlineSuggestions").innerHTML = html;
    }

    function useHeadline(text) {
        document.getElementById("Title").value = text;
    }

    //autofill slug
        document.getElementById("Title").addEventListener("blur", function () {
    const titleValue = this.value;
    
    if (titleValue.trim() !== "") {
        // Generate Slug
        const slugValue = titleValue
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9\s-]/g, '') 
            .replace(/\s+/g, '-')         
            .replace(/-+/g, '-');         

        document.getElementById("Slug").value = slugValue;

        // Shift focus automatically to Summary
        document.getElementById("Summary").focus();
    }
});

//generating Meta Title and Meta Description through Gemini on Category Change
       document.getElementById("CategoryId").addEventListener("change", async function () {
        const title = document.getElementById("Title").value;
        const summary = document.getElementById("Summary").value;
        const categoryDropdown = this;
        const categoryText = categoryDropdown.options[categoryDropdown.selectedIndex].text;

        // Only run if Title, Summary, and a valid Category are selected
        if (!title || !summary || !categoryDropdown.value) {
            return;
        }

        const spinner = document.getElementById("metaSpinner");
        const metaTitleInput = document.getElementById("MetaTitle");
        const metaDescInput = document.getElementById("MetaDescription");

        // SHOW SPINNER & LOCK UI BY DISABLING CONTROLS TEMPORARILY
        spinner.classList.remove("d-none");
        spinner.classList.add("d-flex");
        metaTitleInput.disabled = true;
        metaDescInput.disabled = true;

        try {
            const response = await fetch('/admin/articles/generatemetadata', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    title: title,
                    summary: summary,
                    category: categoryText
                })
            });

            if (response.ok) {
                const data = await response.json();

                // Populate fields
                metaTitleInput.value = data.metaTitle;
                metaDescInput.value = data.metaDescription;
            } else {
                console.error("Failed to fetch meta data from Gemini.");
            }
        } catch (error) {
            console.error("Error connecting to metadata generator endpoint:", error);
        } finally {
            // HIDE SPINNER & UNLOCK UI
            spinner.classList.remove("d-flex");
            spinner.classList.add("d-none");
            metaTitleInput.disabled = false;
            metaDescInput.disabled = false;

            // AUTOMATICALLY MOVE FOCUS TO THE NEXT CONTROL (Featured Image)
            document.getElementById("editor").focus();
        }
    });
</script>