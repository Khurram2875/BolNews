@using BolNews.Domain.Common
@using System.Text.Json
@model BolNews.Web.Areas.Admin.ViewModels.ArticleVM
<link href="~/css/site.css" rel="stylesheet" />
@{
	ViewData["Title"] = "Create Article";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
	var isAdmin = User.IsInRole(Roles.Admin);
	var isEditor = User.IsInRole(Roles.Editor);
	var isSubEditor = User.IsInRole(Roles.SubEditor);
	var isAuthor = User.IsInRole(Roles.Author);

	var canPublish = isAdmin || isEditor || isSubEditor;
	var canEditorsPick = isAdmin || isEditor;
	var canFactCheck = isAdmin || isEditor || isSubEditor;
}
<div id="headlineSuggestions"></div>

<div class="card shadow-sm">
	<div class="card-header bg-primary text-white">
		<h4 class="mb-0">Create New Article</h4>
	</div>
	<div class="card-body">
		<form asp-action="Create" method="post" enctype="multipart/form-data">
			@Html.AntiForgeryToken()
			<div class="mb-3">
				<label asp-for="Title" class="form-label"></label>
				<div class="input-group">
					<input asp-for="Title" id="Title" class="form-control" />
					<button type="button" class="btn btn-info" onclick="generateHeadlines()">
						Suggestions
					</button>
				</div>
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Slug" class="form-label"></label>
				<input asp-for="Slug" id="Slug" class="form-control" readonly style="background-color: #e9ecef;" />
				<span asp-validation-for="Slug" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Summary" class="form-label"></label>
				<textarea asp-for="Summary" id="Summary" class="form-control" rows="3"></textarea>
				<span asp-validation-for="Summary" class="text-danger"></span>
			</div>

			<!-- CATEGORY CONTROL (Moved Here with id="CategoryId") -->
			<div class="mb-3">
				<label asp-for="CategoryId" class="form-label">Category</label>
				<select asp-for="CategoryId" id="CategoryId" class="form-select" asp-items="ViewBag.Categories">
					<option value="">-- Select Category --</option>
				</select>
				<span asp-validation-for="CategoryId" class="text-danger"></span>
			</div>

			<div id="metaContainer" class="position-relative rounded p-2">

				<!-- LOADING SPINNER OVERLAY (Hidden by default) -->
				<div id="metaSpinner" class="position-absolute w-100 h-100 d-none justify-content-center align-items-center start-0 top-0 rounded"
					 style="background: rgba(255,255,255,0.7); z-index: 5;">
					<div class="text-center">
						<div class="spinner-border text-primary" role="status"></div>
						<div class="text-primary fw-bold mt-1" style="font-size: 0.85rem;">Gemini is writing metadata...</div>
					</div>
				</div>

				<!-- META TITLE -->
				<div class="mb-3">
					<label class="form-label fw-bold">Meta Title</label>
					<input asp-for="MetaTitle" id="MetaTitle" class="form-control" />
					<small class="text-muted d-block mt-1">
						<i class="bi bi-robot text-info"></i> AI generated. Feel free to tweak it if you want.
					</small>
				</div>

				<!-- META DESCRIPTION -->
				<div class="mb-3">
					<label class="form-label fw-bold">Meta Description</label>
					<textarea asp-for="MetaDescription" id="MetaDescription" class="form-control" rows="2"></textarea>
					<small class="text-muted d-block mt-1">
						<i class="bi bi-robot text-info"></i> AI generated. Feel free to tweak it if you want.
					</small>
				</div>
			</div>

			@* <div class="mb-3">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" id="editor" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div> *@

			<div class="mb-3">

				<div class="d-flex justify-content-between align-items-center mb-2">
					<label asp-for="Content" class="form-label mb-0"></label>

					<button type="button"
							id="btnCheckGrammar"
							class="btn btn-outline-primary">
						Check Grammar
					</button>
				</div>

				<input type="hidden" asp-for="Content" id="Content" />

				<div class="row g-3">

					<!-- LEFT: Editor column -->
					<div id="editorColumn" class="col-12">

						<!-- Your existing image/media controls -->
						<div class="mb-2">

							<button type="button"
									id="imgLeft"
									class="badge bg-dark">
								Image Left
							</button>

							<button type="button"
									id="imgCenter"
									class="badge bg-dark">
								Image Center
							</button>

							<button type="button"
									id="imgRight"
									class="badge bg-dark">
								Image Right
							</button> |
							<button type="button"
									id="imgSmall"
									class="badge bg-dark">
								Small
							</button>

							<button type="button"
									id="imgMedium"
									class="badge bg-dark">
								Medium
							</button>

							<button type="button"
									id="imgLarge"
									class="badge bg-dark">
								Large
							</button>

							<button type="button"
									id="imgFull"
									class="badge bg-dark">
								Full Width
							</button>
							<button type="button" id="btnSocialEmbed" class="badge bg-primary">
								⚡ Embed Social Code
							</button>
						</div>

						<div id="editor"></div>

						<span asp-validation-for="Content"
							  class="text-danger">
						</span>

					</div>
					<!-- END editorColumn -->
					<!-- RIGHT: Grammar panel column -->
					<div id="grammarPanelColumn"
						 class="col-lg-4 d-none">

						<div class="grammar-review-panel">

							<div class="d-flex justify-content-between align-items-center mb-3">
								<div>
									<h5 class="mb-1">
										Grammar Suggestions
									</h5>

									<small id="grammarIssueCount"
										   class="text-muted">
										No review performed
									</small>
								</div>

								<button type="button"
										id="btnCloseGrammar"
										class="btn-close"
										aria-label="Close">
								</button>
							</div>

							<div id="grammarLoading"
								 class="d-none py-4 text-center">

								<div class="spinner-border spinner-border-sm"
									 role="status">
								</div>

								<span class="ms-2">
									Checking content...
								</span>
							</div>

							<div id="grammarSuggestions">
								<div class="text-muted py-4 text-center">
									Click <strong>Check Grammar</strong>
									to review the article content.
								</div>
							</div>

							<div id="grammarActions"
								 class="d-none border-top mt-3 pt-3">

								<button type="button"
										id="btnApplyAllGrammar"
										class="btn btn-primary w-100">
									Apply All Suggestions
								</button>
							</div>

						</div>

					</div>
					<!-- END grammarPanelColumn -->

				</div>
				<!-- END Bootstrap row -->

			</div>

			<div class="mb-3">
				<label class="form-label">Featured Image</label>
				<input type="file" asp-for="ImageFile" class="form-control" />
				<span asp-validation-for="ImageFile" class="text-danger"></span>
			</div>

			<div class="row">
				<div class="col-md-6 mb-3">
					<label asp-for="FeaturedImageAltText" class="form-label">Featured Image Alt Text</label>
					<input asp-for="FeaturedImageAltText" class="form-control" />
				</div>
				<div class="col-md-6 mb-3">
					<label asp-for="FeaturedImageCredit" class="form-label">Featured Image Credit</label>
					<input asp-for="FeaturedImageCredit" class="form-control" />
				</div>
			</div>
			<div class="mb-3">
				<label asp-for="FeaturedImageCaption" class="form-label">Featured Image Caption</label>
				<input asp-for="FeaturedImageCaption" class="form-control" />
			</div>

			@await Html.PartialAsync("_TagEditor", null, new ViewDataDictionary(ViewData)
			{
				["InputName"] = nameof(Model.ArticleTagsInput),
				["InputId"] = nameof(Model.ArticleTagsInput),
				["Label"] = "Article Tags",
				["HelpText"] = "Tags support topic pages, search matching, related articles, and SEO keywords.",
				["ExistingValue"] = string.IsNullOrWhiteSpace(Model.ArticleTagsInput) ? "[]" : Model.ArticleTagsInput
			})

			@await Html.PartialAsync("_TagEditor", null, new ViewDataDictionary(ViewData)
			{
				["InputName"] = nameof(Model.FeaturedImageTagsInput),
				["InputId"] = nameof(Model.FeaturedImageTagsInput),
				["Label"] = "Featured Image Tags",
				["HelpText"] = "Image tags describe the visual content and enrich structured image metadata.",
				["ExistingValue"] = string.IsNullOrWhiteSpace(Model.FeaturedImageTagsInput) ? "[]" : Model.FeaturedImageTagsInput
			})

			@if (!string.IsNullOrEmpty(Model.FeaturedImageLarge))
			{
				<div class="mb-3">
					<img src="@Model.FeaturedImageLarge" alt="Current Image" class="img-fluid rounded" style="max-height:150px;" />
				</div>
			}



			<div class="card mt-4">
				<div class="card-header">
					Editorial Workflow
				</div>

				<div class="card-body">

					@if (canPublish)
					{
						<div class="form-check mb-3">
							<input asp-for="IsPublished"
								   class="form-check-input" />

							<label asp-for="IsPublished"
								   class="form-check-label">
								Publish Immediately
							</label>
						</div>
					}

					@if (canFactCheck)
					{
						<div class="form-check mb-3">
							<input asp-for="IsFactChecked"
								   class="form-check-input" />

							<label asp-for="IsFactChecked"
								   class="form-check-label">
								Fact Checked
							</label>
						</div>
					}

					@if (isSubEditor || isEditor || isAdmin)
					{
						<div class="mb-3">
							<label asp-for="EditorialPriority"
								   class="form-label">
								Editorial Priority
							</label>

							<select asp-for="EditorialPriority"
									class="form-select">
								@if (isSubEditor)
								{
									<option value="0">Normal</option>
									<option value="1">Important</option>
								}
								else
								{
									<option value="0">Normal</option>
									<option value="1">Important</option>
									<option value="2">High Priority</option>
									<option value="3">Critical</option>
								}
							</select>
						</div>
					}

					@if (canEditorsPick)
					{
						<div class="form-check mb-3">
							<input asp-for="IsEditorsPick"
								   class="form-check-input" />

							<label asp-for="IsEditorsPick"
								   class="form-check-label">
								Editor's Pick
							</label>
						</div>
					}

				</div>
			</div>
			@if (isAuthor)
			{
				<div class="form-check mb-3">
					<input asp-for="SubmitForReview"
						   class="form-check-input" />

					<label asp-for="SubmitForReview"
						   class="form-check-label">
						Submit For Editorial Review
					</label>
				</div>
			}


			<button type="submit" class="btn btn-success">
				<i class="bi bi-check-circle"></i> Save
			</button>
			<a asp-action="Index" class="btn btn-secondary ms-2">
				<i class="bi bi-arrow-left-circle"></i> Cancel
			</a>
		</form>
	</div>
</div>
@section Scripts
{
    <script src="~/js/tag-editor.js" asp-append-version="true"></script>

    <script>

        // ============================================================
        // HEADLINE GENERATION
        // ============================================================

        async function generateHeadlines() {

            const title = document.getElementById("Title").value;

            const res = await fetch('/admin/articles/generateheadlines', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(title)
            });

            const data = await res.json();

            let html = "<ul>";

            data.suggestions.forEach(s => {
                html += `<li onclick="useHeadline('${s}')">${s}</li>`;
            });

            html += "</ul>";

            document.getElementById("headlineSuggestions").innerHTML = html;
        }


        function useHeadline(text) {
            document.getElementById("Title").value = text;
        }


        // ============================================================
        // MAIN PAGE INITIALIZATION
        // ============================================================

        document.addEventListener('DOMContentLoaded', function () {


            // ========================================================
            // AUTO-FILL SLUG
            // ========================================================

            const titleInput = document.getElementById("Title");

            if (titleInput) {

                titleInput.addEventListener("blur", function () {

                    const titleValue = this.value;

                    if (titleValue.trim() !== "") {

                        const slugValue = titleValue
                            .toLowerCase()
                            .trim()
                            .replace(/[^a-z0-9\s-]/g, '')
                            .replace(/\s+/g, '-')
                            .replace(/-+/g, '-');

                        const slugInput =
                            document.getElementById("Slug");

                        if (slugInput) {
                            slugInput.value = slugValue;
                        }

                        const summaryInput =
                            document.getElementById("Summary");

                        if (summaryInput) {
                            summaryInput.focus();
                        }
                    }
                });
            }


            // ========================================================
            // GEMINI META TITLE / DESCRIPTION GENERATION
            // ========================================================

            const categoryInput =
                document.getElementById("CategoryId");

            if (categoryInput) {

                categoryInput.addEventListener(
                    "change",
                    async function () {

                        const title =
                            document.getElementById("Title")?.value;

                        const summary =
                            document.getElementById("Summary")?.value;

                        const categoryDropdown = this;

                        const categoryText =
                            categoryDropdown.options[
                                categoryDropdown.selectedIndex
                            ].text;

                        if (
                            !title ||
                            !summary ||
                            !categoryDropdown.value
                        ) {
                            return;
                        }

                        const spinner =
                            document.getElementById("metaSpinner");

                        const metaTitleInput =
                            document.getElementById("MetaTitle");

                        const metaDescInput =
                            document.getElementById("MetaDescription");

                        if (spinner) {
                            spinner.classList.remove("d-none");
                            spinner.classList.add("d-flex");
                        }

                        if (metaTitleInput) {
                            metaTitleInput.disabled = true;
                        }

                        if (metaDescInput) {
                            metaDescInput.disabled = true;
                        }

                        try {

                            const response = await fetch(
                                '/admin/articles/generatemetadata',
                                {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify({
                                        title: title,
                                        summary: summary,
                                        category: categoryText
                                    })
                                }
                            );

                            if (response.ok) {

                                const data =
                                    await response.json();

                                if (metaTitleInput) {
                                    metaTitleInput.value =
                                        data.metaTitle;
                                }

                                if (metaDescInput) {
                                    metaDescInput.value =
                                        data.metaDescription;
                                }
                            }
                            else {
                                console.error(
                                    "Failed to fetch meta data from Gemini."
                                );
                            }
                        }
                        catch (error) {

                            console.error(
                                "Error connecting to metadata generator endpoint:",
                                error
                            );
                        }
                        finally {

                            if (spinner) {
                                spinner.classList.remove("d-flex");
                                spinner.classList.add("d-none");
                            }

                            if (metaTitleInput) {
                                metaTitleInput.disabled = false;
                            }

                            if (metaDescInput) {
                                metaDescInput.disabled = false;
                            }

                            document
                                .getElementById("editor")
                                ?.focus();
                        }
                    }
                );
            }


            // ========================================================
            // QUILL IMPORTS
            // ========================================================

            const Parchment =
                Quill.import('parchment');

            const BlockEmbed =
                Quill.import('blots/block/embed');

            const ImageBlot =
                Quill.import('formats/image');

                const GrammarHighlightAttributor =
            new Parchment.ClassAttributor(
                'grammarHighlight',
                'grammar-highlight',
                {
                    scope: Parchment.Scope.INLINE
                }
            );


            // ========================================================
            // GRAMMAR HIGHLIGHT BLOT
            // Must be declared BEFORE Quill.register()
            // ========================================================

            Quill.register(
                GrammarHighlightAttributor,
                true
            );


            // ========================================================
            // IMAGE SIZE ATTRIBUTOR
            // ========================================================

            const ImageSizeAttributor =
                new Parchment.Attributor(
                    'data-size',
                    'data-size',
                    {
                        scope: Parchment.Scope.INLINE,

                        whitelist: [
                            'small',
                            'medium',
                            'large',
                            'full'
                        ]
                    }
                );

            Quill.register(
                ImageSizeAttributor,
                true
            );


            // ========================================================
            // SOCIAL EMBED BLOT
            // ========================================================

            class SocialEmbedBlot extends BlockEmbed {

                static create(value) {

                    const node = super.create();

                    node.setAttribute(
                        'class',
                        'quill-social-embed'
                    );

                    node.setAttribute(
                        'contenteditable',
                        'false'
                    );

                    node.setAttribute(
                        'data-raw-html',
                        btoa(
                            unescape(
                                encodeURIComponent(value)
                            )
                        )
                    );

                    let platformName = "Social Media";

                    const domainMatch = value.match(
                        /(?:www\.)?([a-zA-Z0-9-]+)\.(?:com|net|org|be)/i
                    );

                    if (
                        domainMatch &&
                        domainMatch[1]
                    ) {

                        platformName =
                            domainMatch[1]
                                .charAt(0)
                                .toUpperCase()
                            +
                            domainMatch[1].slice(1);

                        if (
                            platformName.toLowerCase() === 'youtu'
                        ) {
                            platformName = 'YouTube';
                        }

                        if (
                            platformName.toLowerCase() === 'fb'
                        ) {
                            platformName = 'Facebook';
                        }
                    }

                    node.innerHTML = `
                        <div class="embed-placeholder-box">

                            <span class="embed-icon">
                                🌐
                            </span>

                            <p class="embed-title">
                                ${platformName} Integration Widget
                            </p>

                            <small class="embed-subtitle">
                                The complete interactive embed will
                                render live on your main website
                            </small>

                        </div>
                    `;

                    return node;
                }


                static value(node) {

                    const encodedData =
                        node.getAttribute('data-raw-html');

                    if (encodedData) {

                        return decodeURIComponent(
                            escape(
                                atob(encodedData)
                            )
                        );
                    }

                    return node.innerHTML;
                }
            }

            SocialEmbedBlot.blotName =
                'socialEmbed';

            SocialEmbedBlot.tagName =
                'div';

            Quill.register(
                ImageBlot,
                true
            );

            Quill.register(
                SocialEmbedBlot,
                true
            );


            // ========================================================
            // QUILL INITIALIZATION
            // ========================================================

            const contentField =
                document.getElementById('Content');

            let selectedImage = null;


            const quill = new Quill('#editor', {

                theme: 'snow',

                modules: {

                    toolbar: [

                        [
                            {
                                header: [
                                    1,
                                    2,
                                    3,
                                    4,
                                    false
                                ]
                            }
                        ],

                        [
                            'bold',
                            'italic',
                            'underline',
                            'strike'
                        ],

                        [
                            { color: [] },
                            { background: [] }
                        ],

                        [
                            { align: [] }
                        ],

                        [
                            { list: 'ordered' },
                            { list: 'bullet' }
                        ],

                        [
                            'blockquote'
                        ],

                        [
                            'link',
                            'image'
                        ],

                        [
                            'clean'
                        ]
                    ]
                }
            });


            // Optional debugging access from DevTools
            window.quill = quill;


            // ========================================================
            // LOAD EXISTING CONTENT
            // ========================================================

            if (
                contentField &&
                contentField.value
            ) {

                quill.clipboard.dangerouslyPasteHTML(
                    contentField.value
                );
            }


            // ========================================================
            // IMAGE UPLOAD
            // ========================================================

            const toolbar =
                quill.getModule('toolbar');

            toolbar.addHandler(
                'image',
                imageHandler
            );


            async function imageHandler() {

                const input =
                    document.createElement('input');

                input.type = 'file';

                input.accept = 'image/*';

                input.click();


                input.onchange = async () => {

                    const file =
                        input.files[0];

                    if (!file) {
                        return;
                    }

                    const formData =
                        new FormData();

                    formData.append(
                        'upload',
                        file
                    );

                    try {

                        const token =
                            document.querySelector(
                                'input[name="__RequestVerificationToken"]'
                            )?.value;

                        const response = await fetch(
                            '/Admin/Articles/UploadEditorImage',
                            {
                                method: 'POST',

                                headers: {
                                    'RequestVerificationToken':
                                        token
                                },

                                body: formData
                            }
                        );

                        if (!response.ok) {
                            throw new Error(
                                'Upload failed'
                            );
                        }

                        const result =
                            await response.json();

                        const range =
                            quill.getSelection(true);

                        quill.insertEmbed(
                            range.index,
                            'image',
                            result.url
                        );

                        quill.setSelection(
                            range.index + 1
                        );
                    }
                    catch (error) {

                        console.error(error);

                        alert(
                            'Image upload failed.'
                        );
                    }
                };
            }


            // ========================================================
            // IMAGE SELECTION
            // ========================================================

            quill.root.addEventListener(
                'click',
                function (e) {

                    document
                        .querySelectorAll(
                            '.ql-editor img'
                        )
                        .forEach(img => {

                            img.classList.remove(
                                'selected-image'
                            );
                        });

                    if (
                        e.target.tagName === 'IMG'
                    ) {

                        selectedImage =
                            e.target;

                        selectedImage
                            .classList
                            .add(
                                'selected-image'
                            );
                    }
                    else {

                        selectedImage = null;
                    }
                }
            );


            // ========================================================
            // IMAGE ALIGNMENT
            // ========================================================

            const imgLeft =
                document.getElementById('imgLeft');

            const imgCenter =
                document.getElementById('imgCenter');

            const imgRight =
                document.getElementById('imgRight');


            function applyImageAlignment(
                alignmentClass
            ) {

                if (!selectedImage) {
                    return;
                }

                const parent =
                    selectedImage.parentElement;

                parent.classList.remove(
                    'ql-align-left',
                    'ql-align-center',
                    'ql-align-right'
                );

                parent.classList.add(
                    alignmentClass
                );
            }


            if (imgLeft) {

                imgLeft.addEventListener(
                    'click',
                    function () {

                        applyImageAlignment(
                            'ql-align-left'
                        );
                    }
                );
            }


            if (imgCenter) {

                imgCenter.addEventListener(
                    'click',
                    function () {

                        applyImageAlignment(
                            'ql-align-center'
                        );
                    }
                );
            }


            if (imgRight) {

                imgRight.addEventListener(
                    'click',
                    function () {

                        applyImageAlignment(
                            'ql-align-right'
                        );
                    }
                );
            }


            // ========================================================
            // IMAGE SIZE
            // ========================================================

            const imgSmall =
                document.getElementById('imgSmall');

            const imgMedium =
                document.getElementById('imgMedium');

            const imgLarge =
                document.getElementById('imgLarge');

            const imgFull =
                document.getElementById('imgFull');


            function applyImageSize(size) {

                if (!selectedImage) {
                    return;
                }

                selectedImage.setAttribute(
                    'data-size',
                    size
                );

                const blot =
                    Quill.find(selectedImage);

                if (blot) {

                    blot.format(
                        'data-size',
                        size
                    );

                    quill.update();

                    if (contentField) {

                        contentField.value =
                            cleanHtml(
                                quill.root.innerHTML
                            );
                    }
                }
            }


            if (imgSmall) {

                imgSmall.addEventListener(
                    'click',
                    () => applyImageSize('small')
                );
            }


            if (imgMedium) {

                imgMedium.addEventListener(
                    'click',
                    () => applyImageSize('medium')
                );
            }


            if (imgLarge) {

                imgLarge.addEventListener(
                    'click',
                    () => applyImageSize('large')
                );
            }


            if (imgFull) {

                imgFull.addEventListener(
                    'click',
                    () => applyImageSize('full')
                );
            }


            // ========================================================
            // SOCIAL EMBED INSERTION
            // ========================================================

            const btnSocialEmbed =
                document.getElementById(
                    'btnSocialEmbed'
                );

            if (btnSocialEmbed) {

                btnSocialEmbed.addEventListener(
                    'click',
                    function () {

                        const embedCode = prompt(
                            "Paste your full Social Media Embed Code:"
                        );

                        if (
                            embedCode &&
                            embedCode.trim() !== ''
                        ) {

                            const range =
                                quill.getSelection(true);

                            quill.insertEmbed(
                                range.index,
                                'socialEmbed',
                                embedCode.trim()
                            );

                            quill.setSelection(
                                range.index + 1
                            );
                        }
                    }
                );
            }


            // ========================================================
            // REMOVE SOCIAL EMBED
            // ========================================================

            quill.root.addEventListener(
                'dblclick',
                function (e) {

                    const embedWrapper =
                        e.target.closest(
                            '.quill-social-embed'
                        );

                    if (!embedWrapper) {
                        return;
                    }

                    const confirmDelete =
                        confirm(
                            "Do you want to remove this social media embed?"
                        );

                    if (!confirmDelete) {
                        return;
                    }

                    const blot =
                        Quill.find(embedWrapper);

                    if (blot) {

                        blot.remove();

                        quill.update();
                    }
                }
            );


            // ========================================================
            // GRAMMAR REVIEW ELEMENTS
            // ========================================================

            const btnCheckGrammar =
                document.getElementById(
                    'btnCheckGrammar'
                );

            const btnCloseGrammar =
                document.getElementById(
                    'btnCloseGrammar'
                );

            const btnApplyAllGrammar =
                document.getElementById(
                    'btnApplyAllGrammar'
                );

            const editorColumn =
                document.getElementById(
                    'editorColumn'
                );

            const grammarPanelColumn =
                document.getElementById(
                    'grammarPanelColumn'
                );

            const grammarLoading =
                document.getElementById(
                    'grammarLoading'
                );

            const grammarSuggestions =
                document.getElementById(
                    'grammarSuggestions'
                );

            const grammarIssueCount =
                document.getElementById(
                    'grammarIssueCount'
                );

            const grammarActions =
                document.getElementById(
                    'grammarActions'
                );

            
            let activeGrammarIssues = [];

            // ========================================================
            // CHECK GRAMMAR BUTTON
            // ========================================================

            if (btnCheckGrammar) {

                btnCheckGrammar.addEventListener(
                    'click',
                    async function () {

                        openGrammarPanel();

                        clearGrammarHighlights();

                        activeGrammarIssues = [];

                        grammarLoading
                            ?.classList
                            .remove('d-none');

                        if (grammarSuggestions) {
                            grammarSuggestions.innerHTML = '';
                        }

                        grammarActions
                            ?.classList
                            .add('d-none');

                        if (grammarIssueCount) {
                            grammarIssueCount.textContent =
                                'Checking content...';
                        }

                        btnCheckGrammar.disabled = true;

                        try {

                            const editorText = quill.getText();

                            if (!editorText.trim()) {

                                renderMockGrammarSuggestions([]);

                                grammarIssueCount.textContent =
                                    'No content to check';

                                return;
                            }

                            const token =
                                document.querySelector(
                                    'input[name="__RequestVerificationToken"]'
                                )?.value;

                            const response = await fetch(
                                '/Admin/Articles/CheckGrammar',
                                {
                                    method: 'POST',

                                    headers: {
                                        'Content-Type':
                                            'application/json',

                                        'RequestVerificationToken':
                                            token
                                    },

                                    body: JSON.stringify({
                                        text: editorText,
                                        language: 'en-US'
                                    })
                                }
                            );

                            if (!response.ok) {

                                const errorData =
                                    await response.json()
                                        .catch(() => null);

                                throw new Error(
                                    errorData?.message
                                    ?? 'Grammar check failed.'
                                );
                            }

                            const data =
                                await response.json();

                            activeGrammarIssues =
                                (data.issues ?? []).map(
                                    function (issue) {

                                        return {
                                            id: issue.id,

                                            category:
                                                issue.category,

                                            original:
                                                issue.original,

                                            replacement:
                                                issue.replacement,

                                            message:
                                                issue.message,

                                            ruleId:
                                                issue.ruleId,

                                            index:
                                                issue.offset,

                                            length:
                                                issue.length
                                        };
                                    }
                                );

                            refreshGrammarReview();
                        }
                        catch (error) {

                            console.error(
                                'Grammar check error:',
                                error
                            );

                            activeGrammarIssues = [];

                            clearGrammarHighlights();

                            if (grammarIssueCount) {
                                grammarIssueCount.textContent =
                                    'Grammar check failed';
                            }

                            if (grammarSuggestions) {

                                grammarSuggestions.innerHTML = `
                                    <div class="alert alert-danger mb-0">
                                        ${escapeHtml(
                                            error.message
                                            || 'Unable to check grammar.'
                                        )}
                                    </div>
                                `;
                            }

                            grammarActions
                                ?.classList
                                .add('d-none');
                        }
                        finally {

                            grammarLoading
                                ?.classList
                                .add('d-none');

                            btnCheckGrammar.disabled = false;
                        }
                    }
                );
            }
            if (btnApplyAllGrammar) {

                btnApplyAllGrammar.addEventListener(
                    'click',
                    function () {

                        applyAllGrammarIssues();
                    }
                );
            }
            if (grammarSuggestions) {

                grammarSuggestions.addEventListener(
                    'click',
                    function (e) {

                        // ----------------------------------------
                        // Apply one suggestion
                        // ----------------------------------------

                        const applyButton =
                            e.target.closest(
                                '.btn-apply-grammar'
                            );

                        if (applyButton) {

                            e.stopPropagation();

                            const issueId =
                                Number(
                                    applyButton.dataset.issueId
                                );

                            applyGrammarIssue(issueId);

                            return;
                        }


                        // ----------------------------------------
                        // Ignore one suggestion
                        // ----------------------------------------

                        const ignoreButton =
                            e.target.closest(
                                '.btn-ignore-grammar'
                            );

                        if (ignoreButton) {

                            e.stopPropagation();

                            const issueId =
                                Number(
                                    ignoreButton.dataset.issueId
                                );

                            ignoreGrammarIssue(issueId);
                        }
                    }
                );
            }

            // ========================================================
            // CLOSE GRAMMAR PANEL
            // ========================================================

            if (btnCloseGrammar) {

                btnCloseGrammar.addEventListener(
                    'click',
                    function () {

                        closeGrammarPanel();
                    }
                );
            }

            function openGrammarPanel() {

                if (
                    !editorColumn ||
                    !grammarPanelColumn
                ) {
                    return;
                }

                editorColumn.classList.remove(
                    'col-12'
                );

                editorColumn.classList.add(
                    'col-lg-8'
                );

                grammarPanelColumn.classList.remove(
                    'd-none'
                );
            }

            function closeGrammarPanel() {

                if (
                    !editorColumn ||
                    !grammarPanelColumn
                ) {
                    return;
                }

                grammarPanelColumn.classList.add(
                    'd-none'
                );

                editorColumn.classList.remove(
                    'col-lg-8'
                );

                editorColumn.classList.add(
                    'col-12'
                );
            }

            // ========================================================
            // FIND AND HIGHLIGHT MATCHING ISSUES
            // ========================================================

            function findAndHighlightGrammarIssues(
                issues
            ) {

                const editorText =
                    quill.getText();

                const matchedIssues = [];


                issues.forEach(function (issue) {

                    const index =
                        editorText.indexOf(
                            issue.original
                        );

                    if (index === -1) {
                        return;
                    }

                    const matchedIssue = {

                        ...issue,

                        index: index,

                        length:
                            issue.original.length
                    };


                    quill.formatText(

                        matchedIssue.index,

                        matchedIssue.length,

                        'grammarHighlight',

                        'error',
                        'silent'
                    );


                    matchedIssues.push(
                        matchedIssue
                    );
                });


                return matchedIssues;
            }

            // ========================================================
            // CLEAR GRAMMAR HIGHLIGHTS
            // ========================================================

            function clearGrammarHighlights() {

                const length =
                    quill.getLength();

                quill.formatText(

                    0,

                    length,

                    'grammarHighlight',

                    false,

                    'silent'
                );
            }

            // ========================================================
            // RENDER GRAMMAR SUGGESTIONS
            // ========================================================

            function renderMockGrammarSuggestions(
                issues
            ) {

                if (
                    !grammarSuggestions ||
                    !grammarIssueCount
                ) {
                    return;
                }

                grammarSuggestions.innerHTML = '';


                grammarIssueCount.textContent =
                    `${issues.length} issue${issues.length === 1 ? '' : 's'} found`;


                if (issues.length === 0) {

                    grammarSuggestions.innerHTML = `
                        <div class="alert alert-success mb-0">
                            No grammar issues found.
                        </div>
                    `;

                    grammarActions
                        ?.classList
                        .add('d-none');

                    return;
                }


                issues.forEach(function (issue) {

                    const suggestion =
                        document.createElement('div');

                    suggestion.className =
                        'grammar-suggestion';

                    suggestion.dataset.issueId =
                        issue.id;

                    suggestion.dataset.index =
                        issue.index;

                    suggestion.dataset.length =
                        issue.length;


                    suggestion.innerHTML = `

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <span class="badge text-bg-secondary">
                                ${issue.category}
                            </span>

                        </div>


                        <div class="mb-2">

                            <span class="grammar-suggestion-original">
                                ${issue.original}
                            </span>

                            <span class="mx-2">
                                →
                            </span>

                            <span class="grammar-suggestion-replacement text-success">
                                ${issue.replacement}
                            </span>

                        </div>


                        <div class="small text-muted mb-3">
                            ${issue.message}
                        </div>


                        <div class="d-flex gap-2">

                            <button
                                type="button"
                                class="btn btn-sm btn-primary btn-apply-grammar"
                                data-issue-id="${issue.id}">

                                Apply

                            </button>


                            <button
                                type="button"
                                class="btn btn-sm btn-outline-secondary btn-ignore-grammar"
                                data-issue-id="${issue.id}">

                                Ignore

                            </button>

                        </div>
                    `;


                    grammarSuggestions.appendChild(
                        suggestion
                    );


                    // Clicking card jumps to the error
                    suggestion.addEventListener(
                        'click',
                        function (e) {

                            if (
                                e.target.closest('button')
                            ) {
                                return;
                            }

                            const index =
                                Number(
                                    suggestion.dataset.index
                                );

                            const length =
                                Number(
                                    suggestion.dataset.length
                                );

                            quill.setSelection(
                                index,
                                length,
                                'silent'
                            );

                            quill.scrollSelectionIntoView();

                            quill.focus();
                        }
                    );
                });


                grammarActions
                    ?.classList
                    .remove('d-none');
            }

            function applyGrammarIssue(issueId) {

                const issueIndex =
                    activeGrammarIssues.findIndex(
                        issue => issue.id === issueId
                    );

                if (issueIndex === -1) {
                    return;
                }

                const issue =
                    activeGrammarIssues[issueIndex];

                // Verify that the expected text still exists
                // at the recorded position.
                const currentText =
                    quill.getText(
                        issue.index,
                        issue.length
                    );

                if (currentText !== issue.original) {

                    alert(
                        'The article content has changed since the grammar check. ' +
                        'Please run Check Grammar again.'
                    );

                    return;
                }

                // Remove the old text.
                quill.deleteText(
                    issue.index,
                    issue.length,
                    'user'
                );

                // Insert the suggested replacement.
                quill.insertText(
                    issue.index,
                    issue.replacement,
                    'user'
                );

                const lengthDifference =
                    issue.replacement.length -
                    issue.length;

                // Remove the applied issue.
                activeGrammarIssues.splice(
                    issueIndex,
                    1
                );

                // Update indexes of all issues located after it.
                activeGrammarIssues.forEach(
                    function (remainingIssue) {

                        if (
                            remainingIssue.index >
                            issue.index
                        ) {
                            remainingIssue.index +=
                                lengthDifference;
                        }
                    }
                );

                refreshGrammarReview();
            }

            function ignoreGrammarIssue(issueId) {

                const issueIndex =
                    activeGrammarIssues.findIndex(
                        issue => issue.id === issueId
                    );

                if (issueIndex === -1) {
                    return;
                }

                // Remove only this issue from the active review.
                // The Quill article text remains unchanged.
                activeGrammarIssues.splice(
                    issueIndex,
                    1
                );

            refreshGrammarReview();
            }

            function applyAllGrammarIssues() {

                if (activeGrammarIssues.length === 0) {
                    return;
                }

                // Create a copy so the active array is not changed
                // while corrections are being processed.
                const issuesToApply = [
                    ...activeGrammarIssues
                ];

                // Always process from the end of the article backwards.
                issuesToApply.sort(
                    (a, b) => b.index - a.index
                );

                // Verify all text before changing anything.
                const invalidIssue =
                    issuesToApply.find(function (issue) {

                        const currentText =
                            quill.getText(
                                issue.index,
                                issue.length
                            );

                        return currentText !== issue.original;
                    });

                if (invalidIssue) {

                    alert(
                        'The article content has changed since the grammar check. ' +
                        'Please run Check Grammar again.'
                    );

                    return;
                }

                // Apply all replacements.
                issuesToApply.forEach(
                    function (issue) {

                        quill.deleteText(
                            issue.index,
                            issue.length,
                            'user'
                        );

                        quill.insertText(
                            issue.index,
                            issue.replacement,
                            'user'
                        );
                    }
                );

                // All active suggestions have now been resolved.
                activeGrammarIssues = [];

                refreshGrammarReview();
            }

            function refreshGrammarReview() {

                clearGrammarHighlights();

                activeGrammarIssues.forEach(
                    function (issue) {

                        quill.formatText(
                            issue.index,
                            issue.length,
                            'grammarHighlight',
                            'error',
                            'silent'
                        );
                    }
                );

                renderMockGrammarSuggestions(
                    activeGrammarIssues
                );
            }

            function escapeHtml(value) {

                const div =
                    document.createElement('div');

                div.textContent =
                    value ?? '';

                return div.innerHTML;
            }
            // ========================================================
            // CONTENT SYNCHRONIZATION
            // ========================================================

            quill.on(
                'text-change',
                function () {

                    if (contentField) {

                        contentField.value =
                            cleanHtml(
                                quill.root.innerHTML
                            );
                    }
                }
            );


            // ========================================================
            // FORM SUBMISSION
            // ========================================================

            const form =
                document.querySelector('form');

            if (form) {

                form.addEventListener(
                    'submit',
                    function () {

                        if (contentField) {

                            contentField.value =
                                cleanHtml(
                                    quill.root.innerHTML
                                );
                        }
                    }
                );
            }


            // ========================================================
            // CLEAN HTML BEFORE SAVING
            // ========================================================

            function cleanHtml(html) {

                const div =
                    document.createElement('div');

                div.innerHTML = html;


                // Remove temporary image selection marker
                div.querySelectorAll('img')
                    .forEach(function (img) {

                        img.classList.remove(
                            'selected-image'
                        );
                    });


                // Remove temporary grammar review highlights
                div.querySelectorAll('[class*="grammar-highlight-"]')
                    .forEach(function (span) {

                        span.replaceWith(
                            ...span.childNodes
                        );
                });


                // Remove unwanted black text / white background spans
                div.querySelectorAll('span')
                    .forEach(function (span) {

                        const style =
                            span.getAttribute('style');

                        if (
                            style &&
                            style.includes(
                                'color: rgb(0, 0, 0)'
                            ) &&
                            style.includes(
                                'background-color: rgb(255, 255, 255)'
                            )
                        ) {

                            span.replaceWith(
                                ...span.childNodes
                            );
                        }
                    });


                return div.innerHTML;
            }

        });

    </script>
}
