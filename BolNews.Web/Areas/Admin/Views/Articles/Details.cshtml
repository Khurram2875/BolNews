@model BolNews.Web.Areas.Admin.ViewModels.ArticleVM

@{
    ViewData["Title"] = "Article Details";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h4 class="mb-0">Article Details</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Slug</dt>
            <dd class="col-sm-9">@Model.Slug</dd>

            <dt class="col-sm-3">Summary</dt>
            <dd class="col-sm-9">@Model.Summary</dd>

            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@Model.AuthorName</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.CategoryName</dd>

            <dt class="col-sm-3">Published At</dt>
            <dd class="col-sm-9">@Model.PublishedAt?.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.IsPublished ? "bg-success" : "bg-secondary")">
                    @(Model.IsPublished ? "Published" : "Draft")
                </span>
            </dd>

            <dt class="col-sm-3">Content</dt>
            <dd class="col-sm-9">
                <div class="bg-light rounded border p-3">
                    @Html.Raw(Model.Content)
                </div>
            </dd>

            @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
            {
                <dt class="col-sm-3">Featured Image</dt>
                <dd class="col-sm-9">
                    <img src="@Model.FeaturedImageUrl" alt="Featured Image" class="img-fluid rounded" />
                </dd>
            }
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>
</div>