@using BolNews.Web.Areas.Admin.ViewModels
@model ArticleDiscussionVM

@{
	ViewData["Title"] = "Editorial Discussion";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

	<div class="card mb-4 shadow-sm">
		<div class="card-header">
			Discussion Workspace
		</div>

		<div class="card-body">
			<div class="row">
				<div class="col-md-10">
					<h4>@Model.Title</h4>

					<div class="mb-2">
						<strong>Author:</strong> @Model.AuthorName
					</div>

					<div class="mb-3">
						<strong>Status:</strong> @Model.WorkflowStatus
					</div>

				</div>
				<div class="col-md-2">
					<img src="@Model.Thumbnail"
						 alt="@Model.Thumbnail"
						 itemprop="image"
						 style="width:240px;height:120px;border-radius:05%;object-fit:cover;flex-shrink:0;"
						 loading="lazy" />
				</div>
			</div>

		</div>
	</div>

	<div class="card shadow-sm">
		<div class="card-header">
			Editorial Discussion
		</div>

		<div class="card-body">
			<div id="discussionThread" class="discussion-thread">

				@if (Model.DiscussionComments.Any())
				{
					foreach (var comment in Model.DiscussionComments)
					{
						<div class="discussion-row @(comment.IsCurrentUser ? "mine" : "theirs")">

							<div class="discussion-bubble @(comment.IsCurrentUser ? "mine-bubble" : "their-bubble")">

								<div class="discussion-header">
									@if (!comment.IsCurrentUser)
									{
										<span class="discussion-user">
											@comment.UserName
										</span>
									}

									<span class="discussion-time">
										@comment.CreatedAt.ToLocalTime().ToString("g")
									</span>
								</div>

								<div class="discussion-message">
									@comment.Message
								</div>

							</div>
						</div>
					}
				}
				else
				{
					<div class="text-muted small">
						No discussion yet.
					</div>
				}

			</div>
			<form asp-action="AddDiscussionComment" method="post">

				@Html.AntiForgeryToken()

				<input type="hidden"
					   name="articleId"
					   value="@Model.ArticleId" />

				<div class="mb-3">
					<textarea name="message"
							  class="form-control"
							  rows="4"
							  required></textarea>
				</div>

				<button type="submit"
						class="btn btn-primary">
					Post Comment
				</button>

			</form>

		</div>
	</div>
</div>
@section Scripts
{
	<script>
		function scrollDiscussionToBottom(smooth = true) {
			const thread = document.getElementById("discussionThread");

			if (!thread)
				return;

			thread.scrollTo({
				top: thread.scrollHeight,
				behavior: smooth ? "smooth" : "auto"
			});
		}

		function attachDiscussionListener() {

			if (!window.notificationConnection) {
				setTimeout(attachDiscussionListener, 500);
				return;
			}

			console.log("Discussion SignalR listener attaching");

			window.notificationConnection.off("DiscussionUpdated");

			window.notificationConnection.on("DiscussionUpdated", function (data) {

				console.log("DiscussionUpdated EVENT RECEIVED", data);

				const thread =
					document.getElementById("discussionThread");

				if (!thread) {
					console.error("discussion thread missing");
					return;
				}

				const html = `
					<div class="discussion-row theirs">
						<div class="discussion-bubble their-bubble">
							<div class="discussion-header">
								<span class="discussion-user">${data.userName}</span>
								<span class="discussion-time">${data.createdAt}</span>
							</div>
							<div class="discussion-message">
								${data.message}
							</div>
						</div>
					</div>
				`;

				thread.insertAdjacentHTML("beforeend", html);

				scrollDiscussionToBottom();
			});
		}

		document.addEventListener("DOMContentLoaded", function () {
			attachDiscussionListener();

			// Initial load jump directly to latest message
			scrollDiscussionToBottom(false);
		});
	</script>
}
