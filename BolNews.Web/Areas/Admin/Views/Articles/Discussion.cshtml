@using BolNews.Web.Areas.Admin.ViewModels
@model ArticleDiscussionVM

@{
	ViewData["Title"] = "Editorial Discussion";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

	<div class="card mb-4 shadow-sm">
		
		<div class="card-header">
			Discussion Workspace
		</div>

		<div class="card-body">
			<div class="row">
				<div class="col-md-9">
					<h4>@Model.Title</h4>

					<div class="mb-2">
						<strong>Author:</strong> @Model.AuthorName
					</div>

					<div class="mb-3">
						<strong>Status:</strong> @Model.WorkflowStatus
					</div>

				</div>
				<div class="col-md-3">
					<img src="@Model.Thumbnail"
						 alt="@Model.Thumbnail"
						 itemprop="image"
						 style="width:240px;height:120px;border-radius:05%;object-fit:cover;flex-shrink:0;"
						 loading="lazy" />
				</div>
			</div>

		</div>
	</div>
	
			
		
	<div class="card shadow-sm">
		<div class="card-header d-flex justify-content-between align-items-center">
			<span>Editorial Discussion</span>

			<div>
				<small id="discussionPresence"
					   class="text-success fw-semibold">
					🟢 1 online
				</small>
			</div>
		</div>

		<div class="card-body">
			<div id="discussionThread" class="discussion-thread">

				@if (Model.DiscussionComments.Any())
				{
					foreach (var comment in Model.DiscussionComments)
					{
						<div class="discussion-row @(comment.IsCurrentUser ? "mine" : "theirs")">

							<div class="discussion-bubble @(comment.IsCurrentUser ? "mine-bubble" : "their-bubble")">

								<div class="discussion-header">
									@if (!comment.IsCurrentUser)
									{
										<span class="discussion-user">
											@comment.UserName
										</span>
									}

									<span class="discussion-time">
										@comment.CreatedAt.ToLocalTime().ToString("g")
									</span>
								</div>

								<div class="discussion-message">
									@comment.Message
								</div>

							</div>
						</div>
					}
				}
				else
				{
					<div class="text-muted small">
						No discussion yet.
					</div>
				}

			</div>
			<div id="typingIndicator"
				 class="small text-muted px-2 py-1"
				 style="min-height: 24px;">
			</div>
			<form asp-action="AddDiscussionComment" method="post">

				@Html.AntiForgeryToken()

				<input type="hidden"
					   name="articleId"
					   value="@Model.ArticleId" />

				<div class="d-flex align-items-end mt-3 gap-2">

					<textarea id="discussionMessage"
							  name="message"
							  class="form-control"
							  rows="2"
							  placeholder="Type a message..."
							  required></textarea>

					<button id="sendDiscussionBtn"
							type="submit"
							class="btn btn-primary px-4">
						Send
					</button>

				</div>

			</form>

		</div>
	</div>
</div>
@section Scripts
{
	<script>
		let typingTimeout = null;

		function escapeDiscussionHtml(value) {
			return (value || "")
				.replaceAll("&", "&amp;")
				.replaceAll("<", "&lt;")
				.replaceAll(">", "&gt;")
				.replaceAll("\"", "&quot;")
				.replaceAll("'", "&#039;");
		}

		function invokeDiscussionHub(methodName, articleId) {
			if (typeof signalR === "undefined") {
				return Promise.resolve();
			}

			if (!window.notificationConnection ||
				window.notificationConnection.state !== signalR.HubConnectionState.Connected) {
				return Promise.resolve();
			}

			return window.notificationConnection
				.invoke(methodName, articleId)
				.catch(function (err) {
					console.warn(`${methodName} SignalR call failed`, err);
				});
		}

		function scrollDiscussionToBottom(smooth = true) {
			const thread = document.getElementById("discussionThread");

			if (!thread) return;

			thread.scrollTo({
				top: thread.scrollHeight,
				behavior: smooth ? "smooth" : "auto"
			});
		}

		function wireDiscussionEvents(articleId) {

			window.notificationConnection.off("DiscussionUpdated");
			window.notificationConnection.off("DiscussionPresenceUpdated");
			window.notificationConnection.off("DiscussionTypingStarted");
			window.notificationConnection.off("DiscussionTypingStopped");

			// MESSAGE RECEIVE
			window.notificationConnection.on("DiscussionUpdated", function (data) {
				const thread = document.getElementById("discussionThread");
				if (!thread) return;

				const html = `
					<div class="discussion-row theirs">
						<div class="discussion-bubble their-bubble">
							<div class="discussion-header">
								<span class="discussion-user">${escapeDiscussionHtml(data.userName)}</span>
								<span class="discussion-time">${escapeDiscussionHtml(data.createdAt)}</span>
							</div>
							<div class="discussion-message">
								${escapeDiscussionHtml(data.message)}
							</div>
						</div>
					</div>
				`;

				thread.insertAdjacentHTML("beforeend", html);
				scrollDiscussionToBottom();
			});

			// PRESENCE
			window.notificationConnection.on("DiscussionPresenceUpdated", function (count) {
				const presence = document.getElementById("discussionPresence");
				if (presence) {
					presence.innerText = `🟢 ${count} online`;
				}
			});

			// TYPING START
			window.notificationConnection.on("DiscussionTypingStarted", function (userName) {
				console.log("Typing started from:", userName);

				const indicator = document.getElementById("typingIndicator");
				if (indicator) {
					indicator.innerText = `${userName || "Newsroom User"} is typing...`;
				}
			});

			// TYPING STOP
			window.notificationConnection.on("DiscussionTypingStopped", function () {
				console.log("Typing stopped");

				const indicator = document.getElementById("typingIndicator");
				if (indicator) {
					indicator.innerText = "";
				}
			});

			invokeDiscussionHub("JoinDiscussion", articleId);
		}

		function attachDiscussion() {

				if (!window.notificationConnection || !window.notificationConnectionReady) {
			setTimeout(attachDiscussion, 200);
			return;
		}

		const articleId = "@Model.ArticleId";

		window.notificationConnectionReady
			.then(function () {
				wireDiscussionEvents(articleId);
			})
			.catch(err => console.error("Discussion connection failed:", err));

			const textarea = document.getElementById("discussionMessage");
			const sendBtn = document.getElementById("sendDiscussionBtn");

			if (textarea) {

				textarea.addEventListener("keydown", function (e) {
					if (e.key === "Enter" && !e.shiftKey) {
						e.preventDefault();

						const message = textarea.value.trim();
						if (!message) return;

						invokeDiscussionHub("TypingStopped", articleId);

						sendBtn.click();
					}
				});

				textarea.addEventListener("input", function () {
					const message = textarea.value.trim();

					if (!message) {
						invokeDiscussionHub("TypingStopped", articleId);
						return;
					}

					invokeDiscussionHub("TypingStarted", articleId);

					clearTimeout(typingTimeout);

					typingTimeout = setTimeout(function () {
						invokeDiscussionHub("TypingStopped", articleId);
					}, 1200);
				});
			}

			window.addEventListener("beforeunload", function () {
				invokeDiscussionHub("LeaveDiscussion", articleId);
			});
		}

		document.addEventListener("DOMContentLoaded", function () {
			attachDiscussion();
			scrollDiscussionToBottom(false);
		});
	</script>
}

<style>
	.discussion-thread {
		height: 500px;
		overflow-y: auto;
		padding: 14px;
		background: #f8fafc;
		border-radius: 12px;
		scroll-behavior: smooth;
	}

	.discussion-row {
		display: flex;
		margin-bottom: 12px;
	}

		.discussion-row.mine {
			justify-content: flex-end;
		}

		.discussion-row.theirs {
			justify-content: flex-start;
		}

	.discussion-bubble {
		max-width: 72%;
		padding: 10px 14px;
		border-radius: 16px;
		box-shadow: 0 2px 6px rgba(0,0,0,0.06);
	}

	.mine-bubble {
		background: #dbeafe;
		border-bottom-right-radius: 4px;
	}

	.their-bubble {
		background: #ffffff;
		border-bottom-left-radius: 4px;
		border: 1px solid #e5e7eb;
	}

	.discussion-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 6px;
		gap: 10px;
	}

	.discussion-user {
		font-size: 0.78rem;
		font-weight: 600;
		color: #374151;
	}

	.discussion-time {
		font-size: 0.68rem;
		color: #6b7280;
		white-space: nowrap;
	}

	.discussion-message {
		font-size: 0.88rem;
		line-height: 1.45;
		color: #111827;
		white-space: pre-wrap;
		word-break: break-word;
		
	}

	#discussionMessage {
		resize: none;
	}
</style>
