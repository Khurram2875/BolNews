<style>
	.discussion-thread {
		height: 550px;
		overflow-y: auto;
		padding: 14px;
		background: #f8fafc;
		border-radius: 12px;
		scroll-behavior: smooth;
	}

	.discussion-row {
		display: flex;
		margin-bottom: 12px;
	}

		.discussion-row.mine {
			justify-content: flex-end;
		}

		.discussion-row.theirs {
			justify-content: flex-start;
		}

	.discussion-bubble {
		max-width: 72%;
		padding: 10px 14px;
		border-radius: 16px;
		box-shadow: 0 2px 6px rgba(0,0,0,0.06);
	}

	.mine-bubble {
		background: #dbeafe;
		border-bottom-right-radius: 4px;
	}

	.their-bubble {
		background: #ffffff;
		border-bottom-left-radius: 4px;
		border: 1px solid #e5e7eb;
	}

	.discussion-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 6px;
		gap: 10px;
	}

	.discussion-user {
		font-size: 0.78rem;
		font-weight: 600;
		color: #374151;
	}

	.discussion-time {
		font-size: 0.68rem;
		color: #6b7280;
		white-space: nowrap;
	}

	.discussion-message {
		font-size: 0.88rem;
		line-height: 1.45;
		color: #111827;
		white-space: pre-wrap;
		word-break: break-word;
	}
</style>