@model BolNews.Web.Areas.Admin.ViewModels.ArticleVM

@{
    ViewData["Title"] = "Edit Article";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="card mt-3 p-3">
    <h5>
        Discover Score: @Model.DiscoverScore?.Score / 100
    </h5>

    @if (Model.DiscoverScore != null && Model.DiscoverScore.Suggestions.Any())
    {
        <ul class="text-danger">
            @foreach (var suggestion in Model.DiscoverScore.Suggestions)
            {
                <li>@suggestion</li>
            }
        </ul>
    }
    else
    {
        <p class="text-success">✅ Fully optimized for Discover</p>
    }
</div>
<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0">Edit Article</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <!-- same fields as Create view -->
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Meta Title</label>
                <input asp-for="MetaTitle" class="form-control" />
                <span asp-validation-for="MetaTitle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Meta Description</label>
                <textarea asp-for="MetaDescription" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Summary" class="form-label"></label>
                <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" id="editor" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Featured Image</label>
                <input type="file" asp-for="ImageFile" class="form-control" onchange="previewFile(event)" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            @* @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
            {
                <div class="mb-3">
                    <img id="previewImage" src="@Model.FeaturedImageUrl" alt="Current Image" class="img-fluid rounded" style="max-height:150px;" />
                </div>
            } *@
            <div class="form-group mb-3">
                <label>Current Image</label><br />

                @if (!string.IsNullOrEmpty(Model.FeaturedImageLarge))
                {
                    <img id="previewImage"
                         src="@Model.FeaturedImageLarge"
                        
                         style="width:120px; height:120px; object-fit:cover; border-radius:50%;" />
                }
                else
                {
                    <img id="previewImage"
                         src="/images/default-user.png"
                         style="width:120px; height:120px; border-radius:50%;" />
                }
            </div>
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Author</label>
                <input value="@Model.AuthorName" readonly class="form-control" />
                
            </div>

            <div class="mb-3">
                <label asp-for="PublishedAt" class="form-label"></label>
                <input asp-for="PublishedAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="PublishedAt" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsPublished" class="form-check-input" />
                <label asp-for="IsPublished" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Update
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="bi bi-arrow-left-circle"></i> Cancel
            </a>
        </form>
    </div>
</div>
