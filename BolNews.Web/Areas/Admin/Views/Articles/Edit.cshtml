@using BolNews.Domain.Common
@using BolNews.Domain.Enums
@using System.Text.Json
@model BolNews.Web.Areas.Admin.ViewModels.ArticleVM
<link href="~/css/site.css" rel="stylesheet" />
@{
	ViewData["Title"] = "Edit Article";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

	var isAdmin = User.IsInRole(Roles.Admin);
	var isEditor = User.IsInRole(Roles.Editor);
	var isSubEditor = User.IsInRole(Roles.SubEditor);
	var isAuthor = User.IsInRole(Roles.Author);

	var canPublish = isAdmin || isEditor || isSubEditor;
	var canEditorsPick = isAdmin || isEditor;
	var canFactCheck = isAdmin || isEditor || isSubEditor;
}
<div class="alert alert-info">
	<strong>Editing Lock Active</strong><br />
	This article is currently locked for your editing session.
</div>
<div class="card mt-3 p-3">
	<h5>
		Discover Score: @Model.DiscoverScore?.Score / 100
	</h5>

	@if (Model.DiscoverScore != null && Model.DiscoverScore.Suggestions.Any())
	{
		<ul class="text-danger">
			@foreach (var suggestion in Model.DiscoverScore.Suggestions)
			{
				<li>@suggestion</li>
			}
		</ul>
	}
	else
	{
		<p class="text-success">✅ Fully optimized for Discover</p>
	}
</div>

<div class="card shadow-sm">
	<div class="card-header bg-warning text-dark">
		<h4 class="mb-0">Edit Article <span class="badge bg-success" style="font-size:x-small">by @Model.AuthorName</span></h4>
	</div>

	<div class="card-body">
		<form asp-action="Edit" method="post" enctype="multipart/form-data">

			<input type="hidden" asp-for="Id" />

			<div class="mb-3">
				<label asp-for="Title" class="form-label"></label>
				<input asp-for="Title" class="form-control" />
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Slug" class="form-label"></label>
				<input asp-for="Slug" class="form-control" />
				<span asp-validation-for="Slug" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="MetaTitle" class="form-label"></label>
				<input asp-for="MetaTitle" class="form-control" />
				<span asp-validation-for="MetaTitle" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="MetaDescription" class="form-label"></label>
				<textarea asp-for="MetaDescription" class="form-control"></textarea>
				<span asp-validation-for="MetaDescription" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Summary" class="form-label"></label>
				<textarea asp-for="Summary" class="form-control" rows="3"></textarea>
				<span asp-validation-for="Summary" class="text-danger"></span>
			</div>

			@* <div class="mb-3">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" id="editor" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div> *@

			<div class="mb-3">

				<div class="d-flex justify-content-between align-items-center mb-2">

					<label asp-for="Content"
						   class="form-label mb-0">
					</label>

					<button type="button"
							id="btnCheckGrammar"
							class="btn btn-outline-primary">
						Check Grammar
					</button>

				</div>

				<input type="hidden"
					   asp-for="Content"
					   id="Content" />

				<div class="row g-3">

					<!-- LEFT: Quill editor -->
					<div id="editorColumn"
						 class="col-12">

						<div class="mb-2">

							<button type="button"
									id="imgLeft"
									class="badge bg-dark">
								Image Left
							</button>

							<button type="button"
									id="imgCenter"
									class="badge bg-dark">
								Image Center
							</button>

							<button type="button"
									id="imgRight"
									class="badge bg-dark">
								Image Right
							</button>

							|

							<button type="button"
									id="imgSmall"
									class="badge bg-dark">
								Small
							</button>

							<button type="button"
									id="imgMedium"
									class="badge bg-dark">
								Medium
							</button>

							<button type="button"
									id="imgLarge"
									class="badge bg-dark">
								Large
							</button>

							<button type="button"
									id="imgFull"
									class="badge bg-dark">
								Full Width
							</button>

							<button type="button"
									id="btnSocialEmbed"
									class="badge bg-primary">
								⚡ Embed Social Code
							</button>

						</div>

						<div id="editor"></div>

						<span asp-validation-for="Content"
							  class="text-danger">
						</span>

					</div>


					<!-- RIGHT: Grammar review -->
					<div id="grammarPanelColumn"
						 class="col-lg-4 d-none">

						<div class="grammar-review-panel">

							<div class="d-flex justify-content-between align-items-center mb-3">

								<div>
									<h5 class="mb-1">
										Grammar Suggestions
									</h5>

									<small id="grammarIssueCount"
										   class="text-muted">
										No review performed
									</small>
								</div>

								<button type="button"
										id="btnCloseGrammar"
										class="btn-close"
										aria-label="Close">
								</button>

							</div>


							<div id="grammarLoading"
								 class="d-none py-4 text-center">

								<div class="spinner-border spinner-border-sm"
									 role="status">
								</div>

								<span class="ms-2">
									Checking content...
								</span>

							</div>


							<div id="grammarSuggestions">

								<div class="text-muted py-4 text-center">
									Click <strong>Check Grammar</strong>
									to review the article content.
								</div>

							</div>


							<div id="grammarActions"
								 class="d-none border-top mt-3 pt-3">

								<button type="button"
										id="btnApplyAllGrammar"
										class="btn btn-primary w-100">
									Apply All Suggestions
								</button>

							</div>

						</div>

					</div>

				</div>

			</div>
			@if (canPublish || canFactCheck || canEditorsPick || isSubEditor)
			{
				<div class="card mt-4">
					<div class="card-header">
						Editorial Workflow
					</div>

					<div class="card-body">

						@if (canPublish)
						{
							<div class="form-check mb-3">
								<input asp-for="IsPublished" class="form-check-input" />
								<label asp-for="IsPublished" class="form-check-label">
									Published
								</label>
							</div>

							@if (Model.PublishedAt.HasValue)
							{
								<div class="mb-3">
									<label class="form-label">Published At</label>
									<input type="text"
										   class="form-control"
										   value="@Model.PublishedAt.Value.ToString("g")"
										   readonly />
								</div>
							}
						}

						@if (canFactCheck)
						{
							<div class="form-check mb-3">
								<input asp-for="IsFactChecked" class="form-check-input" />
								<label asp-for="IsFactChecked" class="form-check-label">
									Fact Checked
								</label>
							</div>
						}

						@if (isSubEditor || isEditor || isAdmin)
						{
							<div class="mb-3">
								<label asp-for="EditorialPriority" class="form-label"></label>

								<select asp-for="EditorialPriority" class="form-select">
									@if (isSubEditor)
									{
										<option value="0">Normal</option>
										<option value="1">Important</option>
									}
									else
									{
										<option value="0">Normal</option>
										<option value="1">Important</option>
										<option value="2">High Priority</option>
										<option value="3">Critical</option>
									}
								</select>
							</div>
						}

						@if (canEditorsPick)
						{
							<div class="form-check mb-3">
								<input asp-for="IsEditorsPick" class="form-check-input" />
								<label asp-for="IsEditorsPick" class="form-check-label">
									Editor's Pick
								</label>
							</div>
						}

					</div>
				</div>
			}

			<div class="mb-3">
				<label class="form-label">Featured Image</label>
				<input asp-for="FeaturedMediaId" type="hidden" />
				<button type="button" class="btn btn-outline-primary btn-sm mb-2" data-media-picker="featured">Choose from Media Library</button>
				<input type="file"
					   asp-for="ImageFile"
					   class="form-control"
					   onchange="previewFile(event)" />
				<span asp-validation-for="ImageFile" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label>Current Image</label><br />

				@if (!string.IsNullOrEmpty(Model.FeaturedImageLarge))
				{
					<img id="previewImage"
						 src="@Model.FeaturedImageLarge"
						 style="width:120px; height:120px; object-fit:cover; border-radius:50%;" />
				}
				else
				{
					<img id="previewImage"
						 src="/images/default-user.png"
						 style="width:120px; height:120px; border-radius:50%;" />
				}
			</div>

			<div class="row">
				<div class="col-md-6 mb-3">
					<label asp-for="FeaturedImageAltText" class="form-label">Featured Image Alt Text</label>
					<input asp-for="FeaturedImageAltText" class="form-control" />
				</div>
				<div class="col-md-6 mb-3">
					<label asp-for="FeaturedImageCredit" class="form-label">Featured Image Credit</label>
					<input asp-for="FeaturedImageCredit" class="form-control" />
				</div>
			</div>
			<div class="mb-3">
				<label asp-for="FeaturedImageCaption" class="form-label">Featured Image Caption</label>
				<input asp-for="FeaturedImageCaption" class="form-control" />
			</div>

			@await Html.PartialAsync("_TagEditor", null, new ViewDataDictionary(ViewData)
			{
				["InputName"] = nameof(Model.ArticleTagsInput),
				["InputId"] = nameof(Model.ArticleTagsInput),
				["Label"] = "Article Tags",
				["HelpText"] = "Tags support topic pages, search matching, related articles, and SEO keywords.",
				["ExistingValue"] = string.IsNullOrWhiteSpace(Model.ArticleTagsInput) ? JsonSerializer.Serialize(Model.ArticleTags.Select(x => x.Name)) : Model.ArticleTagsInput
			})

			@await Html.PartialAsync("_TagEditor", null, new ViewDataDictionary(ViewData)
			{
				["InputName"] = nameof(Model.FeaturedImageTagsInput),
				["InputId"] = nameof(Model.FeaturedImageTagsInput),
				["Label"] = "Featured Image Tags",
				["HelpText"] = "Image tags describe the visual content and enrich structured image metadata.",
				["ExistingValue"] = string.IsNullOrWhiteSpace(Model.FeaturedImageTagsInput) ? JsonSerializer.Serialize(Model.FeaturedImageTags.Select(x => x.Name)) : Model.FeaturedImageTagsInput
			})

			<div class="mb-3">
				<label asp-for="CategoryId" class="form-label"></label>
				<select asp-for="CategoryId"
						class="form-select"
						asp-items="ViewBag.Categories"></select>
				<span asp-validation-for="CategoryId" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="ReporterId" class="form-label">Reporter / Source</label>
				<select asp-for="ReporterId"
						class="form-select"
						asp-items="ViewBag.Reporters">
					<option value="">-- Select Reporter / Source --</option>
				</select>
				<span asp-validation-for="ReporterId" class="text-danger"></span>
			</div>

			@*  @if (!isAuthor)
            {
                <div class="mb-3">
                    <label>Author</label>
                    <input value="@Model.AuthorName"
                           readonly
                           class="form-control" />
                </div>
            } *@
			@if (isAuthor && Model.WorkflowStatus == ArticleWorkflowStatus.Rejected)
			{
				<div class="alert alert-danger mb-3">
					<strong>Editorial Review Rejected</strong>

					@if (!string.IsNullOrWhiteSpace(Model.WorkflowComment))
					{
						<div class="mt-2">
							Reason: @Model.WorkflowComment
						</div>
					}

					<div class="mt-2">
						Please revise and resubmit.
					</div>
				</div>

				<div class="form-check mb-3">
					<input asp-for="SubmitForReview"
						   class="form-check-input" />

					<label asp-for="SubmitForReview"
						   class="form-check-label">
						Submit For Editorial Review
					</label>
				</div>
			}
			else if (isAuthor && Model.WorkflowStatus == ArticleWorkflowStatus.Draft)
			{
				<div class="form-check mb-3">
					<input asp-for="SubmitForReview"
						   class="form-check-input" />

					<label asp-for="SubmitForReview"
						   class="form-check-label">
						Submit For Editorial Review
					</label>
				</div>
			}
			else if (isAuthor && Model.WorkflowStatus == ArticleWorkflowStatus.Submitted)
			{
				<div class="alert alert-info">
					This article has already been submitted for editorial review.
				</div>
			}

			@if (Model.ScheduledPublishAt.HasValue)
			{
				<div class="alert alert-info mt-3">
					This article is scheduled for publication at
					<strong>@Model.ScheduledPublishAt.Value.ToLocalTime()</strong>
				</div>
			}
			@if (Model.EmbargoUntil.HasValue)
			{
				<div class="alert alert-warning mt-2">
					Public access blocked until
					<strong>@Model.EmbargoUntil.Value.ToLocalTime()</strong>
				</div>
			}
			<button type="submit" class="btn btn-warning">
				<i class="bi bi-pencil-square"></i> Update
			</button>

			<a asp-action="Index" class="btn btn-secondary ms-2">
				<i class="bi bi-arrow-left-circle"></i> Cancel
			</a>

		</form>
	</div>
</div>
@await Html.PartialAsync("_MediaLibraryPicker")

@section Scripts
{
	<script src="~/js/tag-editor.js" asp-append-version="true"></script>
	<script>
		// System Lock Management Call Interval
		setInterval(function () {
			fetch('/Admin/Article/RefreshLock?id=@Model.Id', {
				method: 'POST',
				headers: {
					'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
				}
			});
		}, 300000);

		window.addEventListener('beforeunload', function () {
			navigator.sendBeacon('/Admin/Article/ReleaseLock?id=@Model.Id');
		});
	</script>

	<script src="~/js/article-editor.js" asp-append-version="true"></script>
	<script src="~/js/media-library-picker.js" asp-append-version="true"></script>
}
