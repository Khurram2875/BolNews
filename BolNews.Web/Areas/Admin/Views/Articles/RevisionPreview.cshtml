@model BolNews.Web.Areas.Admin.ViewModels.ArticleRevisionPreviewVM

@{
    ViewData["Title"] = "Revision Snapshot";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="alert alert-warning">
    <strong>Editorial snapshot only.</strong>
    This is revision #@Model.Revision.RevisionNumber saved on
    @Model.Revision.CreatedAt.ToLocalTime().ToString("g") by
    @Model.ChangedByName. It is not a public article page.
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-1">@Model.Revision.Title</h2>
        <div class="text-muted">
            Workflow: @Model.Revision.WorkflowState
        </div>
    </div>

    <div>
        <a asp-action="CompareRevision"
           asp-route-articleId="@Model.Article.Id"
           asp-route-revisionId="@Model.Revision.Id"
           asp-route-target="current"
           class="btn btn-primary">
            Compare Current
        </a>

        <a asp-action="Revisions"
           asp-route-id="@Model.Article.Id"
           class="btn btn-secondary ms-2">
            Back
        </a>
    </div>
</div>

<div class="card shadow-sm">
    @if (!string.IsNullOrWhiteSpace(Model.Revision.FeaturedImageLarge))
    {
        <img src="@Model.Revision.FeaturedImageLarge"
             class="card-img-top"
             style="max-height:360px; object-fit:cover;"
             alt="@Model.Revision.Title" />
    }

    <div class="card-body">
        <p class="lead">@Model.Revision.Summary</p>

        <hr />

        <div class="bn-article-body">
            @Html.Raw(Model.Revision.Content)
        </div>
    </div>
</div>
