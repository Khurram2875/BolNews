@using BolNews.Application.DTOs
@using BolNews.Infrastructure.Services.WordPressMigration

@{
    ViewData["Title"] = "WordPress Migration";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var result =
        ViewBag.Result as WordPressImportResultDto;

    var error =
        ViewBag.Error as string;

    var migrationState =
        ViewBag.MigrationState as WordPressMigrationState;
}

<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                WordPress Migration Ver - 2.0
            </h2>

            <p class="text-muted mb-0">
                Import published WordPress articles into BolNews CMS.
            </p>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ERROR -->
    <!-- ========================================================= -->
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- ========================================================= -->
    <!-- MIGRATION SETTINGS -->
    <!-- ========================================================= -->

    <div class="card mb-4 shadow-sm">

        <div class="card-header">
            <strong>
                Migration Settings
            </strong>
        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="WordPressMigration"
                  asp-action="Import"
                  method="post"
                  id="importForm">

                @Html.AntiForgeryToken()

                <div class="row">

                    <!-- FROM DATE -->

                    <div class="col-md-4">

                        <label class="form-label">
                            From Date
                        </label>

                        <input type="date"
                               id="migrationFromDate"
                               name="fromDate"
                               class="form-control"
                               required />

                    </div>


                    <!-- TO DATE -->

                    <div class="col-md-4">

                        <label class="form-label">
                            To Date
                        </label>

                        <input type="date"
                               id="migrationToDate"
                               name="toDate"
                               class="form-control"
                               required />

                        <small class="text-muted">
                            The end date is exclusive.
                        </small>

                    </div>


                    <!-- NUMBER OF ARTICLES -->

                    <div class="col-md-4">

                        <label class="form-label">
                            Number of Articles
                        </label>

                        <input type="number"
                               name="take"
                               class="form-control"
                               min="1"
                               placeholder="Leave empty for all" />

                        <small class="text-muted">
                            Use 1 for the first test.
                        </small>

                    </div>

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary"
                            id="startImportButton">

                        <i class="bi bi-arrow-down-circle"></i>

                        Start Import

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MIGRATION PROCESSING STATUS -->
    <!-- ========================================================= -->

    <div class="card mb-4 shadow-sm">

        <div class="card-header">

            <strong>
                Migration Processing Status
            </strong>

        </div>

        <div class="card-body">

            <div class="row text-center">

                <!-- STATUS -->

                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Status
                        </div>

                        <strong id="migrationStatus">

                            @(migrationState?.Status ?? "Idle")

                        </strong>

                    </div>

                </div>


                <!-- OPERATION -->

                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Operation
                        </div>

                        <strong id="migrationOperation">

                            @(migrationState?.Operation ?? "-")

                        </strong>

                    </div>

                </div>
                <!-- Import -->
                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Imported
                        </div>

                        <strong id="migrationImported">
                            @(migrationState?.Imported ?? 0)
                        </strong>

                    </div>

                </div>

                <!-- START TIME -->

                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Start Time
                        </div>

                        <strong id="migrationStartTime">

                            @(migrationState?.StartTime?
                                                        .ToString(
                                                        "dd-MMM-yyyy hh:mm:ss tt")
                                                        ?? "-")

                        </strong>

                    </div>

                </div>


                <!-- FINISH TIME -->

                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Finish Time
                        </div>

                        <strong id="migrationFinishTime">

                            @(migrationState?.FinishTime?
                                                        .ToString(
                                                        "dd-MMM-yyyy hh:mm:ss tt")
                                                        ?? "-")

                        </strong>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COUNTERS -->
            <!-- ================================================= -->

            <div class="row mt-3 text-center">

                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Candidates
                        </div>

                        <strong id="migrationTotal">
                            @(migrationState?.Total ?? 0)
                        </strong>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Repaired
                        </div>

                        <strong id="migrationRepaired">
                            @(migrationState?.Repaired ?? 0)
                        </strong>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Skipped
                        </div>

                        <strong id="migrationSkipped">
                            @(migrationState?.Skipped ?? 0)
                        </strong>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="rounded border p-3">

                        <div class="text-muted small">
                            Failed
                        </div>

                        <strong id="migrationFailed">
                            @(migrationState?.Failed ?? 0)
                        </strong>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- RUNNING / ABORT -->
            <!-- ================================================= -->

            <div id="migrationRunningPanel"
                 class="alert alert-warning mt-3"
                 style="display:@(
                                      migrationState?.IsRunning == true
                                          ? "block"
                                          : "none");">

                <div>

                    <i class="bi bi-hourglass-split"></i>

                    <strong id="migrationRunningText">

                        @(migrationState?.Operation
                                                ?? "Processing...")

                    </strong>

                    is currently running.

                </div>


                <div class="mt-3">

                    <form asp-area="Admin"
                          asp-controller="WordPressMigration"
                          asp-action="Abort"
                          method="post"
                          id="abortForm"
                          onsubmit="return confirm(
                              'Are you sure you want to abort the current operation?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger"
                                id="abortButton">

                            <i class="bi bi-stop-circle"></i>

                            Abort Processing

                        </button>

                    </form>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COMPLETED -->
            <!-- ================================================= -->

            <div id="migrationCompletedPanel"
                 class="alert alert-success mt-3"
                 style="display:@(
                                      migrationState?.Status == "Completed"
                                          ? "block"
                                          : "none");">

                <i class="bi bi-check-circle"></i>

                Processing completed successfully.

            </div>


            <!-- ================================================= -->
            <!-- ABORTED -->
            <!-- ================================================= -->

            <div id="migrationAbortedPanel"
                 class="alert alert-warning mt-3"
                 style="display:@(
                                      migrationState?.Status == "Aborted"
                                          ? "block"
                                          : "none");">

                <i class="bi bi-stop-circle"></i>

                Processing was aborted.

            </div>


            <!-- ================================================= -->
            <!-- FAILED -->
            <!-- ================================================= -->

            <div id="migrationFailedPanel"
                 class="alert alert-danger mt-3"
                 style="display:@(
                                      migrationState?.Status == "Failed"
                                          ? "block"
                                          : "none");">

                <i class="bi bi-exclamation-triangle"></i>

                Processing failed.

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- IMPORT RESULT -->
    <!-- ========================================================= -->
    @if (result != null)
    {
        <div class="card shadow-sm">

            <div class="card-header">

                <strong>
                    Migration Result
                </strong>

            </div>

            <div class="card-body">

                <div class="row text-center">

                    <!-- TOTAL -->

                    <div class="col-md-3">

                        <div class="rounded border p-3">

                            <h3>
                                @result.Total
                            </h3>

                            <div class="text-muted">
                                Total
                            </div>

                        </div>

                    </div>


                    <!-- IMPORTED -->

                    <div class="col-md-3">

                        <div class="rounded border p-3">

                            <h3>
                                @result.Imported
                            </h3>

                            <div class="text-success">
                                Imported
                            </div>

                        </div>

                    </div>


                    <!-- SKIPPED -->

                    <div class="col-md-3">

                        <div class="rounded border p-3">

                            <h3>
                                @result.Skipped
                            </h3>

                            <div class="text-warning">
                                Skipped
                            </div>

                        </div>

                    </div>


                    <!-- FAILED -->

                    <div class="col-md-3">

                        <div class="rounded border p-3">

                            <h3>
                                @result.Failed
                            </h3>

                            <div class="text-danger">
                                Failed
                            </div>

                        </div>

                    </div>

                </div>


                @if (result.Errors.Any())
                {
                    <div class="alert alert-danger mt-4">

                        <h5>
                            Import Errors
                        </h5>

                        <ul class="mb-0">

                            @foreach (var item in result.Errors)
                            {
                                <li>
                                    @item
                                </li>
                            }

                        </ul>

                    </div>
                }

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- MIGRATION REPAIR -->
    <!-- ========================================================= -->

    <div class="card mt-4 shadow-sm">

        <div class="card-header">

            <strong>
                Migration Repair
            </strong>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- ================================================= -->
                <!-- FEATURED IMAGES -->
                <!-- ================================================= -->

                <div class="col-md-3">

                    <form asp-area="Admin"
                          asp-controller="WordPressMigration"
                          asp-action="RepairFeaturedImages"
                          method="post"
                          class="repair-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="fromDate" />

                        <input type="hidden"
                               name="toDate" />

                        <button type="submit"
                                class="btn btn-outline-primary w-100">

                            <i class="bi bi-image"></i>

                            Repair Featured Images

                        </button>

                    </form>

                </div>


                <!-- ================================================= -->
                <!-- CONTENT -->
                <!-- ================================================= -->

                <div class="col-md-3">

                    <form asp-area="Admin"
                          asp-controller="WordPressMigration"
                          asp-action="NormalizeContent"
                          method="post"
                          class="repair-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="fromDate" />

                        <input type="hidden"
                               name="toDate" />

                        <button type="submit"
                                class="btn btn-outline-warning w-100">

                            <i class="bi bi-text-paragraph"></i>

                            Normalize Content

                        </button>

                    </form>

                </div>


                <!-- ================================================= -->
                <!-- INLINE MEDIA -->
                <!-- ================================================= -->

                <div class="col-md-3">

                    <form asp-area="Admin"
                          asp-controller="WordPressMigration"
                          asp-action="ProcessInlineMedia"
                          method="post"
                          class="repair-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="fromDate" />

                        <input type="hidden"
                               name="toDate" />

                        <button type="submit"
                                class="btn btn-outline-success w-100">

                            <i class="bi bi-play-btn"></i>

                            Process Inline Media

                        </button>

                    </form>

                </div>

                <!-- ================================================= -->
                <!-- INLine MP4 Videos -->
                <!-- ================================================= -->
                <div class="col-md-3">
                    <form asp-area="Admin"
                          asp-controller="WordPressMigration"
                          asp-action="ProcessWordPressVideos"
                          method="post"
                          class="repair-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="fromDate" />

                        <input type="hidden"
                               name="toDate" />

                        <button type="submit"
                                class="btn btn-outline-danger w-100">

                            <i class="bi bi-camera-video"></i>

                            Process WordPress Videos

                        </button>

                    </form>
                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- REPAIR RESULT -->
    <!-- ========================================================= -->
    @if (ViewBag.RepairResult is WordPressRepairResultDto repairResult)
    {
        <div class="card mt-4 shadow-sm">

            <div class="card-header">

                <strong>
                    Migration Repair Result
                </strong>

            </div>

            <div class="card-body">

                <div class="row text-center">

                    <div class="col-md-3">

                        <div class="rounded border p-3">

                            <h3>
                                @repairResult.Total
                            </h3>

                            <div class="text-muted">
                                Candidates
                            </div>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="rounded border p-3">

                            <h3>
                                @repairResult.Repaired
                            </h3>

                            <div class="text-success">
                                Repaired
                            </div>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="rounded border p-3">

                            <h3>
                                @repairResult.Skipped
                            </h3>

                            <div class="text-warning">
                                Skipped
                            </div>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="rounded border p-3">

                            <h3>
                                @repairResult.Failed
                            </h3>

                            <div class="text-danger">
                                Failed
                            </div>

                        </div>

                    </div>

                </div>


                @if (repairResult.Errors.Any())
                {
                    <div class="alert alert-danger mt-4">

                        <h5>
                            Errors
                        </h5>

                        <ul class="mb-0">

                            @foreach (var item in repairResult.Errors)
                            {
                                <li>
                                    @item
                                </li>
                            }

                        </ul>

                    </div>
                }

            </div>

        </div>
    }

</div>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->
@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // =====================================================
                // DATE SYNCHRONIZATION
                // =====================================================

                const repairForms =
                    document.querySelectorAll(
                        ".repair-form"
                    );


                repairForms.forEach(
                    function (form) {

                        form.addEventListener(
                            "submit",
                            function () {

                                const fromDate =
                                    document.querySelector(
                                        "#migrationFromDate"
                                    )?.value;


                                const toDate =
                                    document.querySelector(
                                        "#migrationToDate"
                                    )?.value;


                                const fromInput =
                                    form.querySelector(
                                        '[name="fromDate"]'
                                    );


                                const toInput =
                                    form.querySelector(
                                        '[name="toDate"]'
                                    );


                                if (fromInput) {

                                    fromInput.value =
                                        fromDate || "";

                                }


                                if (toInput) {

                                    toInput.value =
                                        toDate || "";

                                }

                            }
                        );

                    }
                );


                // =====================================================
                // STATUS POLLING
                // =====================================================

                let migrationPolling = null;


                function formatDate(value) {

                    if (!value)
                        return "-";


                    const date =
                        new Date(value);


                    if (isNaN(date.getTime()))
                        return "-";


                    return date.toLocaleString();

                }


                function updateMigrationStatus() {

                    fetch(
                        '@Url.Action(
                                                    "Status",
                                                    "WordPressMigration",
                                                    new { area = "Admin" }
                                            )'
                )
                .then(
                    function (response) {

                            if (!response.ok) {

                                throw new Error(
                                    "Unable to retrieve migration status."
                                );

                            }

                            return response.json();

                        }
                    )
                    .then(
                        function (data) {

                            // Status

                            const status =
                                document.getElementById(
                                    "migrationStatus"
                                );

                            if (status) {

                                status.textContent =
                                    data.status || "Idle";

                            }


                            // Operation

                            const operation =
                                document.getElementById(
                                    "migrationOperation"
                                );

                            if (operation) {

                                operation.textContent =
                                    data.operation || "-";

                            }

                            //Imported
                             const imported =
                                    document.getElementById(
                                        "migrationImported");

                                if (imported) {
                                    imported.textContent =
                                        data.imported ?? 0;
        }
                            // Start

                            const startTime =
                                document.getElementById(
                                    "migrationStartTime"
                                );

                            if (startTime) {

                                startTime.textContent =
                                    formatDate(
                                        data.startTime
                                    );

                            }


                            // Finish

                            const finishTime =
                                document.getElementById(
                                    "migrationFinishTime"
                                );

                            if (finishTime) {

                                finishTime.textContent =
                                    formatDate(
                                        data.finishTime
                                    );

                            }


                            // Total

                            const total =
                                document.getElementById(
                                    "migrationTotal"
                                );

                            if (total) {

                                total.textContent =
                                    data.total ?? 0;

                            }


                            // Repaired

                            const repaired =
                                document.getElementById(
                                    "migrationRepaired"
                                );

                            if (repaired) {

                                repaired.textContent =
                                    data.repaired ?? 0;

                            }


                            // Skipped

                            const skipped =
                                document.getElementById(
                                    "migrationSkipped"
                                );

                            if (skipped) {

                                skipped.textContent =
                                    data.skipped ?? 0;

                            }


                            // Failed

                            const failed =
                                document.getElementById(
                                    "migrationFailed"
                                );

                            if (failed) {

                                failed.textContent =
                                    data.failed ?? 0;

                            }


                            // Running panel

                            const runningPanel =
                                document.getElementById(
                                    "migrationRunningPanel"
                                );


                            const runningText =
                                document.getElementById(
                                    "migrationRunningText"
                                );


                            if (data.isRunning) {

                                if (runningPanel) {

                                    runningPanel.style.display =
                                        "block";

                                }


                                if (runningText) {

                                    runningText.textContent =
                                        `${data.operation || "Migration"} is currently running...`;

                                }

                            }
                            else {

                                if (runningPanel) {

                                    runningPanel.style.display =
                                        "none";

                                }

                            }


                            // Completed

                            const completedPanel =
                                document.getElementById(
                                    "migrationCompletedPanel"
                                );


                            if (completedPanel) {

                                completedPanel.style.display =
                                    data.status === "Completed"
                                        ? "block"
                                        : "none";

                            }


                            // Aborted

                            const abortedPanel =
                                document.getElementById(
                                    "migrationAbortedPanel"
                                );


                            if (abortedPanel) {

                                abortedPanel.style.display =
                                    data.status === "Aborted"
                                        ? "block"
                                        : "none";

                            }


                            // Failed

                            const failedPanel =
                                document.getElementById(
                                    "migrationFailedPanel"
                                );


                            if (failedPanel) {

                                failedPanel.style.display =
                                    data.status === "Failed"
                                        ? "block"
                                        : "none";

                            }


                            // Stop polling when finished

                            if (!data.isRunning &&
                                migrationPolling !== null) {

                                clearInterval(
                                    migrationPolling
                                );

                                migrationPolling = null;

                            }

                        }
                    )
                    .catch(
                        function (error) {

                            console.error(
                                "Migration status error:",
                                error
                            );

                        }
                    );

                }


                // Initial status check

                updateMigrationStatus();


                // Poll every 2 seconds

                migrationPolling =
                    setInterval(
                        updateMigrationStatus,
                        2000
                    );

            }

        );

    </script>
}