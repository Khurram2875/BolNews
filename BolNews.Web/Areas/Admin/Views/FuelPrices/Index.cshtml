@model BolNews.Web.ViewModels.FuelPriceSettingsVM

@{
    ViewData["Title"] = "Fuel Prices";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Fuel Prices</h1>
            <p class="text-muted mb-0">
                Update the prices displayed on the website.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="Index" method="post">

        @Html.AntiForgeryToken()

        <div class="card shadow-sm">
            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label asp-for="EffectiveDate"
                               class="form-label">
                        </label>

                        <input asp-for="EffectiveDate"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="EffectiveDate"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <hr />

                <div class="row">

                    <div class="col-md-6">

                        <h5 class="text-danger mb-3">
                            Petrol
                        </h5>

                        <div class="mb-3">
                            <label asp-for="PetrolPrice"
                                   class="form-label">
                            </label>

                            <div class="input-group">
                                <input asp-for="PetrolPrice"
                                       class="form-control"
                                       step="0.01" />

                                <span class="input-group-text">
                                    PKR / litre
                                </span>
                            </div>

                            <span asp-validation-for="PetrolPrice"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PetrolChange"
                                   class="form-label">
                            </label>

                            <div class="input-group">
                                <input asp-for="PetrolChange"
                                       class="form-control"
                                       step="0.01" />

                                <span class="input-group-text">
                                    PKR
                                </span>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-6">

                        <h5 class="text-danger mb-3">
                            Diesel
                        </h5>

                        <div class="mb-3">
                            <label asp-for="DieselPrice"
                                   class="form-label">
                            </label>

                            <div class="input-group">
                                <input asp-for="DieselPrice"
                                       class="form-control"
                                       step="0.01" />

                                <span class="input-group-text">
                                    PKR / litre
                                </span>
                            </div>

                            <span asp-validation-for="DieselPrice"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DieselChange"
                                   class="form-label">
                            </label>

                            <div class="input-group">
                                <input asp-for="DieselChange"
                                       class="form-control"
                                       step="0.01" />

                                <span class="input-group-text">
                                    PKR
                                </span>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="mt-3">
                    <button type="submit"
                            class="btn btn-danger">
                        Update Fuel Prices
                    </button>
                </div>

            </div>
        </div>

    </form>

</div>