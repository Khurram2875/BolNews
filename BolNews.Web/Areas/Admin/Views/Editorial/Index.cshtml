@using BolNews.Domain.Enums
@using BolNews.Web.Areas.Admin.ViewModels
@using BolNews.Domain.Entities
@using BolNews.Domain.Common

@model EditorialDashboardVM
@functions
{
    private string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed.TotalMinutes < 60)
            return $"{(int)elapsed.TotalMinutes}m";

        if (elapsed.TotalHours < 24)
            return $"{(int)elapsed.TotalHours}h {elapsed.Minutes}m";

        return $"{(int)elapsed.TotalDays}d {elapsed.Hours}h";
    }
}
@{
    ViewData["Title"] = "Editorial Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var editorialUsers = ViewBag.EditorialUsers as List<ApplicationUser> ?? new();
    var currentFilter = ViewBag.CurrentFilter?.ToString()?.ToLower() ?? "all";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var canManageWorkflow = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Editor) || User.IsInRole(Roles.SubEditor);
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Editorial Dashboard</h2>
            <p class="text-muted mb-0">
                Newsroom workflow operations center
            </p>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="mb-4">
        <div class="btn-group">

            <a asp-action="Index"
               asp-route-filter="all"
               class="btn @(currentFilter == "all"
                                  ? "btn-primary"
                                  : "btn-outline-primary")">
                All Work
            </a>

            <a asp-action="Index"
               asp-route-filter="mine"
               class="btn @(currentFilter == "mine"
                                  ? "btn-primary"
                                  : "btn-outline-primary")">
                My Assigned Work
            </a>

            <a asp-action="Index"
               asp-route-filter="unassigned"
               class="btn @(currentFilter == "unassigned"
                                  ? "btn-primary"
                                  : "btn-outline-primary")">
                Unassigned
            </a>

        </div>
    </div>

    @if (User.IsInRole("Factchecker"))
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-warning">
                <h5 class="mb-0">
                    My Assigned Fact Checks
                </h5>
            </div>

            <div class="card-body">

                @if (Model.MyFactChecks.Any())
                {
                    <table class="table-hover table">

                        <thead>
                            <tr>
                                <th>Article</th>
                                <th>Author</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.MyFactChecks)
                            {
                                <tr>
                                    <td>@item.Title</td>

                                    <td>@item.AuthorName</td>

                                    <td>

                                        <a asp-area="Admin"
                                           asp-controller="Articles"
                                           asp-action="Discussion"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary">
                                            Discussion
                                        </a>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <p>No articles assigned for fact checking.</p>
                }

            </div>
        </div>
    }

    <div class="row mb-4">

        <div class="col-md-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">SLA Compliance</h6>
                    <h3>@Model.Analytics.SlaCompliancePercent.ToString("0")%</h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Overdue</h6>
                    <h3 class="text-danger">
                        @Model.Analytics.TotalOverdueItems
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Avg Review</h6>
                    <h3>
                        @Model.Analytics.AverageReviewHours.ToString("0.0")h
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Avg Fact Check</h6>
                    <h3>
                        @Model.Analytics.AverageFactCheckHours.ToString("0.0")h
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Publish Delay</h6>
                    <h3>
                        @Model.Analytics.AverageApprovalToPublishHours.ToString("0.0")h
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Bottleneck</h6>
                    <h6>
                        @Model.Analytics.BottleneckQueue
                    </h6>
                </div>
            </div>
        </div>

    </div>
    <!-- KPI CARDS -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Submitted</h6>
                    <h2>@Model.Submitted.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Under Review</h6>
                    <h2>@Model.UnderReview.Count</h2>
                </div>
            </div>
        </div>
       
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Fact Check</h6>
                    <h2>@Model.FactCheckPending.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Approved</h6>
                    <h2>@Model.Approved.Count</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- SUBMITTED -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            Submitted Queue (@Model.Submitted.Count)
        </div>

        <div class="card-body">
            @if (Model.Submitted.Any())
            {
                <table class="table-hover table-sm table align-middle" style="font-size:smaller">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Reviewer</th>
                            <th>Fact Checker</th>
                            <th>Category</th>
                            <th>Score</th>
                            <th>Created</th>
                            <th>SLA</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Submitted)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.AuthorName</td>

                                <td>
                                    @if (canManageWorkflow)
                                    {
                                        <form asp-action="AssignReviewer" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="articleId" value="@item.Id" />

                                            <select name="reviewerUserId"
                                                    class="form-select form-select-sm"
                                                    onchange="this.form.submit()">
                                                <option value="">Assign Reviewer</option>

                                                @foreach (var user in editorialUsers)
                                                {
                                                    if (item.ReviewerUserId == user.Id)
                                                    {
                                                        <option value="@user.Id" selected>@user.FullName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@user.Id">@user.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>@(item.ReviewerName ?? "Unassigned")</span>
                                    }
                                </td>

                                <td>
                                    @if (canManageWorkflow)
                                    {
                                        <form asp-action="AssignFactChecker" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="articleId" value="@item.Id" />

                                            <select name="factCheckerUserId"
                                                    class="form-select form-select-sm"
                                                    onchange="this.form.submit()">
                                                <option value="">Assign Fact Checker</option>

                                                @foreach (var user in editorialUsers)
                                                {
                                                    if (item.FactCheckerUserId == user.Id)
                                                    {
                                                        <option value="@user.Id" selected>@user.FullName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@user.Id">@user.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>@(item.FactCheckerName ?? "Unassigned")</span>
                                    }
                                </td>

                                <td>@item.CategoryName</td>
                                <td><strong>@item.OverallScore</strong></td>
                                <td>@item.CreatedAt.ToString("g")</td>
                                <td>
                                    @if (item.SlaStatus?.IsTracked == true)
                                    {
                                        if (item.SlaStatus.IsOverdue)
                                        {
                                            <span class="badge bg-danger">
                                                OVERDUE | @FormatElapsed(item.SlaStatus.Elapsed)
                                            </span>

                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Healthy | @FormatElapsed(item.SlaStatus.Elapsed)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">

                                        @if (canManageWorkflow)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="Articles"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="badge bg-warning">
                                                Review
                                            </a>
                                        }

                                        @if (canManageWorkflow)
                                        {
                                            <form asp-action="Transition" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="articleId" value="@item.Id" />
                                                <input type="hidden" name="targetStatus" value="Published" />

                                                <button class="badge bg-success">
                                                    Publish
                                                </button>
                                            </form>

                                            <form asp-action="Transition" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="articleId" value="@item.Id" />
                                                <input type="hidden" name="targetStatus" value="UnderReview" />

                                                <button class="badge bg-primary">
                                                    Take Review
                                                </button>
                                            </form>

                                            <button type="button"
                                                    class="badge bg-danger"
                                                    onclick="openRejectModal(@item.Id)">
                                                Reject
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No submitted articles.</p>
            }
        </div>
    </div>

    <!-- UNDER REVIEW -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            Under Review (@Model.UnderReview.Count)
        </div>

        <div class="card-body">
            @if (Model.UnderReview.Any())
            {
                <table class="table-hover table-sm table align-middle" style="font-size:smaller">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Reviewer</th>
                            <th>Fact Checker</th>
                            <th>Category</th>
                            <th>Score</th>
                            <th>Created</th>
                            <th>SLA</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.UnderReview)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.AuthorName</td>

                                <td>
                                    @if (canManageWorkflow)
                                    {
                                        <form asp-action="AssignReviewer" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="articleId" value="@item.Id" />

                                            <select name="reviewerUserId"
                                                    class="form-select form-select-sm"
                                                    onchange="this.form.submit()">
                                                <option value="">Assign Reviewer</option>

                                                @foreach (var user in editorialUsers)
                                                {
                                                    if (item.ReviewerUserId == user.Id)
                                                    {
                                                        <option value="@user.Id" selected>@user.FullName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@user.Id">@user.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>@(item.ReviewerName ?? "Unassigned")</span>
                                    }
                                </td>

                                <td>
                                    @if (canManageWorkflow)
                                    {
                                        <form asp-action="AssignFactChecker" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="articleId" value="@item.Id" />

                                            <select name="factCheckerUserId"
                                                    class="form-select form-select-sm"
                                                    onchange="this.form.submit()">
                                                <option value="">Assign Fact Checker</option>

                                                @foreach (var user in editorialUsers)
                                                {
                                                    if (item.FactCheckerUserId == user.Id)
                                                    {
                                                        <option value="@user.Id" selected>@user.FullName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@user.Id">@user.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>@(item.FactCheckerName ?? "Unassigned")</span>
                                    }
                                </td>
                                
                                <td>@item.CategoryName</td>
                                <td><strong>@item.OverallScore</strong></td>
                                <td>@item.CreatedAt.ToString("g")</td>
                                <td>
                                    @if (item.SlaStatus?.IsTracked == true)
                                    {
                                        if (item.SlaStatus.IsOverdue)
                                        {
                                            <span class="badge bg-danger">
                                                OVERDUE | @FormatElapsed(item.SlaStatus.Elapsed)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Healthy | @FormatElapsed(item.SlaStatus.Elapsed)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">

                                        @if (canManageWorkflow)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="Articles"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="badge bg-warning">
                                                Review
                                            </a>
                                        }

                                        @if (canManageWorkflow)
                                        {
                                            <form asp-action="Transition" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="articleId" value="@item.Id" />
                                                <input type="hidden" name="targetStatus" value="Published" />

                                                <button class="badge bg-success">
                                                    Publish
                                                </button>
                                            </form>

                                            <form asp-action="Transition" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="articleId" value="@item.Id" />
                                                <input type="hidden" name="targetStatus" value="Approved" />

                                                <button class="badge bg-success">
                                                    Approve
                                                </button>
                                            </form>

                                            <form asp-action="Transition" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="articleId" value="@item.Id" />
                                                <input type="hidden" name="targetStatus" value="FactCheckPending" />

                                                <button class="badge bg-info">
                                                    Fact Check
                                                </button>
                                            </form>

                                            <button type="button"
                                                    class="badge bg-danger"
                                                    onclick="openRejectModal(@item.Id)">
                                                Reject
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No articles under review.</p>
            }
        </div>
    </div>

    <!-- FACT CHECK -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-warning text-dark">
            Fact Check Pending (@Model.FactCheckPending.Count)
        </div>

        <div class="card-body">
            @if (Model.FactCheckPending.Any())
            {
                <table class="table-hover table-sm table align-middle" style="font-size:smaller">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Reviewer</th>
                            <th>Fact Checker</th>
                            <th>Category</th>
                            <th>Score</th>
                            <th>Created</th>
                            <th>SLA</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.FactCheckPending)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.AuthorName</td>

                                <td>
                                    @if (canManageWorkflow)
                                    {
                                        <form asp-action="AssignReviewer" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="articleId" value="@item.Id" />

                                            <select name="reviewerUserId"
                                                    class="form-select form-select-sm"
                                                    onchange="this.form.submit()">
                                                <option value="">Assign Reviewer</option>

                                                @foreach (var user in editorialUsers)
                                                {
                                                    if (item.ReviewerUserId == user.Id)
                                                    {
                                                        <option value="@user.Id" selected>@user.FullName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@user.Id">@user.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>@(item.ReviewerName ?? "Unassigned")</span>
                                    }
                                </td>

                                <td>
                                    @if (canManageWorkflow)
                                    {
                                        <form asp-action="AssignFactChecker" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="articleId" value="@item.Id" />

                                            <select name="factCheckerUserId"
                                                    class="form-select form-select-sm"
                                                    onchange="this.form.submit()">
                                                <option value="">Assign Fact Checker</option>

                                                @foreach (var user in editorialUsers)
                                                {
                                                    if (item.FactCheckerUserId == user.Id)
                                                    {
                                                        <option value="@user.Id" selected>@user.FullName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@user.Id">@user.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>@(item.FactCheckerName ?? "Unassigned")</span>
                                    }
                                </td>
                               
                                <td>@item.CategoryName</td>
                                <td><strong>@item.OverallScore</strong></td>
                                <td>@item.CreatedAt.ToString("g")</td>
                                <td>
                                    @if (item.SlaStatus?.IsTracked == true)
                                    {
                                        if (item.SlaStatus.IsOverdue)
                                        {
                                            <span class="badge bg-danger">
                                                OVERDUE | @FormatElapsed(item.SlaStatus.Elapsed)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Healthy | @FormatElapsed(item.SlaStatus.Elapsed)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">

                                        @if (canManageWorkflow)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="Articles"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="badge bg-warning">
                                                Review
                                            </a>
                                        }

                                        @if (canManageWorkflow || item.FactCheckerUserId == currentUserId)
                                        {
                                            <form asp-action="Transition" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="articleId" value="@item.Id" />
                                                <input type="hidden" name="targetStatus" value="Approved" />

                                                <button class="badge bg-success">
                                                    Approve
                                                </button>
                                            </form>

                                            <button type="button"
                                                    class="badge bg-danger"
                                                    onclick="openRejectModal(@item.Id)">
                                                Reject
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No articles awaiting fact check.</p>
            }
        </div>
    </div>

    <!-- APPROVED -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-success text-white">
            Approved For Publishing (@Model.Approved.Count)
        </div>

        <div class="card-body">
            @if (Model.Approved.Any())
            {
                <table class="table-hover table-sm table align-middle" style="font-size:smaller">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Reviewer</th>
                            <th>Fact Checker</th>
                            <th>Category</th>
                            <th>Score</th>
                            <th>Created</th>
                            <th>Sla</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Approved)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.AuthorName</td>

                                <td>@(item.ReviewerName ?? "Unassigned")</td>
                                <td>@(item.FactCheckerName ?? "Unassigned")</td>

                                <td>@item.CategoryName</td>
                                <td><strong>@item.OverallScore</strong></td>
                                <td>@item.CreatedAt.ToString("g")</td>
                                <td>
                                    @if (item.SlaStatus?.IsTracked == true)
                                    {
                                        if (item.SlaStatus.IsOverdue)
                                        {
                                            <span class="badge bg-danger">
                                                OVERDUE | @FormatElapsed(item.SlaStatus.Elapsed)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Healthy |   @FormatElapsed(item.SlaStatus.Elapsed)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td style="min-width: 340px;">
                                    <div class="d-flex flex-column gap-2">

                                        <!-- TOP ACTION -->
                                        @if (canManageWorkflow)
                                        {
                                            <div>
                                                <a asp-area="Admin"
                                                   asp-controller="Articles"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-warning btn-sm w-100">
                                                    <i class="bi bi-pencil-square me-1"></i> Review Article
                                                </a>
                                            </div>
                                        }

                                        @if (canManageWorkflow &&
                                                                        item.WorkflowStatus == ArticleWorkflowStatus.Approved &&
                                                                        !item.ScheduledPublishAt.HasValue &&
                                                                        !item.EmbargoUntil.HasValue)
                                        {
                                            <div class="bg-light rounded border p-3">

                                                <div class="fw-semibold text-success mb-2">
                                                    Publishing Controls
                                                </div>

                                                <form asp-action="Transition" method="post">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="articleId" value="@item.Id" />
                                                    <input type="hidden" name="targetStatus" value="Published" />

                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold">
                                                            Schedule Publish
                                                        </label>

                                                        <input type="datetime-local"
                                                               name="scheduledPublishAt"
                                                               class="form-control form-control-sm" />
                                                    </div>

                                                    <div class="text-muted small my-1 text-center">
                                                        OR
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">
                                                            Embargo Until
                                                        </label>

                                                        <input type="datetime-local"
                                                               name="embargoUntil"
                                                               class="form-control form-control-sm" />
                                                    </div>

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm w-100">
                                                        <i class="bi bi-send-check me-1"></i> Publish
                                                    </button>

                                                    <div class="form-text small mt-2 text-center">
                                                        Leave both empty for immediate publishing
                                                    </div>
                                                </form>
                                            </div>
                                        }
                                        else if (canManageWorkflow && item.ScheduledPublishAt.HasValue)
                                        {
                                            <div class="bg-info rounded border bg-opacity-10 p-3">

                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="fw-semibold text-info">
                                                        Scheduled Publication
                                                    </span>
                                                    <span class="badge bg-info">
                                                        Scheduled
                                                    </span>
                                                </div>

                                                <div class="small mb-3">
                                                    @item.ScheduledPublishAt.Value.ToLocalTime().ToString("f")
                                                </div>

                                                <form asp-action="Transition" method="post" class="mb-2">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="articleId" value="@item.Id" />
                                                    <input type="hidden" name="targetStatus" value="Published" />

                                                    <input type="datetime-local"
                                                           name="scheduledPublishAt"
                                                           class="form-control form-control-sm mb-2" />

                                                    <button type="submit"
                                                            class="btn btn-primary btn-sm w-100">
                                                        Reschedule
                                                    </button>
                                                </form>

                                                <div class="d-grid gap-2">
                                                    <form asp-action="CancelSchedule" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="articleId" value="@item.Id" />

                                                        <button type="submit"
                                                                class="btn btn-outline-danger btn-sm w-100">
                                                            Cancel Schedule
                                                        </button>
                                                    </form>

                                                    <form asp-action="Transition" method="post">
                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden" name="articleId" value="@item.Id" />
                                                        <input type="hidden" name="targetStatus" value="Published" />

                                                        <button type="submit"
                                                                class="btn btn-success btn-sm w-100">
                                                            Publish Now
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else if (canManageWorkflow && item.EmbargoUntil.HasValue)
                                        {
                                            <div class="bg-warning rounded border bg-opacity-10 p-3">

                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="fw-semibold text-warning">
                                                        Embargo Active
                                                    </span>
                                                    <span class="badge bg-warning text-dark">
                                                        Restricted
                                                    </span>
                                                </div>

                                                <div class="small mb-3">
                                                    @item.EmbargoUntil.Value.ToLocalTime().ToString("f")
                                                </div>

                                                <form asp-action="Transition" method="post" class="mb-2">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="articleId" value="@item.Id" />
                                                    <input type="hidden" name="targetStatus" value="Published" />

                                                    <input type="datetime-local"
                                                           name="embargoUntil"
                                                           class="form-control form-control-sm mb-2" />

                                                    <button type="submit"
                                                            class="btn btn-primary btn-sm w-100">
                                                        Reschedule Embargo
                                                    </button>
                                                </form>

                                                <div class="d-grid gap-2">
                                                    <form asp-action="CancelSchedule" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="articleId" value="@item.Id" />

                                                        <button type="submit"
                                                                class="btn btn-outline-danger btn-sm w-100">
                                                            Cancel Embargo
                                                        </button>
                                                    </form>

                                                    <form asp-action="Transition" method="post">
                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden" name="articleId" value="@item.Id" />
                                                        <input type="hidden" name="targetStatus" value="Published" />

                                                        <button type="submit"
                                                                class="btn btn-success btn-sm w-100">
                                                            Publish Now
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No approved articles ready to publish.</p>
            }
        </div>
    </div>

</div>

<!-- REJECT MODAL -->
<div class="modal fade"
     id="rejectModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="Transition" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Reject Article</h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="rejectArticleId"
                           name="articleId" />

                    <input type="hidden"
                           name="targetStatus"
                           value="Rejected" />

                    <div class="mb-3">
                        <label class="form-label">
                            Rejection Reason
                        </label>

                        <textarea name="reason"
                                  class="form-control"
                                  rows="5"
                                  required
                                  placeholder="Enter editorial rejection reason..."></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Confirm Reject
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts
{
    <script>
        function openRejectModal(articleId) {
            document.getElementById('rejectArticleId').value = articleId;

            var modal =
                new bootstrap.Modal(
                    document.getElementById('rejectModal'));

            modal.show();
        }

                document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll("input[name='scheduledPublishAt']")
                .forEach(schedule => {

                    schedule.addEventListener("change", function () {

                        const embargo =
                            this.closest("form")
                                .querySelector("input[name='embargoUntil']");

                        embargo.disabled = !!this.value;
                    });
                });

            document.querySelectorAll("input[name='embargoUntil']")
                .forEach(embargo => {

                    embargo.addEventListener("change", function () {

                        const schedule =
                            this.closest("form")
                                .querySelector("input[name='scheduledPublishAt']");

                        schedule.disabled = !!this.value;
                    });
                });
        });
    </script>
}
