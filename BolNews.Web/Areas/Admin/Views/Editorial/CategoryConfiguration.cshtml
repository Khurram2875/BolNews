@using BolNews.Domain.Common
@using BolNews.Application.DTOs
@using BolNews.Application.DTOs.Editorial

@{
    ViewData["Title"] = "Homepage Category Configuration";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var categories =
        ViewBag.Categories as IEnumerable<CategoryDto>
        ?? Enumerable.Empty<CategoryDto>();

    var configurations =
        ViewBag.CategoryConfigurations
        as Dictionary<string, List<EditorialCategoryConfigurationDto>>
        ?? new Dictionary<string, List<EditorialCategoryConfigurationDto>>();

    List<int> GetSelectedIds(string placementType)
    {
        if (!configurations.TryGetValue(
                placementType,
                out var items))
        {
            return new List<int>();
        }

        return items
            .OrderBy(x => x.SortOrder)
            .Select(x => x.CategoryId)
            .ToList();
    }
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                Homepage Category Configuration
            </h1>

            <p class="text-muted mb-0">
                Select which categories should be used for organic
                Top Story, Secondary Story and Featured Story selection.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Editorial"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Editorial Control
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="alert alert-info">
        <strong>How this works:</strong>
        Select one or more categories for each placement.
        Articles from the selected categories will be considered
        for the corresponding homepage section.
        Pinned editorial stories remain unaffected.
    </div>

    <div class="row g-4">

        <!-- Top Story -->
        <div class="col-12">
            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">
                        Top Story Categories
                    </h5>
                </div>

                <div class="card-body">

                    <form asp-area="Admin"
                          asp-controller="Editorial"
                          asp-action="SaveCategoryConfiguration"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="placementType"
                               value="@EditorialPlacementKeys.HomepageTopStory" />

                        <label class="form-label">
                            Categories
                        </label>

                        <select class="form-select"
                                name="categoryIds"
                                multiple
                                size="8">

                            @foreach (var category in categories)
                            {
                                var selected =
                                GetSelectedIds(
                                EditorialPlacementKeys.HomepageTopStory)
                                .Contains(category.Id);

                                <option value="@category.Id"
                                        selected="@selected">
                                    @category.Name
                                </option>
                            }

                        </select>

                        <div class="form-text">
                            Hold Ctrl (Windows) or Command (Mac)
                            to select multiple categories.
                        </div>

                        <div class="mt-3">
                            <button type="submit"
                                    class="btn btn-primary">
                                Save Top Story Categories
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>


        <!-- Secondary Stories -->
        <div class="col-12">
            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">
                        Secondary Story Categories
                    </h5>
                </div>

                <div class="card-body">

                    <form asp-area="Admin"
                          asp-controller="Editorial"
                          asp-action="SaveCategoryConfiguration"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="placementType"
                               value="@EditorialPlacementKeys.HomepageSecondaryStory" />

                        <label class="form-label">
                            Categories
                        </label>

                        <select class="form-select"
                                name="categoryIds"
                                multiple
                                size="8">

                            @foreach (var category in categories)
                            {
                                var selected =
                                GetSelectedIds(
                                EditorialPlacementKeys.HomepageSecondaryStory)
                                .Contains(category.Id);

                                <option value="@category.Id"
                                        selected="@selected">
                                    @category.Name
                                </option>
                            }

                        </select>

                        <div class="form-text">
                            Hold Ctrl (Windows) or Command (Mac)
                            to select multiple categories.
                        </div>

                        <div class="mt-3">
                            <button type="submit"
                                    class="btn btn-primary">
                                Save Secondary Story Categories
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>


        <!-- Featured Stories -->
        <div class="col-12">
            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">
                        Featured Story Categories
                    </h5>
                </div>

                <div class="card-body">

                    <form asp-area="Admin"
                          asp-controller="Editorial"
                          asp-action="SaveCategoryConfiguration"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="placementType"
                               value="@EditorialPlacementKeys.HomepageFeaturedStory" />

                        <label class="form-label">
                            Categories
                        </label>

                        <select class="form-select"
                                name="categoryIds"
                                multiple
                                size="8">

                            @foreach (var category in categories)
                            {
                                var selected =
                                GetSelectedIds(
                                EditorialPlacementKeys.HomepageFeaturedStory)
                                .Contains(category.Id);

                                <option value="@category.Id"
                                        selected="@selected">
                                    @category.Name
                                </option>
                            }

                        </select>

                        <div class="form-text">
                            Hold Ctrl (Windows) or Command (Mac)
                            to select multiple categories.
                        </div>

                        <div class="mt-3">
                            <button type="submit"
                                    class="btn btn-primary">
                                Save Featured Story Categories
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>

    </div>
</div>