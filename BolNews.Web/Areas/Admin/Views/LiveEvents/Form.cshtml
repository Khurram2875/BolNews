@model BolNews.Web.Areas.Admin.ViewModels.LiveEventVM
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var editing = Model.Id != 0; ViewData["Title"] = editing ? "Edit Live Event" : "Create Live Event"; }
<div class="container-fluid py-3">
    <h1>@ViewData["Title"]</h1>
    <p class="text-muted">Choose an existing Media Library image or upload a new one here. Uploaded images are saved to the Media Library.</p>
    <form asp-action="@(editing ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden" />
        <div class="row g-3"><div class="col-md-6"><label asp-for="Title" class="form-label">Live Event Title</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Slug" class="form-label">Live Event Slug</label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="FeaturedMediaId" class="form-label">Select from Media Library</label><select asp-for="FeaturedMediaId" asp-items="Model.Images" class="form-select"><option value="0">Choose an existing image</option></select><span asp-validation-for="FeaturedMediaId" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="FeaturedImageUpload" class="form-label">Or upload a featured image</label><input asp-for="FeaturedImageUpload" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-control" /><span asp-validation-for="FeaturedImageUpload" class="text-danger"></span><small class="form-text">JPG, PNG, or WEBP; maximum 2 MB.</small></div>
        <div class="col-md-4 form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active (show publicly)</label></div><div class="col-md-3 form-check"><input asp-for="IsPinned" class="form-check-input" /><label asp-for="IsPinned" class="form-check-label">Pin to front</label></div><div class="col-md-4 form-check"><input asp-for="ShowLiveBadge" class="form-check-input" /><label asp-for="ShowLiveBadge" class="form-check-label">Show LIVE badge</label></div>
        <div class="col-12"><label class="form-label" for="article-search">Linked published articles <span class="text-muted">(optional, select multiple)</span></label><input id="article-search" type="search" class="form-control" placeholder="Search published articles by title or summary…" autocomplete="off" /><div id="article-search-results" class="list-group mt-2" role="listbox"></div><div id="selected-articles" class="d-flex mt-3 flex-wrap gap-2">
            @foreach (var article in Model.SelectedArticles)
            {
                <span class="badge text-bg-light d-inline-flex align-items-center gap-2 border p-2" data-selected-article="@article.Id"><span>@article.Category · @article.Title</span><button type="button" class="btn-close" aria-label="Remove @article.Title"></button><input type="hidden" name="ArticleIds" value="@article.Id" /></span>
            }
        </div><span asp-validation-for="ArticleIds" class="text-danger"></span></div></div>
        <hr /><div class="d-flex justify-content-between align-items-center"><h2 class="h4">Event updates</h2><button type="button" class="btn btn-sm btn-outline-primary" id="addUpdate">Add update</button></div>
        <div id="updates">
        @for (var i = 0; i < Model.Updates.Count; i++)
        {
            <div class="card update-row my-3"><div class="card-body"><input asp-for="Updates[i].Id" type="hidden" /><div class="row g-3"><div class="col-md-4"><label class="form-label">Timestamp</label><input asp-for="Updates[i].Timestamp" type="datetime-local" class="form-control" /></div><div class="col-md-8"><label class="form-label">Summary</label><input asp-for="Updates[i].Summary" class="form-control" /><span asp-validation-for="Updates[i].Summary" class="text-danger"></span></div><div class="col-12"><label class="form-label">Details</label><textarea asp-for="Updates[i].Details" class="form-control" rows="4"></textarea></div><div class="col-md-8"><label class="form-label">Source</label><input asp-for="Updates[i].Source" class="form-control" /></div><div class="col-md-4 d-flex align-items-end"><button type="button" class="btn btn-outline-danger remove-update">Remove update</button></div></div></div></div>
        }
        </div>
        <button class="btn btn-primary" type="submit">Save Live Event</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(() => {
 const search = document.getElementById('article-search');
 const results = document.getElementById('article-search-results');
 const selected = document.getElementById('selected-articles');
 const searchUrl = '@Url.Action("SearchPublishedArticles", "LiveEvents", new { area = "Admin" })';
 let timer;
 const selectedIds = () => new Set([...selected.querySelectorAll('[data-selected-article]')].map(x => Number(x.dataset.selectedArticle)));
 const addArticle = article => {
   if (selectedIds().has(article.id)) return;
   const chip = document.createElement('span'); chip.className = 'badge text-bg-light border p-2 d-inline-flex align-items-center gap-2'; chip.dataset.selectedArticle = article.id;
   const label = document.createElement('span'); label.textContent = `${article.category} · ${article.title}`;
   const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'btn-close'; remove.setAttribute('aria-label', `Remove ${article.title}`);
   const input = document.createElement('input'); input.type = 'hidden'; input.name = 'ArticleIds'; input.value = article.id;
   chip.append(label, remove, input); selected.appendChild(chip);
 };
 const runSearch = async () => {
   const term = search.value.trim(); results.replaceChildren();
   if (term.length < 2) return;
   const response = await fetch(`${searchUrl}?term=${encodeURIComponent(term)}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
   if (!response.ok) return;
   const articles = await response.json(); const alreadySelected = selectedIds();
   for (const article of articles) {
     if (alreadySelected.has(article.id)) continue;
     const option = document.createElement('button'); option.type = 'button'; option.className = 'list-group-item list-group-item-action';
     option.textContent = `${article.category} · ${article.title}`; option.addEventListener('click', () => { addArticle(article); option.remove(); }); results.appendChild(option);
   }
   if (!results.children.length) { const empty = document.createElement('div'); empty.className = 'list-group-item text-muted'; empty.textContent = 'No matching published articles found.'; results.appendChild(empty); }
 };
 search.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(runSearch, 250); });
 selected.addEventListener('click', event => { if (event.target.closest('.btn-close')) event.target.closest('[data-selected-article]').remove(); });
 const host = document.getElementById('updates');
 const reindex = () => host.querySelectorAll('.update-row').forEach((row, i) => row.querySelectorAll('[name]').forEach(el => { el.name = el.name.replace(/Updates\[\d+\]/, `Updates[${i}]`); if (el.id) el.id = el.id.replace(/Updates_\d+__/, `Updates_${i}__`); }));
 document.getElementById('addUpdate').addEventListener('click', () => { const row = host.querySelector('.update-row').cloneNode(true); row.querySelectorAll('input,textarea').forEach(el => { if (el.type === 'hidden') el.value = '0'; else if (el.type === 'datetime-local') el.value = new Date().toISOString().slice(0,16); else el.value = ''; }); host.appendChild(row); reindex(); });
 host.addEventListener('click', e => { if (e.target.closest('.remove-update')) { const rows = host.querySelectorAll('.update-row'); if (rows.length > 1) e.target.closest('.update-row').remove(); reindex(); } });
})();
</script>
}
