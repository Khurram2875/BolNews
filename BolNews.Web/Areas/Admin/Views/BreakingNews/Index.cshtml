@model BolNews.Web.Areas.Admin.ViewModels.BreakingNews.BreakingNewsListVM


@{
    ViewData["Title"] = "Breaking News";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>
            Breaking News Management
        </h2>

        <a asp-action="Create" class="btn btn-danger">

            <i class="fa fa-plus"></i>

            New Breaking News

        </a>

    </div>

    <div class="card">

        <div class="card-body">

            <table id="breakingNewsTable"
                   class="table-striped table-bordered table">

                <thead>

                    <tr>

                        <th>Pin</th>

                        <th>Style</th>

                        <th>Status</th>

                        <th>Order</th>

                        <th>Breaking News</th>

                        <th>Article</th>

                        <th>Updated</th>

                        <th width="220">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.BreakingNews)
                    {
                        <tr>

                            <td>

                                @(item.IsPinned ? "📌" : "")

                            </td>

                            <td>

                                @item.TickerStyle

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        Inactive

                                    </span>
                                }

                        </td>

                        <td>

                            @item.DisplayOrder

                        </td>

                        <td>

                            @item.Text

                        </td>

                        <td>

                            @item.ArticleTitle

                        </td>

                        <td>

                            @(item.UpdatedAt?.ToString("dd MMM yyyy HH:mm")
                                                        ?? item.CreatedAt.ToString("dd MMM yyyy HH:mm"))

                        </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">

                                    Edit

                                </a>

                                <button class="btn btn-sm btn-warning activateBtn"
                                        data-id="@item.Id">

                                    @(item.IsActive ? "Deactivate" : "Activate")

                                </button>

                                <button class="btn btn-sm btn-danger deleteBtn"
                                        data-id="@item.Id">

                                    Delete

                                </button>

                            </td>

                        </tr>
                                        }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/AdminArea/breaking-news.js"></script>

}