@model BolNews.Web.Areas.Admin.ViewModels.BreakingNews.BreakingNewsListVM


@{
    ViewData["Title"] = "Breaking News";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>
            Breaking News Management
        </h2>

        <a asp-action="Create" class="btn btn-danger">

            <i class="fa fa-plus"></i>

            New Breaking News

        </a>

    </div>

    @{ var tickerLevel = ViewData["TickerSpeedLevel"] as int? ?? 2; }
    @if (TempData["Success"] is string tickerMessage)
    {
        <div class="alert alert-success py-2">@tickerMessage</div>
    }
    <div class="card mb-3">
        <div class="card-body">
            <form asp-action="UpdateTickerSpeed" method="post" class="row g-3 align-items-center">
                <div class="col-lg-3">
                    <h5 class="mb-0">Headline ticker speed</h5>
                    <small class="text-muted">The scrolling "Headlines" bar above the navbar on public pages.</small>
                </div>
                <div class="col-lg-6 d-flex align-items-center gap-2">
                    <span class="small text-muted">Slow</span>
                    <input type="range" class="form-range" name="level" id="tickerSpeed" min="1" max="10" step="1" value="@tickerLevel" />
                    <span class="small text-muted">Fast</span>
                    <span class="badge text-bg-secondary" id="tickerSpeedLabel">@tickerLevel</span>
                </div>
                <div class="col-lg-3 text-lg-end">
                    <button type="submit" class="btn btn-primary">Save speed</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        (function () {
            var r = document.getElementById('tickerSpeed'), l = document.getElementById('tickerSpeedLabel');
            if (r && l) r.addEventListener('input', function () { l.textContent = r.value; });
        })();
    </script>

    <div class="card">

        <div class="card-body">

            <table id="breakingNewsTable"
                   class="table-striped table-bordered table">

                <thead>

                    <tr>

                        <th>Pin</th>

                        <th>Style</th>

                        <th>Status</th>

                        <th>Order</th>

                        <th>Breaking News</th>

                        <th>Article</th>

                        <th>Updated</th>

                        <th width="220">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.BreakingNews)
                    {
                        <tr>

                            <td>

                                @(item.IsPinned ? "📌" : "")

                            </td>

                            <td>

                                @item.TickerStyle

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        Inactive

                                    </span>
                                }

                        </td>

                        <td>

                            @item.DisplayOrder

                        </td>

                        <td>

                            @item.Text

                        </td>

                        <td>

                            @item.ArticleTitle

                        </td>

                        <td>

                            @(item.UpdatedAt?.ToString("dd MMM yyyy HH:mm")
                                                        ?? item.CreatedAt.ToString("dd MMM yyyy HH:mm"))

                        </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">

                                    Edit

                                </a>

                                <button class="btn btn-sm btn-warning activateBtn"
                                        data-id="@item.Id">

                                    @(item.IsActive ? "Deactivate" : "Activate")

                                </button>

                                <button class="btn btn-sm btn-danger deleteBtn"
                                        data-id="@item.Id">

                                    Delete

                                </button>

                            </td>

                        </tr>
                                        }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/AdminArea/breaking-news.js"></script>

}