@using BolNews.Web.Areas.Admin.ViewModels.BreakingNews
@model EditBreakingNewsVM

@{
    ViewData["Title"] = "Edit Breaking News";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <h2>Edit Breaking News</h2>

    <hr />

    <form asp-action="Edit"
          method="post">

        <input asp-for="Id" type="hidden" />

        <partial name="_Form"
                 model="Model" />
        <select id="ArticleId"
                name="ArticleId"
                class="form-select">

            @if (Model.ArticleId.HasValue)
            {
                <option value="@Model.ArticleId" selected>
                    @Model.ArticleTitle
                </option>
            }

        </select>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/AdminArea/breaking-news.js"></script>

}