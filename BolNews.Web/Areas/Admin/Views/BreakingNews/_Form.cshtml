@using BolNews.Domain.Enums
@using BolNews.Web.Areas.Admin.ViewModels.BreakingNews
@model BreakingNewsFormVM

<div class="card shadow-sm">

    <div class="card-body">

        <div class="row">

            <div class="col-md-12 mb-3">

                <label asp-for="Text" class="form-label"></label>

                <textarea asp-for="Text"
                          class="form-control"
                          rows="3"
                          maxlength="500"></textarea>

                <span asp-validation-for="Text"
                      class="text-danger"></span>

            </div>

            <div class="col-md-12 mb-3">

                <label class="form-label">
                    Linked Article (Optional)
                </label>

                <select id="ArticleId"
                        name="ArticleId"
                        class="form-select">
                </select>

                <small class="text-muted">
                    Search published articles.
                </small>

            </div>

            <div class="col-md-4 mb-3">

                <label asp-for="TickerStyle"
                       class="form-label"></label>

                <select asp-for="TickerStyle"
                        asp-items="Html.GetEnumSelectList<TickerStyle>()"
                        class="form-select">
                </select>

            </div>

            <div class="col-md-4 mb-3">

                <label asp-for="DisplayOrder"
                       class="form-label"></label>

                <input asp-for="DisplayOrder"
                       class="form-control" />

            </div>

            <div class="col-md-4">

                <div class="form-check mt-4">

                    <input asp-for="IsPinned"
                           class="form-check-input" />

                    <label asp-for="IsPinned"
                           class="form-check-label"></label>

                </div>

                <div class="form-check mt-2">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label"></label>

                </div>

            </div>

            <div class="col-md-6">

                <label asp-for="StartDate"
                       class="form-label"></label>

                <input asp-for="StartDate"
                       type="datetime-local"
                       class="form-control" />

            </div>

            <div class="col-md-6">

                <label asp-for="EndDate"
                       class="form-label"></label>

                <input asp-for="EndDate"
                       type="datetime-local"
                       class="form-control" />

            </div>

        </div>

    </div>

    <div class="card-footer text-end">

        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

        <button type="submit"
                class="btn btn-danger">

            <i class="fa fa-save"></i>

            Save

        </button>

    </div>

</div>