@using BolNews.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token"
          content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <title>@ViewData["Title"] - Admin Panel</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
          rel="stylesheet" />

    <!-- Quill -->
    <link href="~/lib/quill/quill.snow.css" rel="stylesheet" />

    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
   
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 d-none d-md-block sidebar admin-sidebar-bg">
                <div class="position-sticky d-flex flex-column h-100 pt-3">
                    <div class="sidebar-brand mb-4 px-3">
                        <h4 class="fw-bold text-danger">BOL<span class="text-white">NEWS</span></h4>
                        <small class="text-uppercase fw-bold text-white" style="font-size: 0.65rem;">Editorial Control</small>

                        

                          

                        @{
                            var user = await UserManager.GetUserAsync(User);
                        }

                        <div class="d-flex align-items-center gap-2">
                            <span class="text-white" style="font-size: smaller;">
                                Hello, @user?.FullName
                            </span>

                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger bi bi-box-arrow-left" title="Logout"></button>
                            </form>
                        </div>

                       
                    </div>
                    <hr class="text-secondary" />
                    <ul class="nav flex-column mb-auto">
                        <li>

                           
                        </li>
                        @await Component.InvokeAsync("NotificationBell")

                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Editorial" asp-action="Index">
                                <i class="bi bi-speedometer me-2"></i> Editorial Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-globe2 me-2"></i> News Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">
                                <i class="bi bi-people me-2"></i> User Mgmt.
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Articles" asp-action="Index">
                                <i class="bi bi-journal-text me-2"></i> Articles
                            </a>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="MediaLibrary" asp-action="Index"><i class="bi bi-collection me-2"></i> Media Library</a></li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="Admin"
                               asp-controller="BreakingNews"
                               asp-action="Index">

                                <i class="bi bi-megaphone me-2"></i>

                                Breaking News

                            </a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="EditorialPlacements" asp-action="Index">
                                    <i class="bi bi-pin-angle me-2"></i> Homepage Placement
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Reporters" asp-action="Index">
                                    <i class="bi bi-person-lines-fill me-2"></i> Reporters / Sources
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-tags me-2"></i> Categories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Author" asp-action="Index">
                                <i class="bi bi-person-badge me-2"></i> Authors
                            </a>
                        </li>
                       
                    </ul>

                    
                </div>
            </nav>
         

            <!-- Main content -->
            <main class="col-md-10 ms-sm-auto px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>
   
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
	@* <script src="~/js/adminarea/localckeditor.js"></script> *@
   @*  <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script> *@
	<script src="~/js/adminarea/adminareajs.js"></script>
    <script src="~/js/lazyload.js"></script>
	<script src="~/lib/quill/quill.js"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- Responsive -->
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <!-- Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- Quill -->
    <script src="~/lib/quill/quill.js"></script>

    <!-- Lazy Load -->
    <script src="~/js/lazyload.js"></script>

    <!-- Admin JS (ONLY ONCE) -->
    <script src="~/js/adminarea/adminareajs.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
   
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const notificationCountEl = document.getElementById("bn-notification-count");
            const notificationListEl = document.getElementById("bn-notification-list");

            function escapeHtml(value) {
                return (value || "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll("\"", "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function getAntiForgeryToken() {
                const tokenEl = document.querySelector("input[name='__RequestVerificationToken']");
                return tokenEl ? tokenEl.value : "";
            }

            function renderNotifications(feed) {
                if (!notificationCountEl || !notificationListEl) return;

                const unreadCount = feed?.unreadCount ?? 0;
                const items = feed?.items ?? [];

                notificationCountEl.textContent = unreadCount.toString();
                notificationCountEl.classList.toggle("d-none", unreadCount === 0);

                if (items.length === 0) {
                    notificationListEl.innerHTML = `
                        <li>
                            <span class="dropdown-item-text text-muted">
                                No unread notifications
                            </span>
                        </li>`;
                    return;
                }

                const token = getAntiForgeryToken();
                notificationListEl.innerHTML = items.map((item) => {
                    const trimmedMessage = (item.message || "").length > 120
                        ? `${item.message.substring(0, 120)}...`
                        : (item.message || "");

                    return `
                        <li>
                            <form action="/Admin/Notifications/Open" method="post">
                                <input name="__RequestVerificationToken" type="hidden" value="${escapeHtml(token)}" />
                                <input type="hidden" name="id" value="${item.id}" />
                                <input type="hidden" name="url" value="${escapeHtml(item.url || "")}" />
                                <button type="submit" class="dropdown-item text-wrap" style="white-space: normal;">
                                    <div class="fw-semibold">${escapeHtml(item.title)}</div>
                                    <div class="small text-muted mt-1">${escapeHtml(trimmedMessage)}</div>
                                    <div class="small text-secondary mt-1">${escapeHtml(item.createdAt)}</div>
                                </button>
                            </form>
                        </li>
                        <li><hr class="dropdown-divider" /></li>`;
                }).join("");
            }

            function showNotificationToast(item) {
                if (!item) return;

                let toastHost = document.getElementById("bn-notification-toast-host");
                if (!toastHost) {
                    toastHost = document.createElement("div");
                    toastHost.id = "bn-notification-toast-host";
                    toastHost.className = "toast-container position-fixed bottom-0 end-0 p-3";
                    document.body.appendChild(toastHost);
                }

                const toastId = `bn-toast-${Date.now()}`;
                const toastMarkup = `
                    <div id="${toastId}" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="toast-header">
                            <strong class="me-auto">${escapeHtml(item.title || "Notification")}</strong>
                            <small>just now</small>
                            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                        <div class="toast-body">
                            ${escapeHtml(item.message || "")}
                        </div>
                    </div>`;

                toastHost.insertAdjacentHTML("beforeend", toastMarkup);
                const toastEl = document.getElementById(toastId);
                const toast = new bootstrap.Toast(toastEl, { delay: 5000 });

                if (item.url) {
                    toastEl.style.cursor = "pointer";
                    toastEl.addEventListener("click", function () {
                        if (item.url.startsWith("/")) {
                            window.location.href = item.url;
                        }
                    });
                }

                toastEl.addEventListener("hidden.bs.toast", function () {
                    toastEl.remove();
                });

                toast.show();
            }

            async function refreshNotificationFeed(showToast = false) {
                try {
                    const response = await fetch("/Admin/Notifications/Feed", {
                        method: "GET",
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    if (!response.ok) return;

                    const feed = await response.json();
                    const newestItem = Array.isArray(feed?.items) && feed.items.length > 0
                        ? feed.items[0]
                        : null;

                    renderNotifications(feed);

                    if (showToast && newestItem) {
                        showNotificationToast(newestItem);
                    }
                } catch (err) {
                    console.error("Notification feed refresh failed", err);
                }
            }

            if (typeof signalR === "undefined") {
                console.error("SignalR failed to load.");
                return;
            }
                window.notificationConnection =
                    new signalR.HubConnectionBuilder()
                        .withUrl("/notificationHub")
                        .withAutomaticReconnect()
                        .build();
            

            window.notificationConnection.on("NotificationReceived", function () {
                refreshNotificationFeed(true);
            });

                window.notificationConnectionReady = window.notificationConnection.start()
        .then(() => console.log("Notification hub connected"))
        .catch(err => {
            console.error(err);
            throw err;
        });

            refreshNotificationFeed(false);
        });
    </script>
</body>
</html>
<style>
    /* Sidebar Container Styling */
    .admin-sidebar-bg {
        background-color: #1a1a27; /* Deep Navy Dark */
        min-height: 100vh;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
    }

    /* Sidebar Links */
    .sidebar .nav-link {
        color: #9899ac !important;
        font-weight: 500;
        padding: 12px 20px;
        margin: 4px 12px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        transition: all 0.2s ease;
    }

        /* Hover Effect */
        .sidebar .nav-link:hover {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.05);
        }

        /* Active Page Styling */
        .sidebar .nav-link.active {
            color: #ffffff !important;
            background-color: #2b2b40 !important;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

            .sidebar .nav-link.active i {
                color: #0d6efd; /* Blue icon for active state */
            }

        /* Sidebar Icons */
        .sidebar .nav-link i {
            font-size: 1.1rem;
            line-height: 0;
        }

    /* Brand Section */
    .sidebar-brand h4 {
        letter-spacing: 1px;
        margin-bottom: 0;
    }

    /* Logout Styling */
    .hover-bg-danger:hover {
        background-color: rgba(220, 53, 69, 0.1) !important;
        color: #ea868f !important;
    }

    /* Main Content Adjustment */
    main {
        background-color: #f5f7f9; /* Light grey background for the dashboard area */
        min-height: 100vh;
    }
</style>
