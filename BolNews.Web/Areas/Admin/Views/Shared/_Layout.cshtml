<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="~/css/site.css" rel="stylesheet" />
	
    <!-- Optional: Custom admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
   
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 d-none d-md-block bg-dark-red sidebar">
                <div class="position-sticky pt-3">
                    <h4 class="text-light ps-3">Admin Panel</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Articles" asp-action="Index">
                                Articles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                Categories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Author" asp-action="Index">
                                Authors
                            </a>
                        </li>
                        <!-- Add more links for Users, Categories, etc. -->
                    </ul>
                </div>
                <div>
                    <h4 style="color:white">🔥 Trending Topics</h4>
                    <div style="color:white" id="trendingTopics"></div>
                </div>
            </nav>
         

            <!-- Main content -->
            <main class="col-md-10 ms-sm-auto px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>
   
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
	<script src="~/js/adminarea/adminareajs.js"></script>
    <script src="~/js/lazyload.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
<script>
        async function loadTrending() {
        const res = await fetch('/admin/articles/trendingtopics');
        const data = await res.json();

        let html = "<ul>";
        data.forEach(t => {
            html += `<li>${t.topic} (${t.score.toFixed(0)})</li>`;
        });
        html += "</ul>";

        document.getElementById("trendingTopics").innerHTML = html;
    }

    loadTrending();
</script>