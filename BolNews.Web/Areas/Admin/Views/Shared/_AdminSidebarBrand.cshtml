@using BolNews.Domain.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isChangePassword = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "ChangePassword", StringComparison.OrdinalIgnoreCase);
}
<div class="sidebar-brand mb-4 px-3">
    <h4 class="fw-bold text-danger">BOL<span class="text-white">NEWS</span></h4>
    <small class="text-uppercase fw-bold text-white" style="font-size: 0.65rem;">Editorial Control</small>

    <div class="d-flex align-items-center mt-2 gap-2">
        <span class="text-white" style="font-size: smaller;">
            Hello, @user?.FullName
        </span>

        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger bi bi-box-arrow-left" title="Logout"></button>
        </form>
    </div>

    <a class="nav-link px-0 mt-2 @(isChangePassword ? "active" : "")"
       asp-area=""
       asp-controller="Account"
       asp-action="ChangePassword">
        <i class="bi bi-key me-2"></i> Change password
    </a>
</div>
<hr class="text-secondary" />
