                                    <input type="hidden" name="direction" value="-1" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" @(i == 0 ? "disabled" : "") title="Move up">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                </form>
                                <form asp-action="MoveLatestStory" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="placementId" value="@placement.PlacementId" />
