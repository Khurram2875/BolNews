                            <td>@placement.CategoryName</td>
                            <td>@placement.PublishedAt?.ToString("g")</td>
                            <td class="text-center">
                                <form asp-action="MoveLatestStory" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
